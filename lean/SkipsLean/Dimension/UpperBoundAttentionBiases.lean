import SkipsLean.Symmetry.AttentionHeadsBiases
import SkipsLean.Dimension.UpperBoundAttention
import SkipsLean.Dimension.UpperBoundTransformer
import SkipsLean.OneBlock.MlpBiases

/-!
# The count of Lemma A.8 for attention blocks with biases, at generic parameters

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`,
against `(L + 1)(d_model² + d_model) + s` without skips, and the skips remove `L d_model²`
dimensions, as without biases."

Here the two bounds of `Symmetry/AttentionHeadsBiases.lean` for networks of attention blocks with
biases at any depth, at almost every pair of weights and biases, for every Haar measure on the
pairs: for `d_in ≥ d`, heads of width `d_h ≤ d` and a mask in which every token sees at least one
token, `fd ≤ P − d² − (L + 1) d − 2 ∑ H d_h² − 2 ∑ H d_h` with identity skips; and, if moreover
`H d_h ≥ d` in every block, `fd ≤ P − (L + 1)(d² + d) − 2 ∑ H d_h² − 2 ∑ H d_h` without skips.
The paper states the counts as dimensions of the symmetry group; equality of the functional
dimension with these bounds is proved for one block (`OneBlock/AttentionBiasesDim.lean`) and
computed for 24 networks of two blocks (`attention_biases_check_2026-11-25.py`).
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {sees : T → T → Prop} [DecidableRel sees]
variable {H dh : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]

/-- **Lemma A.8, the count with identity skips, for attention blocks with biases at generic
weights and biases:** for `d_in ≥ d`, heads of width `d_h ≤ d` and a mask in which every token
sees at least one token, `fd ≤ P − d² − (L + 1) d − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem ae_funDimB_add_le_residual_attention (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    ∀ᵐ p ∂μ, funDimB (Arch.attention sees id H dh) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  classical
  -- the pointwise bound holds wherever `E` has rank `d` and the query and the value matrix of
  -- every head have rank `d_h`: conditions on the weights that hold at generic weights
  filter_upwards [ae_paramsB_of_forall_ae
      (P := fun θ : Params (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut =>
        θ.E.rank = Fintype.card d)
      (fun ν _ => ae_rank_E_ubt ν hdIn) μ,
    ae_paramsB_of_forall_ae
      (P := fun θ : Params (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut =>
        (∀ ℓ (i : H ℓ), ((θ.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
          = Fintype.card (dh ℓ)) ∧
        ∀ ℓ (i : H ℓ), ((θ.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
          = Fintype.card (dh ℓ))
      (fun ν _ => ae_rank_QV_uba ν hdh) μ] with p h1 h2
  exact funDimB_add_le_residual_attention hsee p h1 h2.1 h2.2

/-- **Lemma A.8, the count without skips, for attention blocks with biases at generic weights
and biases:** for `d_in ≥ d`, heads of width `d_h ≤ d` with `H d_h ≥ d` in every block and a mask
in which every token sees at least one token,
`fd ≤ P − (L + 1)(d² + d) − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem ae_funDimB_add_le_skipless_attention (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d)
    (hH : ∀ ℓ, Fintype.card d ≤ Fintype.card (H ℓ) * Fintype.card (dh ℓ)) :
    ∀ᵐ p ∂μ, funDimB (Arch.attention sees id H dh) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  classical
  -- the writes have `H_ℓ d_{h,ℓ} ≥ d` rows
  have hw : ∀ ℓ, Fintype.card d
      ≤ Fintype.card ((Arch.attention (T := T) (d := d) sees id H dh).w ℓ) := fun ℓ => by
    show Fintype.card d ≤ Fintype.card (H ℓ × dh ℓ)
    rw [Fintype.card_prod]
    exact hH ℓ
  -- the pointwise bound holds wherever `E` and the writes have rank `d` and the query and the
  -- value matrix of every head have rank `d_h`
  filter_upwards [ae_paramsB_of_forall_ae
      (P := fun θ : Params (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut =>
        θ.E.rank = Fintype.card d ∧ ∀ ℓ, (θ.write ℓ).rank = Fintype.card d)
      (fun ν _ => ae_rank_E_write ν hdIn hw) μ,
    ae_paramsB_of_forall_ae
      (P := fun θ : Params (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut =>
        (∀ ℓ (i : H ℓ), ((θ.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
          = Fintype.card (dh ℓ)) ∧
        ∀ ℓ (i : H ℓ), ((θ.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
          = Fintype.card (dh ℓ))
      (fun ν _ => ae_rank_QV_uba ν hdh) μ] with p h1 h2
  exact funDimB_add_le_skipless_attention hsee p h1.1 h1.2 h2.1 h2.2

end Skips
