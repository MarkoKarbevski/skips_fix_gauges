import SkipsLean.Symmetry.BiasesSymmetries
import SkipsLean.Dimension.FunctionalBiases
import SkipsLean.Dimension.UpperBound
import SkipsLean.Dimension.ParameterCount

/-!
# The symmetries of a network with biases: flat directions and their count

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and the
skips remove `L d_model²` dimensions, as without biases." Its proof: "These `L + 1` translations
move the biases in independent directions, as many as in a skipless network, where each hidden
state has its own translation (Proposition A.1 (ii)). A skip ties only the linear part of
`Aff(d_model)`, which gives the counts."

Here, for the networks with biases of `Network/Biases.lean`, without normalization, the count for
the changes of basis and the translations (the symmetries inside blocks, the `s` of the lemma,
are not treated here):

* `finrank_paramsB`: `P` with biases is the number of weights plus `d + ∑_ℓ r_ℓ + L d + d_out`.
* `cobDirB`: the direction of the changes of basis at `(θ, b)`: `cobDir θ X` on the weights, and
  `b_E X_0`, `b_write^ℓ X_ℓ` on the embedding bias and the write biases.
* `translateDir`, `translateAtDir`: the directions of the translations of Lemma A.8 (residual
  network: `g_k` is carried from `h_k` on) and of a skipless network (`g_k` at `h_k` only).
* They are flat (`cobDirB_mem_flatB_skipless`, `cobDirB_const_mem_flatB_residual`,
  `translateDir_mem_flatB`, `translateAtDir_mem_flatB`), from the invariances of
  `Symmetry/BiasesSymmetries.lean`.
* They are independent: `(X, g) ↦` direction is injective when `E` has rank `d` (residual
  network: one matrix `X` and `L + 1` rows `g_k`, dimension `d² + (L + 1) d`), respectively when
  `E` and every write have rank `d` (skipless network: `L + 1` matrices and `L + 1` rows,
  dimension `(L + 1)(d² + d)`).
* So the functional dimension with biases is at most `P − d² − (L + 1) d` with skips and at most
  `P − (L + 1)(d² + d)` without, `P` counting the biases (`funDimB_add_le_residual`,
  `funDimB_add_le_skipless`); for one block both are `2 d` lower than the bounds without biases
  (Theorem B.1 (i): "both values are `2 d_model` lower").
-/

namespace Skips

open Matrix
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A : Arch T d L}

/-- **The direction of the changes of basis `X_0, …, X_L` at `(θ, b)`:** `cobDir θ X` on the
weights; the embedding bias moves by `b_E X_0` and the write bias of block `ℓ` by
`b_write^ℓ X_ℓ`; the read biases and the readout bias do not move. -/
def cobDirB (p : ParamsB A dIn dOut) (X : Fin (L + 1) → Matrix d d ℝ) : ParamsB A dIn dOut :=
  (cobDir p.1 X,
    { E := p.2.E ᵥ* X 0
      read := fun _ => 0
      write := fun ℓ => p.2.write ℓ ᵥ* X ℓ.succ
      D := 0 })

/-- **The direction of the translations of Lemma A.8 in a residual network:** the row `g_k` is
added to the hidden states `h_k, …, h_L`. The bias that enters `h_k` moves by `g_k`, the read
bias of block `ℓ` by `−(g_0 + ⋯ + g_{ℓ-1}) W_read^ℓ` (the block reads `h_{ℓ-1}`), and the readout
bias by `−(g_0 + ⋯ + g_L) D`. -/
def translateDir (θ : Params A dIn dOut) (g : Fin (L + 1) → d → ℝ) : Biases A dOut where
  E := g 0
  read ℓ := -((∑ k ∈ Finset.Iic ℓ.castSucc, g k) ᵥ* θ.read ℓ)
  write ℓ := g ℓ.succ
  D := -((∑ k, g k) ᵥ* θ.D)

/-- **The direction of the translations of the hidden states of a skipless network:** the row
`g_k` is added to `h_k` only. The bias that enters `h_k` moves by `g_k`, the read bias of the
block that reads `h_k` by `−g_k W_read`, and the readout bias by `−g_L D`. -/
def translateAtDir (θ : Params A dIn dOut) (g : Fin (L + 1) → d → ℝ) : Biases A dOut where
  E := g 0
  read ℓ := -(g ℓ.castSucc ᵥ* θ.read ℓ)
  write ℓ := g ℓ.succ
  D := -(g (Fin.last L) ᵥ* θ.D)

variable (p : ParamsB A dIn dOut)

/-- The direction of the changes of basis of the hidden states of a skipless network with biases,
without normalization, is flat. -/
theorem cobDirB_mem_flatB_skipless (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (X : Fin (L + 1) → Matrix d d ℝ) :
    cobDirB p X ∈ flatB A 0 p := by
  sorry

/-- The direction of one change of basis of all hidden states of a residual network with biases,
without normalization, is flat. -/
theorem cobDirB_const_mem_flatB_residual (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (X : Matrix d d ℝ) :
    cobDirB p (fun _ => X) ∈ flatB A 1 p := by
  sorry

/-- **Lemma A.8 of the skips paper, in infinitesimal form:** in a residual network with biases
and without normalization, the direction of the translations is flat. -/
theorem translateDir_mem_flatB (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (g : Fin (L + 1) → d → ℝ) :
    ((0, translateDir p.1 g) : ParamsB A dIn dOut) ∈ flatB A 1 p := by
  sorry

/-- In a skipless network with biases and without normalization, the direction of the
translations of the hidden states is flat. -/
theorem translateAtDir_mem_flatB (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (g : Fin (L + 1) → d → ℝ) :
    ((0, translateAtDir p.1 g) : ParamsB A dIn dOut) ∈ flatB A 0 p := by
  sorry

/-- **Proof of Lemma A.8, "These `L + 1` translations move the biases in independent
directions", with the change of basis, for a residual network:** if `E` has rank `d`, the
direction of one change of basis `X` of all hidden states together with the translations
`g_0, …, g_L` determines `X` and the `g_k`. -/
theorem cobDirB_const_add_translateDir_injective (hE : p.1.E.rank = Fintype.card d) :
    Function.Injective (fun Xg : Matrix d d ℝ × (Fin (L + 1) → d → ℝ) =>
      cobDirB p (fun _ => Xg.1) + ((0, translateDir p.1 Xg.2) : ParamsB A dIn dOut)) := by
  sorry

/-- **The same for a skipless network:** if `E` and every write have rank `d`, the direction of
the changes of basis `X_0, …, X_L` together with the translations `g_0, …, g_L` of the hidden
states determines the `X_k` and the `g_k`. -/
theorem cobDirB_add_translateAtDir_injective (hE : p.1.E.rank = Fintype.card d)
    (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d) :
    Function.Injective
      (fun Xg : (Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ) =>
        cobDirB p Xg.1 + ((0, translateAtDir p.1 Xg.2) : ParamsB A dIn dOut)) := by
  sorry

/-- **Lemma A.8 of the skips paper, the count with skips, as a bound:** for a residual network
with biases and differentiable blocks, without normalization, if `E` has rank `d`, the functional
dimension is at most `P − d² − (L + 1) d`, with `P` counting the biases. -/
theorem funDimB_add_le_residual (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (hE : p.1.E.rank = Fintype.card d) :
    funDimB A 1 p + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d)
      ≤ Module.finrank ℝ (ParamsB A dIn dOut) := by
  sorry

/-- **Lemma A.8 of the skips paper, the count without skips, as a bound:** for a skipless network
with biases and differentiable blocks, without normalization, if `E` and every write have rank
`d`, the functional dimension is at most `P − (L + 1)(d² + d)`, with `P` counting the biases. -/
theorem funDimB_add_le_skipless (hA : A.χ = id) (hf : ∀ ℓ, Differentiable ℝ (A.f ℓ))
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d) :
    funDimB A 0 p + (L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
      ≤ Module.finrank ℝ (ParamsB A dIn dOut) := by
  sorry

/-- **The number of parameters of a network with biases:** the number of weights plus
`d + ∑_ℓ r_ℓ + L d + d_out` biases. -/
theorem finrank_paramsB (A : Arch T d L) :
    Module.finrank ℝ (ParamsB A dIn dOut)
      = Module.finrank ℝ (Params A dIn dOut)
        + (Fintype.card d + ∑ ℓ, Fintype.card (A.r ℓ) + L * Fintype.card d
          + Fintype.card dOut) := by
  sorry

end Skips
