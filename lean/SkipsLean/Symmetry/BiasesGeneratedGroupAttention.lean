/-- Helper (the private `evalB_eq_of_blocks_ibb` of `Symmetry/InsideBlocksBiases.lean`): two
parameters with biases with the same embedding, readout, embedding bias and readout bias, and the
same map of every block with its biases, compute the same function. -/
private theorem evalB_eq_of_blocks_bga {A : Arch T d L} (q₁ q₂ : Params A dIn dOut × Biases A dOut)
    (hE : q₂.1.E = q₁.1.E) (hD : q₂.1.D = q₁.1.D) (hbE : q₂.2.E = q₁.2.E)
    (hbD : q₂.2.D = q₁.2.D)
    (hb : ∀ ℓ (n : Matrix T d ℝ),
      A.f ℓ (n * q₂.1.read ℓ + Matrix.of fun _ => q₂.2.read ℓ) * q₂.1.write ℓ
          + Matrix.of (fun _ => q₂.2.write ℓ)
        = A.f ℓ (n * q₁.1.read ℓ + Matrix.of fun _ => q₁.2.read ℓ) * q₁.1.write ℓ
          + Matrix.of fun _ => q₁.2.write ℓ)
    (S : Fin L → Matrix d d ℝ) (x : Matrix T dIn ℝ) :
    evalB A S q₂.1 q₂.2 x = evalB A S q₁.1 q₁.2 x := by
  -- the hidden states agree, by induction along the network
  have hh : ∀ ℓ : Fin (L + 1), hiddenB A S q₂.1 q₂.2 x ℓ = hiddenB A S q₁.1 q₁.2 x ℓ := by
    intro ℓ
    induction ℓ using Fin.induction with
    | zero => rw [hiddenB_zero, hiddenB_zero, hE, hbE]
    | succ ℓ ih => rw [hiddenB_succ, hiddenB_succ, ih, hb]
  -- hence the outputs agree
  rw [evalB, evalB, hh, hD, hbD]

/-- **The changes of basis inside the heads, the shifts of the key biases and the value biases
moved into the output bias are a family of symmetries inside the blocks,** when every token sees
a token. -/
theorem insideBlocksAction_heads (hsee : ∀ t, ∃ s, sees t s) :
    InsideBlocksAction (A := Arch.attention sees χ H dh) (dIn := dIn) (dOut := dOut)
      headsAct (headsSet H dh) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `one`: `σ = (1, 1, 0, 0)`
    refine ⟨(fun _ _ => 1, fun _ _ => 1, fun _ _ => 0, fun _ _ => 0),
      fun _ _ => ⟨by simp, by simp⟩, funext fun q => ?_⟩
    rw [headsAct_apply_bga]
    simp only [glOfMatrix_one_bga]
    exact actGL_one_bga q
  · -- `mul`: `τ = (K' K, N' N, κ' K^{-⊤} + κ, ν' N + ν)`
    intro σ _ σ' _
    refine ⟨(fun ℓ i => ((glOfMatrix (σ'.1 ℓ i) * glOfMatrix (σ.1 ℓ i) : GL (dh ℓ) ℝ)
        : Matrix (dh ℓ) (dh ℓ) ℝ),
      fun ℓ i => ((glOfMatrix (σ'.2.1 ℓ i) * glOfMatrix (σ.2.1 ℓ i) : GL (dh ℓ) ℝ)
        : Matrix (dh ℓ) (dh ℓ) ℝ),
      fun ℓ i k => ∑ k', σ'.2.2.1 ℓ i k'
        * (((glOfMatrix (σ.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k'
        + σ.2.2.1 ℓ i k,
      fun ℓ i k => ∑ k', σ'.2.2.2 ℓ i k'
        * (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k + σ.2.2.2 ℓ i k),
      fun ℓ i => ⟨(Matrix.isUnit_iff_isUnit_det _).1
          (Units.isUnit (glOfMatrix (σ'.1 ℓ i) * glOfMatrix (σ.1 ℓ i))),
        (Matrix.isUnit_iff_isUnit_det _).1
          (Units.isUnit (glOfMatrix (σ'.2.1 ℓ i) * glOfMatrix (σ.2.1 ℓ i)))⟩,
      funext fun q => ?_⟩
    rw [Function.comp_apply, headsAct_apply_bga, headsAct_apply_bga, headsAct_apply_bga,
      actGL_comp_bga]
    simp only [glOfMatrix_coe_bga]
  · -- `inv`: `τ = (K⁻¹, N⁻¹, −κ Kᵀ, −ν N⁻¹)`
    intro σ _
    refine ⟨(fun ℓ i => (((glOfMatrix (σ.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ),
      fun ℓ i => (((glOfMatrix (σ.2.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ),
      fun ℓ i k => -∑ k', σ.2.2.1 ℓ i k' * (glOfMatrix (σ.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k k',
      fun ℓ i k => -∑ k', σ.2.2.2 ℓ i k'
        * (((glOfMatrix (σ.2.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k),
      fun ℓ i => ⟨(Matrix.isUnit_iff_isUnit_det _).1 (Units.isUnit (glOfMatrix (σ.1 ℓ i))⁻¹),
        (Matrix.isUnit_iff_isUnit_det _).1 (Units.isUnit (glOfMatrix (σ.2.1 ℓ i))⁻¹)⟩,
      funext fun q => ?_, funext fun q => ?_⟩
    · rw [Function.comp_apply, headsAct_apply_bga, headsAct_apply_bga, actGL_comp_bga, id]
      simp only [glOfMatrix_coe_bga, inv_mul_cancel, neg_mul, Finset.sum_neg_distrib,
        sum_inv1_bga, sum_inv2_bga, neg_add_cancel]
      exact actGL_one_bga q
    · rw [Function.comp_apply, headsAct_apply_bga, headsAct_apply_bga, actGL_comp_bga, id]
      simp only [glOfMatrix_coe_bga, mul_inv_cancel, inv_inv, add_neg_cancel]
      exact actGL_one_bga q
  · -- `comm_skipless`
    intro p σ _
    funext q
    exact Prod.ext (cob_heads_bga q.1 _ _ p.1) (translateAllAt_heads_bga q.1 q.2 _ _ _ _ p.1 p.2)
  · -- `comm_residual`
    intro p σ _
    funext q
    exact Prod.ext (cob_heads_bga q.1 _ _ p.1) (translateAll_heads_bga q.1 q.2 _ _ _ _ p.1 p.2)
  · -- `evalB_eq`: every block keeps its map
    intro σ _ S q x
    exact evalB_eq_of_blocks_bga q (headsAct σ q) rfl rfl rfl rfl
      (fun ℓ n => block_act_bga hsee _ _ _ _ q ℓ n) S x
  · -- `rank_write`
    intro σ _ q ℓ
    rw [headsAct_apply_bga]
    exact rank_write_bga q.1 (fun ℓ i => glOfMatrix (σ.1 ℓ i))
      (fun ℓ i => glOfMatrix (σ.2.1 ℓ i)) ℓ

/-- **They act freely block by block at weights whose query matrix and value matrix have rank
`d_h` in every head.** -/
theorem insideBlocksFreeAt_heads
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut)
    (hQ : ∀ ℓ (i : H ℓ), ((q.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((q.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    InsideBlocksFreeAt headsAct (headsSet H dh) q := by
  obtain ⟨θ, b⟩ := q
  refine ⟨fun σ _ => rfl, fun σ _ => rfl, ?_, ?_⟩
  · intro σ hσ ℓ hr hb
    -- the read is kept: `W_{V,i} K'_i = W_{V,i}`, so `K'_i = 1`
    have hN : ∀ i, glOfMatrix (σ.2.1 ℓ i) = 1 := by
      intro i
      refine Units.ext (cancel_left_of_rank_bga _ (hV ℓ i) ?_)
      ext a k
      have hk := congrFun (congrFun hr a) (i, Sum.inr (Sum.inr k))
      change ∑ k', θ.read ℓ a (i, Sum.inr (Sum.inr k'))
          * (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
        = θ.read ℓ a (i, Sum.inr (Sum.inr k)) at hk
      rw [Units.val_one, Matrix.mul_one]
      simpa only [Matrix.mul_apply, Matrix.submatrix_apply, id] using hk
    -- the read bias is kept: `b_{V,i} + ν_i = b_{V,i}`, so `ν_i = 0`
    have hν : ∀ i k, σ.2.2.2 ℓ i k = 0 := by
      intro i k
      have hk := congrFun hb (i, Sum.inr (Sum.inr k))
      change (∑ k', b.read ℓ (i, Sum.inr (Sum.inr k'))
          * (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k) + σ.2.2.2 ℓ i k
        = b.read ℓ (i, Sum.inr (Sum.inr k)) at hk
      rw [hN i] at hk
      simpa [Matrix.one_apply] using hk
    -- so the write and the write bias are kept
    refine ⟨?_, ?_⟩
    · ext ⟨i, k⟩ c
      change ∑ k', (((glOfMatrix (σ.2.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k'
          * θ.write ℓ (i, k') c = θ.write ℓ (i, k) c
      simp [hN i, Matrix.one_apply]
    · funext c
      change b.write ℓ c - ∑ i, ∑ k, σ.2.2.2 ℓ i k * _ = b.write ℓ c
      simp [hν]
  · intro σ hσ τ hτ h
    have hr : ∀ ℓ a c, (headsAct σ (θ, b)).1.read ℓ a c = (headsAct τ (θ, b)).1.read ℓ a c :=
      fun ℓ a c => by rw [show headsAct σ (θ, b) = headsAct τ (θ, b) from h]
    have hb : ∀ ℓ c, (headsAct σ (θ, b)).2.read ℓ c = (headsAct τ (θ, b)).2.read ℓ c :=
      fun ℓ c => by rw [show headsAct σ (θ, b) = headsAct τ (θ, b) from h]
    -- the query columns: `W_{Q,i} K_i = W_{Q,i} L_i`, and `W_{Q,i}` has rank `d_h`
    have hK : σ.1 = τ.1 := by
      funext ℓ i
      calc σ.1 ℓ i = (glOfMatrix (σ.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) :=
            (coe_glOfMatrix_bga _ (hσ ℓ i).1).symm
        _ = (glOfMatrix (τ.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) := by
            refine cancel_left_of_rank_bga _ (hQ ℓ i) ?_
            ext a k
            have hk := hr ℓ a (i, Sum.inl k)
            change ∑ k', θ.read ℓ a (i, Sum.inl k')
                * (glOfMatrix (σ.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
              = ∑ k', θ.read ℓ a (i, Sum.inl k')
                * (glOfMatrix (τ.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k at hk
            simpa only [Matrix.mul_apply, Matrix.submatrix_apply, id] using hk
        _ = τ.1 ℓ i := coe_glOfMatrix_bga _ (hτ ℓ i).1
    -- the value columns: `W_{V,i} K'_i = W_{V,i} L'_i`, and `W_{V,i}` has rank `d_h`
    have hN : σ.2.1 = τ.2.1 := by
      funext ℓ i
      calc σ.2.1 ℓ i = (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) :=
            (coe_glOfMatrix_bga _ (hσ ℓ i).2).symm
        _ = (glOfMatrix (τ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) := by
            refine cancel_left_of_rank_bga _ (hV ℓ i) ?_
            ext a k
            have hk := hr ℓ a (i, Sum.inr (Sum.inr k))
            change ∑ k', θ.read ℓ a (i, Sum.inr (Sum.inr k'))
                * (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
              = ∑ k', θ.read ℓ a (i, Sum.inr (Sum.inr k'))
                * (glOfMatrix (τ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k at hk
            simpa only [Matrix.mul_apply, Matrix.submatrix_apply, id] using hk
        _ = τ.2.1 ℓ i := coe_glOfMatrix_bga _ (hτ ℓ i).2
    -- the key biases: `b_{K,i} K_i^{-⊤} + κ_i = b_{K,i} K_i^{-⊤} + κ'_i`
    have hκ : σ.2.2.1 = τ.2.2.1 := by
      funext ℓ i k
      have hk := hb ℓ (i, Sum.inr (Sum.inl k))
      change (∑ k', b.read ℓ (i, Sum.inr (Sum.inl k'))
          * (((glOfMatrix (σ.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k')
          + σ.2.2.1 ℓ i k
        = (∑ k', b.read ℓ (i, Sum.inr (Sum.inl k'))
          * (((glOfMatrix (τ.1 ℓ i))⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k')
          + τ.2.2.1 ℓ i k at hk
      rw [hK] at hk
      exact add_left_cancel hk
    -- the value biases: `b_{V,i} K'_i + ν_i = b_{V,i} K'_i + ν'_i`
    have hν : σ.2.2.2 = τ.2.2.2 := by
      funext ℓ i k
      have hk := hb ℓ (i, Sum.inr (Sum.inr k))
      change (∑ k', b.read ℓ (i, Sum.inr (Sum.inr k'))
          * (glOfMatrix (σ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k) + σ.2.2.2 ℓ i k
        = (∑ k', b.read ℓ (i, Sum.inr (Sum.inr k'))
          * (glOfMatrix (τ.2.1 ℓ i) : Matrix (dh ℓ) (dh ℓ) ℝ) k' k) + τ.2.2.2 ℓ i k at hk
      rw [hN] at hk
      exact add_left_cancel hk
    exact Prod.ext hK (Prod.ext hN (Prod.ext hκ hν))

/-- **Lemma A.8 for attention blocks with biases, with skips:** the pairs `(G, g)` that preserve
the function and the `σ` form a set of dimension
`d² + (L + 1) d + 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem dimH_generated_residual_attention [Nonempty T] [Nonempty dOut] :
    dimH (affMat (affPreservingResidual (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
        ×ˢ headsSet H dh)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)) : ℕ) : ℝ≥0∞) := by
  rw [dimH_affMat_affPreservingResidual_prod _ rfl isOpen_headsSet headsSet_nonempty,
    finrank_headsSpace]

/-- **The same without skips:** dimension
`(L + 1)(d² + d) + 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem dimH_generated_skipless_attention :
    dimH (affMat (affPreservingSkipless (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
        ×ˢ headsSet H dh)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)) : ℕ) : ℝ≥0∞) := by
  rw [dimH_affMat_affPreservingSkipless_prod _ rfl isOpen_headsSet headsSet_nonempty,
    finrank_headsSpace]

end Skips
