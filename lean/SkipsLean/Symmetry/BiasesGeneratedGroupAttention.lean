          + b.read ℓ (i, Sum.inr (Sum.inr a'))) * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) a' k
    simp only [add_mul, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
