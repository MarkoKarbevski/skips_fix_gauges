import SkipsLean.Symmetry.BiasesGeneratedGroup
import SkipsLean.Symmetry.AttentionHeadsBiases

/-!
# The generated group of Lemma A.8 for attention blocks with biases

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips". The symmetries inside an attention block
(Section 4.1: "the changes of basis inside an attention head"; Appendix A.6: "Each attention head
has a change of basis between its queries and keys and one between its values and outputs, of
dimension `d_h²` each"), and with biases (proof of Theorem B.1 (i)): "The key biases drop out,
since they shift all scores of a token equally, and the value biases enter only through `γ`,
since the weights of a token sum to one."

`Symmetry/BiasesGeneratedGroup.lean` has the lemma's sentence for any family of symmetries inside
the blocks given as maps. Here the family of an attention block with biases, indexed by
`σ = (K, K', κ, ν)` with invertible `K_i`, `K'_i` (an open set of a vector space of dimension
`2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`):

* the change of basis `K_i` between the queries and keys of head `i` (`W_Q K`, `W_K K^{-⊤}`, and
  the same on the biases of the queries and keys);
* the change of basis `K'_i` between its values and outputs (`W_V K'`, `K'^{-1} W_O`, `b_V K'`);
* the shift `κ_i` of its key bias;
* its value bias moved into the output bias (`b_V + ν`, `b_write − ∑_i ν_i W_{O,i}`).

It is a family of symmetries inside the blocks when every token sees a token, and it acts freely
block by block at weights whose query and value matrices have rank `d_h` in every head. The
directions of these maps are `headDirB` of `Symmetry/AttentionHeadsBiases.lean`.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {sees : T → T → Prop} [DecidableRel sees] {χ : Matrix T d ℝ → Matrix T d ℝ}
variable {H dh : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]
  [∀ ℓ, DecidableEq (dh ℓ)]

open Classical in
/-- An invertible matrix as an element of the general linear group; the identity for a matrix
that is not invertible. -/
noncomputable def glOfMatrix {n : Type*} [Fintype n] [DecidableEq n] (M : Matrix n n ℝ) :
    GL n ℝ :=
  if h : IsUnit M.det then Matrix.GeneralLinearGroup.mk'' M h else 1

/-- **The biases after the changes of basis `K` between queries and keys:** `b_{Q,i} K_i`,
`b_{K,i} K_i^{-⊤}`; the other biases do not move. -/
noncomputable def Biases.headsQK (b : Biases (Arch.attention sees χ H dh) dOut)
    (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => ∑ k', b.read ℓ (q.1, Sum.inl k') * (K ℓ q.1 : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
    | Sum.inr (Sum.inl k) =>
      ∑ k', b.read ℓ (q.1, Sum.inr (Sum.inl k'))
        * (((K ℓ q.1)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k'
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k))
  write := b.write
  D := b.D

/-- **The biases after the changes of basis `K` between values and outputs:** `b_{V,i} K_i`; the
other biases do not move. -/
noncomputable def Biases.headsVO (b : Biases (Arch.attention sees χ H dh) dOut)
    (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k))
    | Sum.inr (Sum.inr k) =>
      ∑ k', b.read ℓ (q.1, Sum.inr (Sum.inr k')) * (K ℓ q.1 : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
  write := b.write
  D := b.D

/-- **The biases after the shift `κ` of the key biases:** `b_{K,i} + κ_i`. -/
def Biases.keyShift (b : Biases (Arch.attention sees χ H dh) dOut)
    (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k)) + κ ℓ q.1 k
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k))
  write := b.write
  D := b.D

/-- **The biases after the value biases are moved into the output bias:** `b_{V,i} + ν_i` and
`b_write − ∑_i ν_i W_{O,i}`, with the outputs `W_O` of the weights `θ`. -/
def Biases.valueShift (b : Biases (Arch.attention sees χ H dh) dOut)
    (θ : Params (Arch.attention sees χ H dh) dIn dOut) (ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k))
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k)) + ν ℓ q.1 k
  write ℓ a := b.write ℓ a - ∑ i, ∑ k, ν ℓ i k * θ.write ℓ (i, k) a
  D := b.D

/-- The space of the `σ = (K, K', κ, ν)`: two square matrices and two rows per head. -/
abbrev HeadsSpace (H dh : Fin L → Type) : Type :=
  (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) × (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
    × (∀ ℓ, H ℓ → dh ℓ → ℝ) × (∀ ℓ, H ℓ → dh ℓ → ℝ)

/-- **The symmetries inside attention blocks with biases:** the `σ = (K, K', κ, ν)` with every
`K_i` and `K'_i` invertible. -/
def headsSet (H dh : Fin L → Type) [∀ ℓ, Fintype (dh ℓ)] [∀ ℓ, DecidableEq (dh ℓ)] :
    Set (HeadsSpace H dh) :=
  {σ | ∀ ℓ i, IsUnit (σ.1 ℓ i).det ∧ IsUnit (σ.2.1 ℓ i).det}

/-- **The map of `σ = (K, K', κ, ν)` on the weights and biases of attention blocks:** the change
of basis `K` between queries and keys, then `K'` between values and outputs, then the shift `κ`
of the key biases, then the value biases moved by `ν` into the output bias. -/
noncomputable def headsAct (σ : HeadsSpace H dh)
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    Params (Arch.attention sees χ H dh) dIn dOut × Biases (Arch.attention sees χ H dh) dOut :=
  ((q.1.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO fun ℓ i => glOfMatrix (σ.2.1 ℓ i),
    ((((q.2.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO
        fun ℓ i => glOfMatrix (σ.2.1 ℓ i)).keyShift σ.2.2.1).valueShift
      ((q.1.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO fun ℓ i => glOfMatrix (σ.2.1 ℓ i))
      σ.2.2.2))

/-- Helper: `glOfMatrix M` is `M` when `M` is invertible. -/
private theorem coe_glOfMatrix_bga {n : Type*} [Fintype n] [DecidableEq n] (M : Matrix n n ℝ)
    (h : IsUnit M.det) : ((glOfMatrix M : GL n ℝ) : Matrix n n ℝ) = M := by
  simp [glOfMatrix, h.ne_zero]

/-- Helper: `glOfMatrix 1 = 1`. -/
private theorem glOfMatrix_one_bga {n : Type*} [Fintype n] [DecidableEq n] :
    glOfMatrix (1 : Matrix n n ℝ) = 1 :=
  Units.ext (coe_glOfMatrix_bga 1 (by simp))

/-- Helper (the private `cancel_left_of_rank_ahb` of `Symmetry/AttentionHeadsBiases.lean`): a
matrix `M` of rank equal to its number of columns cancels on the left, `M X = M Y → X = Y`. -/
private theorem cancel_left_of_rank_bga {m n k : Type*} [Fintype n] (M : Matrix m n ℝ)
    (hM : M.rank = Fintype.card n) {X Y : Matrix n k ℝ} (h : M * X = M * Y) : X = Y := by
  -- `v ↦ M v` is injective: `rank M + dim ker M = card n`
  have hinj : Function.Injective M.mulVecLin := by
    rw [← LinearMap.ker_eq_bot, ← Submodule.finrank_eq_zero]
    have := LinearMap.finrank_range_add_finrank_ker M.mulVecLin
    rw [Module.finrank_fintype_fun_eq_card] at this
    rw [Matrix.rank] at hM
    omega
  -- compare `X` and `Y` column by column
  ext i j
  have hcol : M.mulVecLin (fun l => X l j) = M.mulVecLin (fun l => Y l j) := by
    funext q
    have := congrFun (congrFun h q) j
    simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct] using this
  exact congrFun (hinj hcol) i

/-- The set of the `σ` is open. -/
theorem isOpen_headsSet : IsOpen (headsSet H dh) := by
  -- finitely many conditions `det ≠ 0`, each open
  have h : headsSet H dh = ⋂ ℓ, ⋂ i, ({σ : HeadsSpace H dh | (σ.1 ℓ i).det ≠ 0}
      ∩ {σ | (σ.2.1 ℓ i).det ≠ 0}) := by
    ext σ
    simp [headsSet, isUnit_iff_ne_zero]
  rw [h]
  refine isOpen_iInter_of_finite fun ℓ => isOpen_iInter_of_finite fun i => IsOpen.inter ?_ ?_
  · exact isOpen_ne_fun
      ((continuous_apply i).comp ((continuous_apply ℓ).comp continuous_fst)).matrix_det
      continuous_const
  · exact isOpen_ne_fun ((continuous_apply i).comp
      ((continuous_apply ℓ).comp (continuous_fst.comp continuous_snd))).matrix_det
      continuous_const

/-- The set of the `σ` is not empty. -/
theorem headsSet_nonempty : (headsSet H dh).Nonempty :=
  -- all matrices `1`, all rows `0`
  ⟨(fun _ _ => 1, fun _ _ => 1, fun _ _ => 0, fun _ _ => 0), fun _ _ =>
    ⟨by simp, by simp⟩⟩

/-- The space of the `σ` has dimension `2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem finrank_headsSpace :
    Module.finrank ℝ (HeadsSpace H dh)
      = 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
        + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
  have h1 : Module.finrank ℝ (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2 := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_matrix, Module.finrank_self, mul_one,
      Finset.sum_const, Finset.card_univ, smul_eq_mul, sq]
  have h2 : Module.finrank ℝ (∀ ℓ, H ℓ → dh ℓ → ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_self, mul_one, Finset.sum_const,
      Finset.card_univ, smul_eq_mul]
  rw [Module.finrank_prod, Module.finrank_prod, Module.finrank_prod, h1, h2]
  ring

/-! ### Helpers: the maps with the changes of basis given in `GL` -/

/-- Helper: the map of `(K, K', κ, ν)` with `K`, `K'` given in `GL`. -/
private noncomputable def actGL_bga (K N : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (κ ν : ∀ ℓ, H ℓ → dh ℓ → ℝ)
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    Params (Arch.attention sees χ H dh) dIn dOut × Biases (Arch.attention sees χ H dh) dOut :=
  ((q.1.headsQK K).headsVO N,
    (((q.2.headsQK K).headsVO N).keyShift κ).valueShift ((q.1.headsQK K).headsVO N) ν)

/-- Helper: `headsAct σ` is the map of `σ` with `glOfMatrix` of its matrices. -/
private theorem headsAct_apply_bga (σ : HeadsSpace H dh)
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    headsAct σ q = actGL_bga (fun ℓ i => glOfMatrix (σ.1 ℓ i))
      (fun ℓ i => glOfMatrix (σ.2.1 ℓ i)) σ.2.2.1 σ.2.2.2 q := rfl

/-- Helper: `glOfMatrix` of an element of `GL` is that element. -/
private theorem glOfMatrix_coe_bga {n : Type*} [Fintype n] [DecidableEq n] (g : GL n ℝ) :
    glOfMatrix (g : Matrix n n ℝ) = g :=
  Units.ext (coe_glOfMatrix_bga _ ((Matrix.isUnit_iff_isUnit_det _).1 g.isUnit))

section Entries

variable (θ : Params (Arch.attention sees χ H dh) dIn dOut)
  (b : Biases (Arch.attention sees χ H dh) dOut) (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ)
  (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) (ℓ : Fin L) (a : d) (i : H ℓ) (k : dh ℓ)

/-- Helper: an entry of `θ.headsQK K` (query column). -/
private theorem pQKq_bga : (θ.headsQK K).read ℓ a (i, Sum.inl k)
    = ∑ k', θ.read ℓ a (i, Sum.inl k') * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k := rfl
/-- Helper: an entry of `θ.headsQK K` (key column). -/
private theorem pQKk_bga : (θ.headsQK K).read ℓ a (i, Sum.inr (Sum.inl k))
    = ∑ k', θ.read ℓ a (i, Sum.inr (Sum.inl k'))
      * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k' := rfl
/-- Helper: an entry of `θ.headsQK K` (value column). -/
private theorem pQKv_bga : (θ.headsQK K).read ℓ a (i, Sum.inr (Sum.inr k))
    = θ.read ℓ a (i, Sum.inr (Sum.inr k)) := rfl
/-- Helper: the write of `θ.headsQK K`. -/
private theorem pQKw_bga : (θ.headsQK K).write ℓ = θ.write ℓ := rfl
/-- Helper: an entry of `θ.headsVO K` (query column). -/
private theorem pVOq_bga : (θ.headsVO K).read ℓ a (i, Sum.inl k) = θ.read ℓ a (i, Sum.inl k) :=
  rfl
/-- Helper: an entry of `θ.headsVO K` (key column). -/
private theorem pVOk_bga : (θ.headsVO K).read ℓ a (i, Sum.inr (Sum.inl k))
    = θ.read ℓ a (i, Sum.inr (Sum.inl k)) := rfl
/-- Helper: an entry of `θ.headsVO K` (value column). -/
private theorem pVOv_bga : (θ.headsVO K).read ℓ a (i, Sum.inr (Sum.inr k))
    = ∑ k', θ.read ℓ a (i, Sum.inr (Sum.inr k')) * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k := rfl
/-- Helper: an entry of the write of `θ.headsVO K`. -/
private theorem pVOw_bga (c : d) : (θ.headsVO K).write ℓ (i, k) c
    = ∑ k', (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k' * θ.write ℓ (i, k') c :=
  rfl
/-- Helper: an entry of `b.headsQK K` (query). -/
private theorem bQKq_bga : (b.headsQK K).read ℓ (i, Sum.inl k)
    = ∑ k', b.read ℓ (i, Sum.inl k') * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k := rfl
/-- Helper: an entry of `b.headsQK K` (key). -/
private theorem bQKk_bga : (b.headsQK K).read ℓ (i, Sum.inr (Sum.inl k))
    = ∑ k', b.read ℓ (i, Sum.inr (Sum.inl k'))
      * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k' := rfl
/-- Helper: an entry of `b.headsQK K` (value). -/
private theorem bQKv_bga : (b.headsQK K).read ℓ (i, Sum.inr (Sum.inr k))
    = b.read ℓ (i, Sum.inr (Sum.inr k)) := rfl
/-- Helper: the write bias of `b.headsQK K`. -/
private theorem bQKw_bga : (b.headsQK K).write ℓ = b.write ℓ := rfl
/-- Helper: an entry of `b.headsVO K` (query). -/
private theorem bVOq_bga : (b.headsVO K).read ℓ (i, Sum.inl k) = b.read ℓ (i, Sum.inl k) := rfl
/-- Helper: an entry of `b.headsVO K` (key). -/
private theorem bVOk_bga : (b.headsVO K).read ℓ (i, Sum.inr (Sum.inl k))
    = b.read ℓ (i, Sum.inr (Sum.inl k)) := rfl
/-- Helper: an entry of `b.headsVO K` (value). -/
private theorem bVOv_bga : (b.headsVO K).read ℓ (i, Sum.inr (Sum.inr k))
    = ∑ k', b.read ℓ (i, Sum.inr (Sum.inr k')) * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k := rfl
/-- Helper: the write bias of `b.headsVO K`. -/
private theorem bVOw_bga : (b.headsVO K).write ℓ = b.write ℓ := rfl
/-- Helper: an entry of `b.keyShift κ` (query). -/
private theorem kSq_bga : (b.keyShift κ).read ℓ (i, Sum.inl k) = b.read ℓ (i, Sum.inl k) := rfl
/-- Helper: an entry of `b.keyShift κ` (key). -/
private theorem kSk_bga : (b.keyShift κ).read ℓ (i, Sum.inr (Sum.inl k))
    = b.read ℓ (i, Sum.inr (Sum.inl k)) + κ ℓ i k := rfl
/-- Helper: an entry of `b.keyShift κ` (value). -/
private theorem kSv_bga : (b.keyShift κ).read ℓ (i, Sum.inr (Sum.inr k))
    = b.read ℓ (i, Sum.inr (Sum.inr k)) := rfl
/-- Helper: the write bias of `b.keyShift κ`. -/
private theorem kSw_bga : (b.keyShift κ).write ℓ = b.write ℓ := rfl
/-- Helper: an entry of `b.valueShift θ κ` (query). -/
private theorem vSq_bga : (b.valueShift θ κ).read ℓ (i, Sum.inl k) = b.read ℓ (i, Sum.inl k) :=
  rfl
/-- Helper: an entry of `b.valueShift θ κ` (key). -/
private theorem vSk_bga : (b.valueShift θ κ).read ℓ (i, Sum.inr (Sum.inl k))
    = b.read ℓ (i, Sum.inr (Sum.inl k)) := rfl
/-- Helper: an entry of `b.valueShift θ κ` (value). -/
private theorem vSv_bga : (b.valueShift θ κ).read ℓ (i, Sum.inr (Sum.inr k))
    = b.read ℓ (i, Sum.inr (Sum.inr k)) + κ ℓ i k := rfl
/-- Helper: an entry of the write bias of `b.valueShift θ κ`. -/
private theorem vSw_bga (c : d) : (b.valueShift θ κ).write ℓ c
    = b.write ℓ c - ∑ i, ∑ k, κ ℓ i k * θ.write ℓ (i, k) c := rfl

end Entries

/-! ### Helpers: sums -/

/-- Helper: `(x A) B = x (A B)`, entry `k`. -/
private theorem sumA_bga {n : Type*} [Fintype n] [DecidableEq n] (x : n → ℝ) (A B : GL n ℝ)
    (k : n) :
    ∑ k', (∑ k'', x k'' * (A : Matrix n n ℝ) k'' k') * (B : Matrix n n ℝ) k' k
      = ∑ k', x k' * ∑ j, (A : Matrix n n ℝ) k' j * (B : Matrix n n ℝ) j k := by
  simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
  exact Finset.sum_comm

/-- Helper: `(x Aᵀ) Bᵀ = x (B A)ᵀ`, entry `k`. -/
private theorem sumB_bga {n : Type*} [Fintype n] [DecidableEq n] (x : n → ℝ) (A B : GL n ℝ)
    (k : n) :
    ∑ k', (∑ k'', x k'' * (A : Matrix n n ℝ) k' k'') * (B : Matrix n n ℝ) k k'
      = ∑ k', x k' * ∑ j, (B : Matrix n n ℝ) k j * (A : Matrix n n ℝ) j k' := by
  simp only [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring

/-- Helper: `B (A w) = (B A) w`, entry `k`. -/
private theorem sumC_bga {n : Type*} [Fintype n] [DecidableEq n] (w : n → ℝ) (A B : GL n ℝ)
    (k : n) :
    ∑ k', (B : Matrix n n ℝ) k k' * ∑ k'', (A : Matrix n n ℝ) k' k'' * w k''
      = ∑ k', (∑ j, (B : Matrix n n ℝ) k j * (A : Matrix n n ℝ) j k') * w k' := by
  simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
  exact Finset.sum_comm

/-- Helper (the private `sum_mul_GL_ahb` of `Symmetry/AttentionHeadsBiases.lean`):
`∑_k (x G)_k (G⁻¹ y)_k = x · y` for `G ∈ GL n`. -/
private theorem sum_mul_GL_bga {n : Type*} [Fintype n] [DecidableEq n] (G : GL n ℝ)
    (x y : n → ℝ) :
    ∑ k, (∑ a, x a * (G : Matrix n n ℝ) a k) * (∑ b, ((G⁻¹ : GL n ℝ) : Matrix n n ℝ) k b * y b)
      = ∑ a, x a * y a := by
  have h : (x ᵥ* (G : Matrix n n ℝ)) ⬝ᵥ (((G⁻¹ : GL n ℝ) : Matrix n n ℝ) *ᵥ y) = x ⬝ᵥ y := by
    rw [← Matrix.dotProduct_mulVec, Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec]
  exact h

/-- Helper: `(x G)ᵀ`-row against `G⁻¹`: `∑_{k'} (∑_{k''} x_{k''} G_{k' k''}) (G⁻¹)_{k k'} = x_k`. -/
private theorem sum_inv1_bga {n : Type*} [Fintype n] [DecidableEq n] (G : GL n ℝ) (x : n → ℝ)
    (k : n) :
    ∑ k', (∑ k'', x k'' * (G : Matrix n n ℝ) k' k'') * ((G⁻¹ : GL n ℝ) : Matrix n n ℝ) k k'
      = x k := by
  have h : (((G⁻¹ : GL n ℝ) : Matrix n n ℝ) *ᵥ ((G : Matrix n n ℝ) *ᵥ x)) k = x k := by
    rw [Matrix.mulVec_mulVec, Units.inv_mul, Matrix.one_mulVec]
  rw [← h]
  simp only [Matrix.mulVec, dotProduct]
  refine Finset.sum_congr rfl fun k' _ => ?_
  rw [mul_comm]
  congr 1
  exact Finset.sum_congr rfl fun _ _ => mul_comm _ _

/-- Helper: `x G⁻¹ G = x`, entry `k`. -/
private theorem sum_inv2_bga {n : Type*} [Fintype n] [DecidableEq n] (G : GL n ℝ) (x : n → ℝ)
    (k : n) :
    ∑ k', (∑ k'', x k'' * ((G⁻¹ : GL n ℝ) : Matrix n n ℝ) k'' k') * (G : Matrix n n ℝ) k' k
      = x k := by
  have h : ((x ᵥ* ((G⁻¹ : GL n ℝ) : Matrix n n ℝ)) ᵥ* (G : Matrix n n ℝ)) k = x k := by
    rw [Matrix.vecMul_vecMul, Units.inv_mul, Matrix.vecMul_one]
  exact h

/-- Helper: `∑_a g_a ∑_{k'} W_{a k'} c_{k'} = ∑_{k'} (g W)_{k'} c_{k'}`. -/
private theorem sum_vecMul_bga {m n : Type*} [Fintype m] [Fintype n] (g : m → ℝ)
    (W : m → n → ℝ) (c : n → ℝ) :
    ∑ a, g a * ∑ k', W a k' * c k' = ∑ k', (∑ a, g a * W a k') * c k' := by
  simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
  exact Finset.sum_comm

/-- Helper: `∑_c (∑_i ∑_k ν_{ik} W_{ikc}) G_c = ∑_i ∑_k ν_{ik} ∑_c W_{ikc} G_c`. -/
private theorem sum_sum_mul_bga {ι κ' δ : Type*} [Fintype ι] [Fintype κ'] [Fintype δ]
    (ν : ι → κ' → ℝ) (W : ι → κ' → δ → ℝ) (G : δ → ℝ) :
    ∑ c, (∑ i, ∑ k, ν i k * W i k c) * G c = ∑ i, ∑ k, ν i k * ∑ c, W i k c * G c := by
  simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  exact Finset.sum_comm

/-! ### Helpers: the group law of the maps -/

/-- Helper: with `K = K' = 1` and `κ = ν = 0` the map is the identity. -/
private theorem actGL_one_bga
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    actGL_bga (fun _ _ => 1) (fun _ _ => 1) (fun _ _ => 0) (fun _ _ => 0) q = q := by
  obtain ⟨θ, b⟩ := q
  refine Prod.ext (Params.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl)
    (Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl)
  · ext a ⟨i, k | k | k⟩ <;>
      simp [actGL_bga, pVOq_bga, pVOk_bga, pVOv_bga, pQKq_bga, pQKk_bga, pQKv_bga,
        Matrix.one_apply]
  · ext ⟨i, k⟩ c
    simp [actGL_bga, pVOw_bga, pQKw_bga, Matrix.one_apply]
  · funext q
    obtain ⟨i, k | k | k⟩ := q <;>
      simp [actGL_bga, vSq_bga, vSk_bga, vSv_bga, kSq_bga, kSk_bga, kSv_bga, bVOq_bga, bVOk_bga,
        bVOv_bga, bQKq_bga, bQKk_bga, bQKv_bga, Matrix.one_apply]
  · funext c
    simp [actGL_bga, vSw_bga, kSw_bga, bVOw_bga, bQKw_bga]

/-- Helper: two changes of basis inside the heads in a row, on the weights. -/
private theorem actP_comp_bga (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (K₁ N₁ K₂ N₂ : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) :
    (((θ.headsQK K₂).headsVO N₂).headsQK K₁).headsVO N₁
      = (θ.headsQK fun ℓ i => K₂ ℓ i * K₁ ℓ i).headsVO fun ℓ i => N₂ ℓ i * N₁ ℓ i := by
  refine Params.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl
  · ext a ⟨i, k | k | k⟩ <;>
      simp only [pVOq_bga, pVOk_bga, pVOv_bga, pQKq_bga, pQKk_bga, pQKv_bga, Units.val_mul,
        _root_.mul_inv_rev, Matrix.mul_apply, sumA_bga, sumB_bga]
  · ext ⟨i, k⟩ c
    simp only [pVOw_bga, pQKw_bga, Units.val_mul, _root_.mul_inv_rev, Matrix.mul_apply, sumC_bga]

/-- Helper: the map of `σ` after the map of `σ'` is the map of
`(K' K, N' N, κ' K^{-⊤} + κ, ν' N + ν)`. -/
private theorem actGL_comp_bga (K₁ N₁ K₂ N₂ : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ)
    (κ₁ ν₁ κ₂ ν₂ : ∀ ℓ, H ℓ → dh ℓ → ℝ)
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    actGL_bga K₁ N₁ κ₁ ν₁ (actGL_bga K₂ N₂ κ₂ ν₂ q)
      = actGL_bga (fun ℓ i => K₂ ℓ i * K₁ ℓ i) (fun ℓ i => N₂ ℓ i * N₁ ℓ i)
        (fun ℓ i k => ∑ k', κ₂ ℓ i k'
          * (((K₁ ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k' + κ₁ ℓ i k)
        (fun ℓ i k => ∑ k', ν₂ ℓ i k' * (N₁ ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k + ν₁ ℓ i k)
        q := by
  obtain ⟨θ, b⟩ := q
  have hP := actP_comp_bga θ K₁ N₁ K₂ N₂
  refine Prod.ext hP ?_
  simp only [actGL_bga]
  rw [← hP]
  refine Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl
  · funext q
    obtain ⟨i, k | k | k⟩ := q <;>
      simp only [vSq_bga, vSk_bga, vSv_bga, kSq_bga, kSk_bga, kSv_bga, bVOq_bga, bVOk_bga,
        bVOv_bga, bQKq_bga, bQKk_bga, bQKv_bga, Units.val_mul, _root_.mul_inv_rev,
        Matrix.mul_apply, add_mul, Finset.sum_add_distrib, sumA_bga, sumB_bga] <;> ring
  · funext c
    simp only [vSw_bga, kSw_bga, bVOw_bga, bQKw_bga, pVOw_bga, pQKw_bga, add_mul,
      Finset.sum_add_distrib, sum_mul_GL_bga]
    ring

/-! ### Helpers: the maps commute with the changes of basis and the translations -/

/-- Helper: the changes of basis inside the heads commute with the changes of basis `G`: the
heads act on the columns of the reads and the rows of the writes, `G` on the other side. -/
private theorem cob_heads_bga (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (K N : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (G : Fin (L + 1) → GL d ℝ) :
    ((θ.headsQK K).headsVO N).cob G G = ((θ.cob G G).headsQK K).headsVO N := by
  refine Params.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl
  · ext a ⟨i, k | k | k⟩ <;>
      simp only [Params.cob, Matrix.mul_apply, pVOq_bga, pVOk_bga, pVOv_bga, pQKq_bga, pQKk_bga,
        pQKv_bga, Finset.mul_sum, Finset.sum_mul, mul_assoc] <;>
      exact Finset.sum_comm
  · ext ⟨i, k⟩ c
    simp only [Params.cob, Matrix.mul_apply, pVOw_bga, pQKw_bga, Finset.mul_sum, Finset.sum_mul,
      mul_assoc]
    exact Finset.sum_comm

/-- Helper: the maps commute with the translations of a skipless network and the changes of
basis, on the biases: `(b − g W) K = b K − g (W K)` column by column, and the value shift
`ν (K'^{-1} W_O)` of the write bias commutes with `G`. -/
private theorem translateAllAt_heads_bga (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (b : Biases (Arch.attention sees χ H dh) dOut) (K N : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ)
    (κ ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) (G : Fin (L + 1) → GL d ℝ) (g : Fin (L + 1) → d → ℝ) :
    ((((((b.headsQK K).headsVO N).keyShift κ).valueShift ((θ.headsQK K).headsVO N) ν).translateAllAt
        ((θ.headsQK K).headsVO N) g).cob G)
      = (((((b.translateAllAt θ g).cob G).headsQK K).headsVO N).keyShift κ).valueShift
        (((θ.cob G G).headsQK K).headsVO N) ν := by
  rw [← cob_heads_bga]
  refine Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl
  · funext q
    obtain ⟨i, k | k | k⟩ := q <;>
      simp only [Biases.cob, Biases.translateAllAt, Pi.sub_apply, Matrix.vecMul, dotProduct,
        vSq_bga, vSk_bga, vSv_bga, kSq_bga, kSk_bga, kSv_bga, bVOq_bga, bVOk_bga, bVOv_bga,
        bQKq_bga, bQKk_bga, bQKv_bga, pVOq_bga, pVOk_bga, pVOv_bga, pQKq_bga, pQKk_bga, pQKv_bga,
        sum_vecMul_bga, sub_mul, Finset.sum_sub_distrib] <;> ring
  · funext c
    simp only [Biases.cob, Biases.translateAllAt, Params.cob, Matrix.vecMul, dotProduct,
      Pi.add_apply, vSw_bga, kSw_bga, bVOw_bga, bQKw_bga, Matrix.mul_apply, add_mul, sub_mul,
      Finset.sum_add_distrib, Finset.sum_sub_distrib, sum_sum_mul_bga]
    ring

/-- Helper: the same for the translations of a residual network. -/
private theorem translateAll_heads_bga (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (b : Biases (Arch.attention sees χ H dh) dOut) (K N : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ)
    (κ ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) (G : Fin (L + 1) → GL d ℝ) (g : Fin (L + 1) → d → ℝ) :
    ((((((b.headsQK K).headsVO N).keyShift κ).valueShift ((θ.headsQK K).headsVO N) ν).translateAll
        ((θ.headsQK K).headsVO N) g).cob G)
      = (((((b.translateAll θ g).cob G).headsQK K).headsVO N).keyShift κ).valueShift
        (((θ.cob G G).headsQK K).headsVO N) ν := by
  rw [← cob_heads_bga]
  refine Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl
  · funext q
    obtain ⟨i, k | k | k⟩ := q <;>
      simp only [Biases.cob, Biases.translateAll, Pi.sub_apply, Matrix.vecMul, dotProduct,
        vSq_bga, vSk_bga, vSv_bga, kSq_bga, kSk_bga, kSv_bga, bVOq_bga, bVOk_bga, bVOv_bga,
        bQKq_bga, bQKk_bga, bQKv_bga, pVOq_bga, pVOk_bga, pVOv_bga, pQKq_bga, pQKk_bga, pQKv_bga,
        sum_vecMul_bga, sub_mul, Finset.sum_sub_distrib] <;> ring
  · funext c
    simp only [Biases.cob, Biases.translateAll, Params.cob, Matrix.vecMul, dotProduct,
      Pi.add_apply, vSw_bga, kSw_bga, bVOw_bga, bQKw_bga, Matrix.mul_apply, add_mul, sub_mul,
      Finset.sum_add_distrib, Finset.sum_sub_distrib, sum_sum_mul_bga]
    ring

/-! ### Helpers: the rank of the writes -/

/-- Helper: multiplying the rows `(i, ·)` of `W` by a matrix `P_i` does not raise the rank: it is
a block-diagonal matrix times `W`. -/
private theorem rank_heads_le_bga {I n m : Type*} [Fintype I] [DecidableEq I] [Fintype n]
    [DecidableEq n] [Fintype m] (P : I → Matrix n n ℝ) (W : Matrix (I × n) m ℝ) :
    (Matrix.of fun (p : I × n) c => ∑ k', P p.1 p.2 k' * W (p.1, k') c).rank ≤ W.rank := by
  have h : (Matrix.of fun (p : I × n) c => ∑ k', P p.1 p.2 k' * W (p.1, k') c)
      = (Matrix.of fun (p q : I × n) => if p.1 = q.1 then P p.1 p.2 q.2 else 0) * W := by
    ext ⟨i, k⟩ c
    rw [Matrix.mul_apply, Fintype.sum_prod_type, Finset.sum_eq_single i]
    · simp
    · intro j _ hj
      simp [Ne.symm hj]
    · simp
  rw [h]
  exact Matrix.rank_mul_le_right _ _

/-- Helper: the write after the changes of basis `K'` between values and outputs has the rank of
the write: each is a block-diagonal matrix times the other. -/
private theorem rank_write_bga (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (K N : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (ℓ : Fin L) :
    (((θ.headsQK K).headsVO N).write ℓ).rank = (θ.write ℓ).rank := by
  classical
  refine le_antisymm (rank_heads_le_bga
    (fun i => (((N ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ)) (θ.write ℓ)) ?_
  have h : θ.write ℓ = Matrix.of fun (p : H ℓ × dh ℓ) c =>
      ∑ k', (N ℓ p.1 : Matrix (dh ℓ) (dh ℓ) ℝ) p.2 k'
        * ((θ.headsQK K).headsVO N).write ℓ (p.1, k') c := by
    ext ⟨i, k⟩ c
    have e : ((N ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ)
        *ᵥ ((((N ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ)
        *ᵥ fun k' => θ.write ℓ (i, k') c)) k = θ.write ℓ (i, k) c := by
      rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec]
    exact e.symm
  calc (θ.write ℓ).rank
      = (Matrix.of fun (p : H ℓ × dh ℓ) c => ∑ k', (N ℓ p.1 : Matrix (dh ℓ) (dh ℓ) ℝ) p.2 k'
          * ((θ.headsQK K).headsVO N).write ℓ (p.1, k') c).rank := by rw [← h]
    _ ≤ _ := rank_heads_le_bga (fun i => (N ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ)) _

/-! ### Helpers: every map keeps the map of every block

Copies of the private helpers of `Symmetry/AttentionHeadsBiases.lean`. -/

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: the map `f ℓ` of an attention block is the same on `M'` and `M` if the query columns
of head `i` of `M'` are those of `M` times `G_i`, its key columns those of `M` times `G_i^{-⊤}`,
and its value columns those of `M`: the scores `∑_k (q G)_k (k G^{-⊤})_k = q · k` are kept. -/
private theorem f_QK_bga (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (ℓ : Fin L)
    (M M' : Matrix T (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ)
    (hq : ∀ t i k, M' t (i, Sum.inl k)
      = ∑ a, M t (i, Sum.inl a) * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) a k)
    (hk : ∀ t i k, M' t (i, Sum.inr (Sum.inl k))
      = ∑ a, M t (i, Sum.inr (Sum.inl a))
        * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k a)
    (hv : ∀ t i k, M' t (i, Sum.inr (Sum.inr k)) = M t (i, Sum.inr (Sum.inr k))) :
    (Arch.attention sees χ H dh).f ℓ M' = (Arch.attention sees χ H dh).f ℓ M := by
  -- the scores of every head are kept
  have hsc : ∀ i : H ℓ, (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (i, Sum.inl k) * M' s' (i, Sum.inr (Sum.inl k)) : Matrix T T ℝ)
      = Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (i, Sum.inl k) * M s' (i, Sum.inr (Sum.inl k)) := by
    intro i
    ext t' s'
    simp only [Matrix.of_apply, hq, hk]
    congr 1
    rw [← sum_mul_GL_bga (K ℓ i) (fun a => M t' (i, Sum.inl a))
      (fun a => M s' (i, Sum.inr (Sum.inl a)))]
    refine Finset.sum_congr rfl fun k _ => ?_
    congr 1
    exact Finset.sum_congr rfl fun _ _ => mul_comm _ _
  ext t p
  show ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (p.1, Sum.inl k) * M' s' (p.1, Sum.inr (Sum.inl k))) t s
      * M' s (p.1, Sum.inr (Sum.inr p.2))
    = ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (p.1, Sum.inl k) * M s' (p.1, Sum.inr (Sum.inl k))) t s
      * M s (p.1, Sum.inr (Sum.inr p.2))
  rw [hsc p.1]
  simp only [hv]

omit [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: the changes of basis between queries and keys, with the biases of the queries and
keys moved along, keep the map `n ↦ f(n W_read + b_read) W_write + b_write` of every block. -/
private theorem block_headsQKB_bga
    (θ : Params (Arch.attention sees χ H dh) dIn dOut)
    (b : Biases (Arch.attention sees χ H dh) dOut) (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (ℓ : Fin L)
    (n : Matrix T d ℝ) :
    (Arch.attention sees χ H dh).f ℓ (n * (θ.headsQK K).read ℓ
          + Matrix.of fun _ => (b.headsQK K).read ℓ) * (θ.headsQK K).write ℓ
        + Matrix.of (fun _ => (b.headsQK K).write ℓ)
      = (Arch.attention sees χ H dh).f ℓ (n * θ.read ℓ + Matrix.of fun _ => b.read ℓ)
          * θ.write ℓ + Matrix.of fun _ => b.write ℓ := by
  rw [f_QK_bga K ℓ (n * θ.read ℓ + Matrix.of fun _ => b.read ℓ) _ ?_ ?_ ?_]
  · rfl
  · -- the query columns: `(n W_Q + b_Q) K = n (W_Q K) + b_Q K`
    intro t i k
    show ∑ a, n t a * (∑ k', θ.read ℓ a (i, Sum.inl k') * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k)
        + ∑ k', b.read ℓ (i, Sum.inl k') * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
      = ∑ a', (∑ a, n t a * θ.read ℓ a (i, Sum.inl a') + b.read ℓ (i, Sum.inl a'))
          * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) a' k
    simp only [add_mul, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    congr 1
    refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
    ring
  · -- the key columns: `(n W_K + b_K) K^{-⊤} = n (W_K K^{-⊤}) + b_K K^{-⊤}`
    intro t i k
    show ∑ a, n t a * (∑ k', θ.read ℓ a (i, Sum.inr (Sum.inl k'))
          * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k')
        + ∑ k', b.read ℓ (i, Sum.inr (Sum.inl k'))
          * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k'
      = ∑ a', (∑ a, n t a * θ.read ℓ a (i, Sum.inr (Sum.inl a'))
          + b.read ℓ (i, Sum.inr (Sum.inl a')))
          * (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k a'
    simp only [add_mul, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    congr 1
    refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
    ring
  · -- the value columns do not move
    intro t i k
    rfl

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: `f ℓ (M') W' = f ℓ (M) W` if the query and key columns of `M'` are those of `M`, the
value columns of head `i` of `M'` are those of `M` times `G_i`, and the rows `(i, ·)` of `W'` are
`G_i^{-1}` times those of `W`: the weights are kept, and `(a v G)(G^{-1} W_O) = a v W_O`. -/
private theorem f_VO_bga (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) (ℓ : Fin L)
    (M M' : Matrix T (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ) (W W' : Matrix (H ℓ × dh ℓ) d ℝ)
    (hq : ∀ t i k, M' t (i, Sum.inl k) = M t (i, Sum.inl k))
    (hk : ∀ t i k, M' t (i, Sum.inr (Sum.inl k)) = M t (i, Sum.inr (Sum.inl k)))
    (hv : ∀ t i k, M' t (i, Sum.inr (Sum.inr k))
      = ∑ a, M t (i, Sum.inr (Sum.inr a)) * (K ℓ i : Matrix (dh ℓ) (dh ℓ) ℝ) a k)
    (hW : ∀ i k c, W' (i, k) c
      = ∑ k', (((K ℓ i)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k' * W (i, k') c) :
    (Arch.attention sees χ H dh).f ℓ M' * W' = (Arch.attention sees χ H dh).f ℓ M * W := by
  -- the scores of every head are kept
  have hsc : ∀ i : H ℓ, (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (i, Sum.inl k) * M' s' (i, Sum.inr (Sum.inl k)) : Matrix T T ℝ)
      = Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (i, Sum.inl k) * M s' (i, Sum.inr (Sum.inl k)) := by
    intro i
    ext t' s'
    simp only [Matrix.of_apply, hq, hk]
  -- head by head
  ext t c
  rw [Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun i _ => ?_
  show ∑ k, (∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
          * ∑ k, M' t' (i, Sum.inl k) * M' s' (i, Sum.inr (Sum.inl k))) t s
        * M' s (i, Sum.inr (Sum.inr k))) * W' (i, k) c
    = ∑ k, (∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
          * ∑ k, M t' (i, Sum.inl k) * M s' (i, Sum.inr (Sum.inl k))) t s
        * M s (i, Sum.inr (Sum.inr k))) * W (i, k) c
