import SkipsLean.Symmetry.BiasesGeneratedGroup
import SkipsLean.Symmetry.AttentionHeadsBiases

/-!
# The generated group of Lemma A.8 for attention blocks with biases

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips". The symmetries inside an attention block
(Section 4.1: "the changes of basis inside an attention head"; Appendix A.6: "Each attention head
has a change of basis between its queries and keys and one between its values and outputs, of
dimension `d_h²` each"), and with biases (proof of Theorem B.1 (i)): "The key biases drop out,
since they shift all scores of a token equally, and the value biases enter only through `γ`,
since the weights of a token sum to one."

`Symmetry/BiasesGeneratedGroup.lean` has the lemma's sentence for any family of symmetries inside
the blocks given as maps. Here the family of an attention block with biases, indexed by
`σ = (K, K', κ, ν)` with invertible `K_i`, `K'_i` (an open set of a vector space of dimension
`2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`):

* the change of basis `K_i` between the queries and keys of head `i` (`W_Q K`, `W_K K^{-⊤}`, and
  the same on the biases of the queries and keys);
* the change of basis `K'_i` between its values and outputs (`W_V K'`, `K'^{-1} W_O`, `b_V K'`);
* the shift `κ_i` of its key bias;
* its value bias moved into the output bias (`b_V + ν`, `b_write − ∑_i ν_i W_{O,i}`).

It is a family of symmetries inside the blocks when every token sees a token, and it acts freely
block by block at weights whose query and value matrices have rank `d_h` in every head. The
directions of these maps are `headDirB` of `Symmetry/AttentionHeadsBiases.lean`.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {sees : T → T → Prop} [DecidableRel sees] {χ : Matrix T d ℝ → Matrix T d ℝ}
variable {H dh : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]
  [∀ ℓ, DecidableEq (dh ℓ)]

open Classical in
/-- An invertible matrix as an element of the general linear group; the identity for a matrix
that is not invertible. -/
noncomputable def glOfMatrix {n : Type*} [Fintype n] [DecidableEq n] (M : Matrix n n ℝ) :
    GL n ℝ :=
  if h : IsUnit M.det then Matrix.GeneralLinearGroup.mk'' M h else 1

/-- **The biases after the changes of basis `K` between queries and keys:** `b_{Q,i} K_i`,
`b_{K,i} K_i^{-⊤}`; the other biases do not move. -/
noncomputable def Biases.headsQK (b : Biases (Arch.attention sees χ H dh) dOut)
    (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => ∑ k', b.read ℓ (q.1, Sum.inl k') * (K ℓ q.1 : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
    | Sum.inr (Sum.inl k) =>
      ∑ k', b.read ℓ (q.1, Sum.inr (Sum.inl k'))
        * (((K ℓ q.1)⁻¹ : GL (dh ℓ) ℝ) : Matrix (dh ℓ) (dh ℓ) ℝ) k k'
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k))
  write := b.write
  D := b.D

/-- **The biases after the changes of basis `K` between values and outputs:** `b_{V,i} K_i`; the
other biases do not move. -/
noncomputable def Biases.headsVO (b : Biases (Arch.attention sees χ H dh) dOut)
    (K : ∀ ℓ, H ℓ → GL (dh ℓ) ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k))
    | Sum.inr (Sum.inr k) =>
      ∑ k', b.read ℓ (q.1, Sum.inr (Sum.inr k')) * (K ℓ q.1 : Matrix (dh ℓ) (dh ℓ) ℝ) k' k
  write := b.write
  D := b.D

/-- **The biases after the shift `κ` of the key biases:** `b_{K,i} + κ_i`. -/
def Biases.keyShift (b : Biases (Arch.attention sees χ H dh) dOut)
    (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) : Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k)) + κ ℓ q.1 k
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k))
  write := b.write
  D := b.D

/-- **The biases after the value biases are moved into the output bias:** `b_{V,i} + ν_i` and
`b_write − ∑_i ν_i W_{O,i}`, with the outputs `W_O` of the weights `θ`. -/
def Biases.valueShift (b : Biases (Arch.attention sees χ H dh) dOut)
    (θ : Params (Arch.attention sees χ H dh) dIn dOut) (ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    Biases (Arch.attention sees χ H dh) dOut where
  E := b.E
  read ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) :=
    match q.2 with
    | Sum.inl k => b.read ℓ (q.1, Sum.inl k)
    | Sum.inr (Sum.inl k) => b.read ℓ (q.1, Sum.inr (Sum.inl k))
    | Sum.inr (Sum.inr k) => b.read ℓ (q.1, Sum.inr (Sum.inr k)) + ν ℓ q.1 k
  write ℓ a := b.write ℓ a - ∑ i, ∑ k, ν ℓ i k * θ.write ℓ (i, k) a
  D := b.D

/-- The space of the `σ = (K, K', κ, ν)`: two square matrices and two rows per head. -/
abbrev HeadsSpace (H dh : Fin L → Type) : Type :=
  (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) × (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
    × (∀ ℓ, H ℓ → dh ℓ → ℝ) × (∀ ℓ, H ℓ → dh ℓ → ℝ)

/-- **The symmetries inside attention blocks with biases:** the `σ = (K, K', κ, ν)` with every
`K_i` and `K'_i` invertible. -/
def headsSet (H dh : Fin L → Type) [∀ ℓ, Fintype (dh ℓ)] [∀ ℓ, DecidableEq (dh ℓ)] :
    Set (HeadsSpace H dh) :=
  {σ | ∀ ℓ i, IsUnit (σ.1 ℓ i).det ∧ IsUnit (σ.2.1 ℓ i).det}

/-- **The map of `σ = (K, K', κ, ν)` on the weights and biases of attention blocks:** the change
of basis `K` between queries and keys, then `K'` between values and outputs, then the shift `κ`
of the key biases, then the value biases moved by `ν` into the output bias. -/
noncomputable def headsAct (σ : HeadsSpace H dh)
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut) :
    Params (Arch.attention sees χ H dh) dIn dOut × Biases (Arch.attention sees χ H dh) dOut :=
  ((q.1.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO fun ℓ i => glOfMatrix (σ.2.1 ℓ i),
    ((((q.2.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO
        fun ℓ i => glOfMatrix (σ.2.1 ℓ i)).keyShift σ.2.2.1).valueShift
      ((q.1.headsQK fun ℓ i => glOfMatrix (σ.1 ℓ i)).headsVO fun ℓ i => glOfMatrix (σ.2.1 ℓ i))
      σ.2.2.2))

/-- The set of the `σ` is open. -/
theorem isOpen_headsSet : IsOpen (headsSet H dh) := by
  -- finitely many conditions `det ≠ 0`, each open
  have h : headsSet H dh = ⋂ ℓ, ⋂ i, ({σ : HeadsSpace H dh | (σ.1 ℓ i).det ≠ 0}
      ∩ {σ | (σ.2.1 ℓ i).det ≠ 0}) := by
    ext σ
    simp [headsSet, isUnit_iff_ne_zero]
  rw [h]
  refine isOpen_iInter_of_finite fun ℓ => isOpen_iInter_of_finite fun i => IsOpen.inter ?_ ?_
  · exact isOpen_ne_fun
      ((continuous_apply i).comp ((continuous_apply ℓ).comp continuous_fst)).matrix_det
      continuous_const
  · exact isOpen_ne_fun ((continuous_apply i).comp
      ((continuous_apply ℓ).comp (continuous_fst.comp continuous_snd))).matrix_det
      continuous_const

/-- The set of the `σ` is not empty. -/
theorem headsSet_nonempty : (headsSet H dh).Nonempty :=
  -- all matrices `1`, all rows `0`
  ⟨(fun _ _ => 1, fun _ _ => 1, fun _ _ => 0, fun _ _ => 0), fun _ _ =>
    ⟨by simp, by simp⟩⟩

/-- The space of the `σ` has dimension `2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem finrank_headsSpace :
    Module.finrank ℝ (HeadsSpace H dh)
      = 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
        + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
  have h1 : Module.finrank ℝ (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2 := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_matrix, Module.finrank_self, mul_one,
      Finset.sum_const, Finset.card_univ, smul_eq_mul, sq]
  have h2 : Module.finrank ℝ (∀ ℓ, H ℓ → dh ℓ → ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_self, mul_one, Finset.sum_const,
      Finset.card_univ, smul_eq_mul]
  rw [Module.finrank_prod, Module.finrank_prod, Module.finrank_prod, h1, h2]
  ring

/-- **The changes of basis inside the heads, the shifts of the key biases and the value biases
moved into the output bias are a family of symmetries inside the blocks,** when every token sees
a token. -/
theorem insideBlocksAction_heads (hsee : ∀ t, ∃ s, sees t s) :
    InsideBlocksAction (A := Arch.attention sees χ H dh) (dIn := dIn) (dOut := dOut)
      headsAct (headsSet H dh) := by
  sorry

/-- **They act freely block by block at weights whose query matrix and value matrix have rank
`d_h` in every head.** -/
theorem insideBlocksFreeAt_heads
    (q : Params (Arch.attention sees χ H dh) dIn dOut
      × Biases (Arch.attention sees χ H dh) dOut)
    (hQ : ∀ ℓ (i : H ℓ), ((q.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((q.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    InsideBlocksFreeAt headsAct (headsSet H dh) q := by
  sorry

/-- **Lemma A.8 for attention blocks with biases, with skips:** the pairs `(G, g)` that preserve
the function and the `σ` form a set of dimension
`d² + (L + 1) d + 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem dimH_generated_residual_attention [Nonempty T] [Nonempty dOut] :
    dimH (affMat (affPreservingResidual (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
        ×ˢ headsSet H dh)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)) : ℕ) : ℝ≥0∞) := by
  rw [dimH_affMat_affPreservingResidual_prod _ rfl isOpen_headsSet headsSet_nonempty,
    finrank_headsSpace]

/-- **The same without skips:** dimension
`(L + 1)(d² + d) + 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
theorem dimH_generated_skipless_attention :
    dimH (affMat (affPreservingSkipless (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
        ×ˢ headsSet H dh)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)) : ℕ) : ℝ≥0∞) := by
  rw [dimH_affMat_affPreservingSkipless_prod _ rfl isOpen_headsSet headsSet_nonempty,
    finrank_headsSpace]

end Skips
