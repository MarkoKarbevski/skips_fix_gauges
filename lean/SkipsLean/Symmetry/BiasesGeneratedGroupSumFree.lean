import SkipsLean.Symmetry.BiasesGeneratedGroupSum

/-!
# The family of the pairs acts freely where the two families do

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`".

`Symmetry/BiasesGeneratedGroupSum.lean` has, for a network `A.sum B` with two kinds of block, the
family `sumAct actA actB` of the pairs of a symmetry inside the blocks of `A` and one inside the
blocks of `B`. Here: at weights and biases `q` of the sum at whose two parts the two families act
freely block by block (`InsideBlocksFreeAt`), the family of the pairs acts freely block by block.
With `insideBlocksAction_sumAct` the statements of `Symmetry/BiasesGeneratedGroup.lean` then give
the generated group of the sum and its dimension, with `dim (F₁ × F₂) = dim F₁ + dim F₂`.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A B : Arch T d L} {F₁ F₂ : Type*}
  {actA : F₁ → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut}
  {actB : F₂ → Params B dIn dOut × Biases B dOut → Params B dIn dOut × Biases B dOut}
  {SgA : Set F₁} {SgB : Set F₂}

/-- **The family of the pairs acts freely block by block at `q`,** if the family of `A` does at
the first part of `q` and the family of `B` at the second. -/
theorem insideBlocksFreeAt_sumAct (hA : InsideBlocksAction actA SgA)
    (lA : InsideBlocksLocal actA SgA) (hB : InsideBlocksAction actB SgB)
    (lB : InsideBlocksLocal actB SgB)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut)
    (fA : InsideBlocksFreeAt actA SgA (q.1.sumFst, q.2.sumFst))
    (fB : InsideBlocksFreeAt actB SgB (q.1.sumSnd, q.2.sumSnd)) :
    InsideBlocksFreeAt (sumAct actA actB) (SgA ×ˢ SgB) q := by
  sorry

end Skips
