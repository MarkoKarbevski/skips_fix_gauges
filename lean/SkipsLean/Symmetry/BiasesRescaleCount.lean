/-- Helper: the rescaled hidden units of an MLP block with biases give the same map of the
block: unit `i` contributes `σ(c_i z_i) a_i / c_i^k = σ(z_i) a_i` (the induction step of
`evalB_rescaleMlp`). -/
private theorem block_rescaleMlp_brc {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (θ : Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (b : Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut) (c : ∀ ℓ, hid ℓ → ℝ)
    (hc : ∀ ℓ i, 0 < c ℓ i) (ℓ : Fin L) (n : Matrix T d ℝ) :
    (Arch.mlp σ χ hid).f ℓ (n * (θ.rescaleMlp k c).read ℓ
          + Matrix.of fun _ => (b.rescaleMlp c).read ℓ) * (θ.rescaleMlp k c).write ℓ
        + Matrix.of (fun _ => (b.rescaleMlp c).write ℓ)
      = (Arch.mlp σ χ hid).f ℓ (n * θ.read ℓ + Matrix.of fun _ => b.read ℓ) * θ.write ℓ
        + Matrix.of fun _ => b.write ℓ := by
  -- the write bias is the same; compare `f(P) W` entry by entry
  congr 1
  ext t a
  rw [Matrix.mul_apply, Matrix.mul_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  show σ ((n * (θ.rescaleMlp k c).read ℓ + Matrix.of fun _ => (b.rescaleMlp c).read ℓ :
          Matrix T (hid ℓ) ℝ) t i) * (θ.rescaleMlp k c).write ℓ i a
    = σ ((n * θ.read ℓ + Matrix.of fun _ => b.read ℓ : Matrix T (hid ℓ) ℝ) t i) * θ.write ℓ i a
  have hk : c ℓ i ^ k ≠ 0 := pow_ne_zero k (hc ℓ i).ne'
  rw [preact_rescaleMlp_brc, hσ _ _ (hc ℓ i)]
  simp only [Params.rescaleMlp, Matrix.of_apply]
  field_simp

