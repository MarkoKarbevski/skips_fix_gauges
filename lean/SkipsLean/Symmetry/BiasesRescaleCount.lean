import SkipsLean.Symmetry.InsideBlocksBiases
import SkipsLean.Symmetry.BiasesRescale
import SkipsLean.Dimension.RescalingMlp
import SkipsLean.Dimension.Rescaling
import SkipsLean.Dimension.RescalingGate

/-!
# The count of Lemma A.8 with `s`, for ReLU-type blocks and gated blocks with biases

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips". Appendix
B, Step 3: "A rescaling of the units by numbers `λ_i` is also a direction in parameter space: it
scales column `i` of `W_read` and entry `i` of `b_read` by `λ_i` and row `i` of `W_write` by
`−λ_i` for ReLU, by `−2 λ_i` for ReLU², and similarly for ReGLU and for the values of SwiGLU and
GeGLU"; "`s` is the number of rescalings: `d_hidden` for ReLU, ReLU², SwiGLU and GeGLU,
`2 d_hidden` for ReGLU, none for tanh and GELU."

Here, for the networks with biases of `Network/Biases.lean`:

* `rescaleDirMlpB`, `rescaleDirB`, `rescaleDirGateB`: the directions of the rescalings of the
  hidden units of MLP blocks with a positively homogeneous activation, of the values of gated
  units, and of the gates of gated units with a positively homogeneous gate, with the read bias
  of the unit moved as its read column is (`rescaleDirMlp`, `rescaleDir`, `rescaleDirGate` on the
  weights).
* They are directions of symmetries inside the blocks (`InsideBlocksB`), hence flat with skips
  and without them, for every `χ`.
* The count of Lemma A.8 as bounds on the functional dimension, without normalization:
  `fd ≤ P − d² − (L + 1) d − s` with identity skips and `fd ≤ P − (L + 1)(d² + d) − s` without
  skips, with `s = ∑_ℓ d_hidden,ℓ` for ReLU and ReLU² blocks (no read column vanishes) and for the
  values of gated blocks (no value column vanishes), and `s = 2 ∑_ℓ d_hidden,ℓ` for ReGLU blocks
  (no gate column and no value column vanishes). For tanh and GELU blocks (`s = 0`) the bounds
  are `funDimB_add_le_residual` and `funDimB_add_le_skipless` (`Symmetry/BiasesFlat.lean`).

Numeric check: `ai_notes/biases_inside_blocks_check_2026-11-25.py`.
-/

namespace Skips

open Matrix
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {σ : ℝ → ℝ} {χ : Matrix T d ℝ → Matrix T d ℝ} {hid : Fin L → Type}
  [∀ ℓ, Fintype (hid ℓ)]

/-- **The direction of the rescalings of the hidden units of MLP blocks with biases:**
`rescaleDirMlp k θ α` on the weights (read column of the unit `i` of block `ℓ` times `α_i`, write
row times `−k α_i`), and the read bias of the unit times `α_i`. -/
def rescaleDirMlpB (k : ℕ) (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (α : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDirMlp k p.1 α,
    { E := 0
      read := fun ℓ i => α ℓ i * p.2.read ℓ i
      write := fun _ => 0
      D := 0 })

/-- **The direction of the rescalings of the values of gated units with biases:**
`rescaleDir θ α` on the weights (value column of the unit `i` of block `ℓ` times `−α_i`, write
row times `α_i`), and the value bias of the unit times `−α_i`. -/
def rescaleDirB (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (α : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDir p.1 α,
    { E := 0
      read := fun ℓ => Sum.elim (fun _ => 0) (fun i => -(α ℓ i) * p.2.read ℓ (Sum.inr i))
      write := fun _ => 0
      D := 0 })

/-- **The direction of the rescalings of the gates of gated units with biases:**
`rescaleDirGate k θ β` on the weights (gate column of the unit `i` of block `ℓ` times `β_i`, write
row times `−k β_i`), and the gate bias of the unit times `β_i`. -/
def rescaleDirGateB (k : ℕ) (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (β : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDirGate k p.1 β,
    { E := 0
      read := fun ℓ => Sum.elim (fun i => β ℓ i * p.2.read ℓ (Sum.inl i)) (fun _ => 0)
      write := fun _ => 0
      D := 0 })

/-- **The rescalings of the hidden units of MLP blocks with biases are symmetries inside the
blocks,** for an activation that is positively homogeneous of degree `k`. -/
theorem insideBlocksB_rescaleDirMlpB {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    InsideBlocksB (Arch.mlp σ χ hid) p (rescaleDirMlpB k p α) := by
  sorry

/-- **The rescalings of the values of gated units with biases are symmetries inside the
blocks,** for every gate activation. -/
theorem insideBlocksB_rescaleDirB
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    InsideBlocksB (Arch.gated σ χ hid) p (rescaleDirB p α) := by
  sorry

/-- **The rescalings of the gates of gated units with biases are symmetries inside the blocks,**
for a gate activation that is positively homogeneous of degree `k`. -/
theorem insideBlocksB_rescaleDirGateB {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) (β : ∀ ℓ, hid ℓ → ℝ) :
    InsideBlocksB (Arch.gated σ χ hid) p (rescaleDirGateB k p β) := by
  sorry

/-- **Lemma A.8, the count with identity skips, for MLP blocks with a positively homogeneous
activation** (ReLU, ReLU²) **with biases:** if `E` has rank `d` and no column of a read vanishes,
`fd ≤ P − d² − (L + 1) d − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_residual_mlp_rescale {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    funDimB (Arch.mlp σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

/-- **Lemma A.8, the count without skips, for MLP blocks with a positively homogeneous
activation with biases:** if `E` and the writes have rank `d` and no column of a read vanishes,
`fd ≤ P − (L + 1)(d² + d) − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_skipless_mlp_rescale {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    funDimB (Arch.mlp σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

/-- **Lemma A.8, the count with identity skips, for gated blocks with biases** (SwiGLU, GeGLU;
any gate activation): if `E` has rank `d` and no value column vanishes,
`fd ≤ P − d² − (L + 1) d − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_residual_gated
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

/-- **Lemma A.8, the count without skips, for gated blocks with biases:** if `E` and the writes
have rank `d` and no value column vanishes, `fd ≤ P − (L + 1)(d² + d) − s`, where `s` is the
number of hidden units. -/
theorem funDimB_add_le_skipless_gated
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

/-- **Lemma A.8, the count with identity skips, for gated blocks with a positively homogeneous
gate** (ReGLU) **with biases:** if `E` has rank `d` and no gate column and no value column
vanishes, `fd ≤ P − d² − (L + 1) d − s`, where `s` is twice the number of hidden units. -/
theorem funDimB_add_le_residual_gated_gate {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + 2 * ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

/-- **Lemma A.8, the count without skips, for gated blocks with a positively homogeneous gate
with biases:** if `E` and the writes have rank `d` and no gate column and no value column
vanishes, `fd ≤ P − (L + 1)(d² + d) − s`, where `s` is twice the number of hidden units. -/
theorem funDimB_add_le_skipless_gated_gate {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + 2 * ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  sorry

end Skips
