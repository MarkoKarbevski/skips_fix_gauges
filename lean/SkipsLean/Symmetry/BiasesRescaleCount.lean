/-- **The rescalings of the hidden units of MLP blocks with biases are symmetries inside the
blocks,** for an activation that is positively homogeneous of degree `k`. -/
theorem insideBlocksB_rescaleDirMlpB {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    InsideBlocksB (Arch.mlp σ χ hid) p (rescaleDirMlpB k p α) := by
  -- the curve of the rescalings `c_i = e^{τ α_i}` of the weights and the biases
  refine ⟨fun τ => (p.1.rescaleMlp k (fun ℓ i => Real.exp (τ * α ℓ i)),
      p.2.rescaleMlp (fun ℓ i => Real.exp (τ * α ℓ i))), ?_,
    (hasDerivAt_rescaleMlp_brc k p.1 α).prodMk (hasDerivAt_biasesRescaleMlp_brc p.2 α),
    Filter.Eventually.of_forall fun τ => ⟨rfl, rfl, rfl, rfl, fun ℓ n =>
      block_rescaleMlp_brc hσ p.1 p.2 _ (fun _ _ => Real.exp_pos _) ℓ n⟩⟩
  -- at `τ = 0` every `c_i` is `1`
  refine Prod.ext (Params.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl)
    (Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => rfl) rfl)
  · ext a i
    simp [Params.rescaleMlp]
  · ext i a
    simp [Params.rescaleMlp]
  · funext i
    simp [Biases.rescaleMlp]

