/-- **The rescalings of the values of gated units with biases are symmetries inside the
blocks,** for every gate activation. -/
theorem insideBlocksB_rescaleDirB
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    InsideBlocksB (Arch.gated σ χ hid) p (rescaleDirB p α) := by
  -- the curve of the rescalings `c_i = e^{τ α_i}` of the values and their biases
  refine ⟨fun τ => (p.1.rescale (fun ℓ i => Real.exp (τ * α ℓ i)),
      p.2.rescale (fun ℓ i => Real.exp (τ * α ℓ i))), ?_,
    (hasDerivAt_rescale_brc p.1 α).prodMk (hasDerivAt_biasesRescale_brc p.2 α),
    Filter.Eventually.of_forall fun τ => ⟨rfl, rfl, rfl, rfl, fun ℓ n =>
      block_rescale_brc p.1 p.2 _ (fun _ _ => (Real.exp_pos _).ne') ℓ n⟩⟩
  -- at `τ = 0` every `c_i` is `1`
  refine Prod.ext (Params.ext' rfl (fun ℓ => ?_) (fun ℓ => ?_) rfl)
    (Biases.ext' rfl (fun ℓ => ?_) (fun ℓ => rfl) rfl)
  · ext a j
    cases j <;> simp [Params.rescale]
  · ext i a
    simp [Params.rescale]
  · funext j
    cases j <;> simp [Biases.rescale]

