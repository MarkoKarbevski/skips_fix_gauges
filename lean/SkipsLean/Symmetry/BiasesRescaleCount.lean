/-- Helper: if the read of block `ℓ` of `rescaleDirMlp k θ α` is `0` and no read column
vanishes, then `α_ℓ = 0`. -/
private theorem alpha_eq_zero_mlp_brc (k : ℕ)
    (θ : Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (hc : ∀ ℓ i, (fun a => θ.read ℓ a i) ≠ 0) (α : ∀ ℓ, hid ℓ → ℝ) (ℓ : Fin L)
    (h : (rescaleDirMlp k θ α).read ℓ = 0) : α ℓ = 0 :=
  -- the read column of unit `i` moves by `α_i c_i`
  eq_zero_of_mul_col_brc (fun i a => θ.read ℓ a i) (α ℓ) (hc ℓ)
    fun a i => congrFun (congrFun h a) i

