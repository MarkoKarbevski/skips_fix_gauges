    (b : Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    HasDerivAt (fun τ : ℝ => b.rescale (fun ℓ i => Real.exp (τ * α ℓ i)))
      ({ E := 0
         read := fun ℓ => Sum.elim (fun _ => 0) (fun i => -(α ℓ i) * b.read ℓ (Sum.inr i))
         write := fun _ => 0
         D := 0 } : Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut) 0 := by
  have hprod : HasDerivAt
      (fun τ : ℝ => Biases.linearEquivProd (b.rescale (fun ℓ i => Real.exp (τ * α ℓ i))))
      (Biases.linearEquivProd (A := Arch.gated (T := T) (d := d) σ χ hid) (dOut := dOut)
        { E := 0
          read := fun ℓ => Sum.elim (fun _ => 0) (fun i => -(α ℓ i) * b.read ℓ (Sum.inr i))
          write := fun _ => 0
          D := 0 }) 0 := by
    refine HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ ?_))
    · exact hasDerivAt_const (0 : ℝ) b.E
    · -- the gate biases do not move; the value biases are `(e^{τ α})⁻¹ β'`
      refine hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun j => ?_
