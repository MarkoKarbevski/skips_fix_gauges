/-- Helper: if the read of block `ℓ` of `rescaleDir θ α` is `0` and no value column vanishes,
then `α_ℓ = 0`. -/
private theorem alpha_eq_zero_gated_brc
    (θ : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => θ.read ℓ a (Sum.inr i)) ≠ 0) (α : ∀ ℓ, hid ℓ → ℝ) (ℓ : Fin L)
    (h : (rescaleDir θ α).read ℓ = 0) : α ℓ = 0 := by
  -- the value column of unit `i` moves by `-α_i e_i`
  have h1 := eq_zero_of_mul_col_brc (fun i a => θ.read ℓ a (Sum.inr i)) (fun i => -(α ℓ i))
    (hv ℓ) fun a i => congrFun (congrFun h a) (Sum.inr i)
  exact funext fun i => neg_eq_zero.1 (congrFun h1 i)

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: if the read of block `ℓ` of `rescaleDir θ α + rescaleDirGate k θ β` is `0` and no
gate column and no value column vanishes, then `α_ℓ = 0` and `β_ℓ = 0`. -/
private theorem alphaBeta_eq_zero_brc (k : ℕ)
    (θ : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => θ.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => θ.read ℓ a (Sum.inl i)) ≠ 0) (α β : ∀ ℓ, hid ℓ → ℝ) (ℓ : Fin L)
    (h : (rescaleDir θ α + rescaleDirGate k θ β).read ℓ = 0) : α ℓ = 0 ∧ β ℓ = 0 := by
  -- the value column of unit `i` moves by `-α_i e_i`, its gate column by `β_i c_i`
  have hα := eq_zero_of_mul_col_brc (fun i a => θ.read ℓ a (Sum.inr i)) (fun i => -(α ℓ i))
    (hv ℓ) fun a i => by
      have h1 : -(α ℓ i) * θ.read ℓ a (Sum.inr i) + 0 = 0 := congrFun (congrFun h a) (Sum.inr i)
      rwa [add_zero] at h1
  have hβ := eq_zero_of_mul_col_brc (fun i a => θ.read ℓ a (Sum.inl i)) (β ℓ) (hg ℓ)
    fun a i => by
      have h1 : 0 + β ℓ i * θ.read ℓ a (Sum.inl i) = 0 := congrFun (congrFun h a) (Sum.inl i)
      rwa [zero_add] at h1
  exact ⟨funext fun i => neg_eq_zero.1 (congrFun hα i), hβ⟩

/-! ### Helpers: the spaces `V` of the rescalings satisfy the conditions of
`Symmetry/InsideBlocksBiases.lean` -/

omit [Fintype T] [DecidableEq d] in
/-- Helper: the directions of the rescalings of the hidden units of MLP blocks are spanned by
directions of symmetries inside the blocks. -/
private theorem range_le_span_mlp_brc {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut) :
    LinearMap.range (rescaleDirMlpBLin_brc k p)
      ≤ Submodule.span ℝ {η | InsideBlocksB (Arch.mlp σ χ hid) p η} := by
  rintro _ ⟨α, rfl⟩
  exact Submodule.subset_span (insideBlocksB_rescaleDirMlpB hσ p α)

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: a direction of the rescalings of MLP blocks whose read of block `ℓ` is `0` has
`α_ℓ = 0`, so its write and write bias of block `ℓ` are `0`. -/
private theorem hrw_mlp_brc (k : ℕ) (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    ∀ η ∈ LinearMap.range (rescaleDirMlpBLin_brc k p), ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 →
      η.1.write ℓ = 0 ∧ η.2.write ℓ = 0 := by
  rintro _ ⟨α, rfl⟩ ℓ hr -
  have hα := alpha_eq_zero_mlp_brc k p.1 hc α ℓ hr
  refine ⟨?_, rfl⟩
  -- the write row of unit `i` moves by `-k α_i a_i = 0`
  ext i a
  show -((k : ℝ) * α ℓ i) * p.1.write ℓ i a = 0
  rw [show α ℓ i = 0 from congrFun hα i]
  ring

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: `α ↦ rescaleDirMlpB k p α` is injective when no read column vanishes. -/
private theorem injective_mlp_brc (k : ℕ)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    Function.Injective (rescaleDirMlpBLin_brc k p) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro α h
  funext ℓ
  exact alpha_eq_zero_mlp_brc k p.1 hc α ℓ
    (congrArg (fun q : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut => q.1.read ℓ) h)

omit [Fintype T] [DecidableEq d] in
/-- Helper: the directions of the rescalings of the values of gated blocks are spanned by
directions of symmetries inside the blocks. -/
private theorem range_le_span_gated_brc
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) :
    LinearMap.range (rescaleDirBLin_brc p)
      ≤ Submodule.span ℝ {η | InsideBlocksB (Arch.gated σ χ hid) p η} := by
  rintro _ ⟨α, rfl⟩
  exact Submodule.subset_span (insideBlocksB_rescaleDirB p α)

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: a direction of the rescalings of the values whose read of block `ℓ` is `0` has
`α_ℓ = 0`, so its write and write bias of block `ℓ` are `0`. -/
private theorem hrw_gated_brc (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    ∀ η ∈ LinearMap.range (rescaleDirBLin_brc p), ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 →
      η.1.write ℓ = 0 ∧ η.2.write ℓ = 0 := by
  rintro _ ⟨α, rfl⟩ ℓ hr -
  have hα := alpha_eq_zero_gated_brc p.1 hv α ℓ hr
  refine ⟨?_, rfl⟩
  -- the write row of unit `i` moves by `α_i a_i = 0`
  ext i a
  show α ℓ i * p.1.write ℓ i a = 0
  rw [show α ℓ i = 0 from congrFun hα i]
  ring

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: `α ↦ rescaleDirB p α` is injective when no value column vanishes. -/
private theorem injective_gated_brc
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    Function.Injective (rescaleDirBLin_brc p) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro α h
  funext ℓ
  exact alpha_eq_zero_gated_brc p.1 hv α ℓ
    (congrArg (fun q : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut => q.1.read ℓ) h)

omit [Fintype T] [DecidableEq d] in
/-- Helper: the directions of the rescalings of the values and of the gates are spanned by
directions of symmetries inside the blocks. -/
private theorem range_le_span_gatedGate_brc {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) :
    LinearMap.range ((rescaleDirBLin_brc p).coprod (rescaleDirGateBLin_brc k p))
      ≤ Submodule.span ℝ {η | InsideBlocksB (Arch.gated σ χ hid) p η} := by
  rintro _ ⟨⟨α, β⟩, rfl⟩
  rw [LinearMap.coprod_apply]
  exact add_mem (Submodule.subset_span (insideBlocksB_rescaleDirB p α))
    (Submodule.subset_span (insideBlocksB_rescaleDirGateB hσ p β))

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: a direction of the rescalings of the values and of the gates whose read of block `ℓ`
is `0` has `α_ℓ = β_ℓ = 0`, so its write and write bias of block `ℓ` are `0`. -/
private theorem hrw_gatedGate_brc (k : ℕ)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    ∀ η ∈ LinearMap.range ((rescaleDirBLin_brc p).coprod (rescaleDirGateBLin_brc k p)), ∀ ℓ,
      η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0 := by
  rintro _ ⟨⟨α, β⟩, rfl⟩ ℓ hr -
  obtain ⟨hα, hβ⟩ := alphaBeta_eq_zero_brc k p.1 hv hg α β ℓ hr
  refine ⟨?_, add_zero (0 : d → ℝ)⟩
  -- the write row of unit `i` moves by `α_i a_i - k β_i a_i = 0`
  ext i a
  show α ℓ i * p.1.write ℓ i a + -((k : ℝ) * β ℓ i) * p.1.write ℓ i a = 0
  rw [show α ℓ i = 0 from congrFun hα i, show β ℓ i = 0 from congrFun hβ i]
  ring

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: `(α, β) ↦ rescaleDirB p α + rescaleDirGateB k p β` is injective when no gate column
and no value column vanishes. -/
private theorem injective_gatedGate_brc (k : ℕ)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    Function.Injective ((rescaleDirBLin_brc p).coprod (rescaleDirGateBLin_brc k p)) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  rintro ⟨α, β⟩ h
  have hab := fun ℓ => alphaBeta_eq_zero_brc k p.1 hv hg α β ℓ
    (congrArg (fun q : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut => q.1.read ℓ) h)
  exact Prod.ext (funext fun ℓ => (hab ℓ).1) (funext fun ℓ => (hab ℓ).2)

/-- **Lemma A.8, the count with identity skips, for MLP blocks with a positively homogeneous
activation** (ReLU, ReLU²) **with biases:** if `E` has rank `d` and no column of a read vanishes,
`fd ≤ P − d² − (L + 1) d − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_residual_mlp_rescale {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    funDimB (Arch.mlp σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings, of dimension `s` (`α ↦` direction is injective)
  have h := funDimB_add_le_residual_of_insideBlocksB p rfl
    (LinearMap.range (rescaleDirMlpBLin_brc k p)) (range_le_span_mlp_brc hσ p)
    (hrw_mlp_brc k p hc) hE
  rwa [LinearMap.finrank_range_of_inj (injective_mlp_brc k p hc), finrank_hidFun_brc] at h

/-- **Lemma A.8, the count without skips, for MLP blocks with a positively homogeneous
activation with biases:** if `E` and the writes have rank `d` and no column of a read vanishes,
`fd ≤ P − (L + 1)(d² + d) − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_skipless_mlp_rescale {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hc : ∀ ℓ i, (fun a => p.1.read ℓ a i) ≠ 0) :
    funDimB (Arch.mlp σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings, of dimension `s` (`α ↦` direction is injective)
  have h := funDimB_add_le_skipless_of_insideBlocksB p rfl
    (LinearMap.range (rescaleDirMlpBLin_brc k p)) (range_le_span_mlp_brc hσ p)
    (hrw_mlp_brc k p hc) hE hw
  rwa [LinearMap.finrank_range_of_inj (injective_mlp_brc k p hc), finrank_hidFun_brc] at h

/-- **Lemma A.8, the count with identity skips, for gated blocks with biases** (SwiGLU, GeGLU;
any gate activation): if `E` has rank `d` and no value column vanishes,
`fd ≤ P − d² − (L + 1) d − s`, where `s` is the number of hidden units. -/
theorem funDimB_add_le_residual_gated
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings of the values, of dimension `s`
  have h := funDimB_add_le_residual_of_insideBlocksB p rfl
    (LinearMap.range (rescaleDirBLin_brc p)) (range_le_span_gated_brc p) (hrw_gated_brc p hv) hE
  rwa [LinearMap.finrank_range_of_inj (injective_gated_brc p hv), finrank_hidFun_brc] at h

/-- **Lemma A.8, the count without skips, for gated blocks with biases:** if `E` and the writes
have rank `d` and no value column vanishes, `fd ≤ P − (L + 1)(d² + d) − s`, where `s` is the
number of hidden units. -/
theorem funDimB_add_le_skipless_gated
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings of the values, of dimension `s`
  have h := funDimB_add_le_skipless_of_insideBlocksB p rfl
    (LinearMap.range (rescaleDirBLin_brc p)) (range_le_span_gated_brc p) (hrw_gated_brc p hv)
    hE hw
  rwa [LinearMap.finrank_range_of_inj (injective_gated_brc p hv), finrank_hidFun_brc] at h

/-- **Lemma A.8, the count with identity skips, for gated blocks with a positively homogeneous
gate** (ReGLU) **with biases:** if `E` has rank `d` and no gate column and no value column
vanishes, `fd ≤ P − d² − (L + 1) d − s`, where `s` is twice the number of hidden units. -/
theorem funDimB_add_le_residual_gated_gate {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + 2 * ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings of the values and of the gates, of dimension `2 s`
  have h := funDimB_add_le_residual_of_insideBlocksB p rfl
    (LinearMap.range ((rescaleDirBLin_brc p).coprod (rescaleDirGateBLin_brc k p)))
    (range_le_span_gatedGate_brc hσ p) (hrw_gatedGate_brc k p hv hg) hE
  rwa [LinearMap.finrank_range_of_inj (injective_gatedGate_brc k p hv hg), Module.finrank_prod,
    finrank_hidFun_brc, ← two_mul] at h

/-- **Lemma A.8, the count without skips, for gated blocks with a positively homogeneous gate
with biases:** if `E` and the writes have rank `d` and no gate column and no value column
vanishes, `fd ≤ P − (L + 1)(d² + d) − s`, where `s` is twice the number of hidden units. -/
theorem funDimB_add_le_skipless_gated_gate {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (p : ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hv : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inr i)) ≠ 0)
    (hg : ∀ ℓ i, (fun a => p.1.read ℓ a (Sum.inl i)) ≠ 0) :
    funDimB (Arch.gated σ id hid) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + 2 * ∑ ℓ, Fintype.card (hid ℓ))
      ≤ Module.finrank ℝ (ParamsB (Arch.gated (T := T) (d := d) σ id hid) dIn dOut) := by
  -- `V`: the directions of the rescalings of the values and of the gates, of dimension `2 s`
  have h := funDimB_add_le_skipless_of_insideBlocksB p rfl
    (LinearMap.range ((rescaleDirBLin_brc p).coprod (rescaleDirGateBLin_brc k p)))
    (range_le_span_gatedGate_brc hσ p) (hrw_gatedGate_brc k p hv hg) hE hw
  rwa [LinearMap.finrank_range_of_inj (injective_gatedGate_brc k p hv hg), Module.finrank_prod,
    finrank_hidFun_brc, ← two_mul] at h

