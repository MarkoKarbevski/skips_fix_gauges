/-- Helper: if `a_i` times the column `R_i` is `0` for every `i`, and no column `R_i` is `0`,
then `a = 0`. -/
private theorem eq_zero_of_mul_col_brc {m n : Type*} (R : n → m → ℝ) (a : n → ℝ)
    (hc : ∀ i, R i ≠ 0) (h : ∀ x i, a i * R i x = 0) : a = 0 := by
  funext i
  -- an entry `x` of the column `R_i` that is not `0`
  obtain ⟨x, hx⟩ := Function.ne_iff.mp (hc i)
  exact (mul_eq_zero.1 (h x i)).resolve_right hx

