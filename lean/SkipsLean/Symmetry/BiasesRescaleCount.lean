/-- Helper: the rescaled values of a gated block with biases give the same map of the block:
unit `i` contributes `σ(g_i) (v_i / c_i) (c_i a_i) = σ(g_i) v_i a_i`. -/
private theorem block_rescale_brc
    (θ : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (b : Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut) (c : ∀ ℓ, hid ℓ → ℝ)
    (hc : ∀ ℓ i, c ℓ i ≠ 0) (ℓ : Fin L) (n : Matrix T d ℝ) :
    (Arch.gated σ χ hid).f ℓ (n * (θ.rescale c).read ℓ
          + Matrix.of fun _ => (b.rescale c).read ℓ) * (θ.rescale c).write ℓ
        + Matrix.of (fun _ => (b.rescale c).write ℓ)
      = (Arch.gated σ χ hid).f ℓ (n * θ.read ℓ + Matrix.of fun _ => b.read ℓ) * θ.write ℓ
        + Matrix.of fun _ => b.write ℓ := by
  -- the write bias is the same; compare `f(P) W` entry by entry
  congr 1
  ext t a
  rw [Matrix.mul_apply, Matrix.mul_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  show σ ((n * (θ.rescale c).read ℓ + Matrix.of fun _ => (b.rescale c).read ℓ :
          Matrix T (hid ℓ ⊕ hid ℓ) ℝ) t (Sum.inl i))
      * (n * (θ.rescale c).read ℓ + Matrix.of fun _ => (b.rescale c).read ℓ :
          Matrix T (hid ℓ ⊕ hid ℓ) ℝ) t (Sum.inr i)
      * (θ.rescale c).write ℓ i a
    = σ ((n * θ.read ℓ + Matrix.of fun _ => b.read ℓ : Matrix T (hid ℓ ⊕ hid ℓ) ℝ) t
          (Sum.inl i))
      * (n * θ.read ℓ + Matrix.of fun _ => b.read ℓ : Matrix T (hid ℓ ⊕ hid ℓ) ℝ) t
          (Sum.inr i)
      * θ.write ℓ i a
  rw [gate_rescale_brc, value_rescale_brc]
  simp only [Params.rescale, Matrix.of_apply]
  field_simp [hc ℓ i]

