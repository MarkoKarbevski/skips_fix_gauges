import SkipsLean.Symmetry.InsideBlocksBiases
import SkipsLean.Symmetry.BiasesRescale
import SkipsLean.Dimension.RescalingMlp
import SkipsLean.Dimension.Rescaling
import SkipsLean.Dimension.RescalingGate

/-!
# The count of Lemma A.8 with `s`, for ReLU-type blocks and gated blocks with biases

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips". Appendix
B, Step 3: "A rescaling of the units by numbers `λ_i` is also a direction in parameter space: it
scales column `i` of `W_read` and entry `i` of `b_read` by `λ_i` and row `i` of `W_write` by
`−λ_i` for ReLU, by `−2 λ_i` for ReLU², and similarly for ReGLU and for the values of SwiGLU and
GeGLU"; "`s` is the number of rescalings: `d_hidden` for ReLU, ReLU², SwiGLU and GeGLU,
`2 d_hidden` for ReGLU, none for tanh and GELU."

Here, for the networks with biases of `Network/Biases.lean`:

* `rescaleDirMlpB`, `rescaleDirB`, `rescaleDirGateB`: the directions of the rescalings of the
  hidden units of MLP blocks with a positively homogeneous activation, of the values of gated
  units, and of the gates of gated units with a positively homogeneous gate, with the read bias
  of the unit moved as its read column is (`rescaleDirMlp`, `rescaleDir`, `rescaleDirGate` on the
  weights).
* They are directions of symmetries inside the blocks (`InsideBlocksB`), hence flat with skips
  and without them, for every `χ`.
* The count of Lemma A.8 as bounds on the functional dimension, without normalization:
  `fd ≤ P − d² − (L + 1) d − s` with identity skips and `fd ≤ P − (L + 1)(d² + d) − s` without
  skips, with `s = ∑_ℓ d_hidden,ℓ` for ReLU and ReLU² blocks (no read column vanishes) and for the
  values of gated blocks (no value column vanishes), and `s = 2 ∑_ℓ d_hidden,ℓ` for ReGLU blocks
  (no gate column and no value column vanishes). For tanh and GELU blocks (`s = 0`) the bounds
  are `funDimB_add_le_residual` and `funDimB_add_le_skipless` (`Symmetry/BiasesFlat.lean`).

Numeric check: `ai_notes/biases_inside_blocks_check_2026-11-25.py`.
-/

namespace Skips

open Matrix
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {σ : ℝ → ℝ} {χ : Matrix T d ℝ → Matrix T d ℝ} {hid : Fin L → Type}
  [∀ ℓ, Fintype (hid ℓ)]

/-- **The direction of the rescalings of the hidden units of MLP blocks with biases:**
`rescaleDirMlp k θ α` on the weights (read column of the unit `i` of block `ℓ` times `α_i`, write
row times `−k α_i`), and the read bias of the unit times `α_i`. -/
def rescaleDirMlpB (k : ℕ) (p : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)
    (α : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDirMlp k p.1 α,
    { E := 0
      read := fun ℓ i => α ℓ i * p.2.read ℓ i
      write := fun _ => 0
      D := 0 })

/-- **The direction of the rescalings of the values of gated units with biases:**
`rescaleDir θ α` on the weights (value column of the unit `i` of block `ℓ` times `−α_i`, write
row times `α_i`), and the value bias of the unit times `−α_i`. -/
def rescaleDirB (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (α : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDir p.1 α,
    { E := 0
      read := fun ℓ => Sum.elim (fun _ => 0) (fun i => -(α ℓ i) * p.2.read ℓ (Sum.inr i))
      write := fun _ => 0
      D := 0 })

/-- **The direction of the rescalings of the gates of gated units with biases:**
`rescaleDirGate k θ β` on the weights (gate column of the unit `i` of block `ℓ` times `β_i`, write
row times `−k β_i`), and the gate bias of the unit times `β_i`. -/
def rescaleDirGateB (k : ℕ) (p : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut)
    (β : ∀ ℓ, hid ℓ → ℝ) : ParamsB (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut :=
  (rescaleDirGate k p.1 β,
    { E := 0
      read := fun ℓ => Sum.elim (fun i => β ℓ i * p.2.read ℓ (Sum.inl i)) (fun _ => 0)
      write := fun _ => 0
      D := 0 })

/-! ### Helpers: the curves of the rescalings and their velocities -/

/-- Helper: `τ ↦ e^{τ a} b` has derivative `a b` at `τ = 0`. -/
private theorem hasDerivAt_exp_mul_const_brc (a b : ℝ) :
    HasDerivAt (fun τ : ℝ => Real.exp (τ * a) * b) (a * b) 0 := by
  have h := ((hasDerivAt_id (0 : ℝ)).mul_const a).exp.mul_const b
  simpa using h

/-- Helper: `τ ↦ (e^{τ a})⁻¹ b` has derivative `-a b` at `τ = 0`. -/
private theorem hasDerivAt_exp_inv_mul_const_brc (a b : ℝ) :
    HasDerivAt (fun τ : ℝ => (Real.exp (τ * a))⁻¹ * b) (-a * b) 0 := by
  -- `(e^{τ a})⁻¹ = e^{τ (-a)}`
  have h : (fun τ : ℝ => (Real.exp (τ * a))⁻¹ * b) = fun τ => Real.exp (τ * -a) * b := by
    funext τ
    rw [show τ * -a = -(τ * a) by ring, Real.exp_neg]
  rw [h]
  exact hasDerivAt_exp_mul_const_brc (-a) b

/-- Helper: `τ ↦ ((e^{τ a})^k)⁻¹ b` has derivative `-k a b` at `τ = 0`. -/
private theorem hasDerivAt_exp_pow_inv_mul_const_brc (k : ℕ) (a b : ℝ) :
    HasDerivAt (fun τ : ℝ => (Real.exp (τ * a) ^ k)⁻¹ * b) (-((k : ℝ) * a) * b) 0 := by
  -- `((e^{τ a})^k)⁻¹ = e^{τ (-k a)}`
  have h : (fun τ : ℝ => (Real.exp (τ * a) ^ k)⁻¹ * b)
      = fun τ => Real.exp (τ * -((k : ℝ) * a)) * b := by
    funext τ
    rw [show τ * -((k : ℝ) * a) = -((k : ℝ) * (τ * a)) by ring, Real.exp_neg, Real.exp_nat_mul]
  rw [h]
  exact hasDerivAt_exp_mul_const_brc _ b

omit [Fintype T] [DecidableEq d] in
/-- Helper: the rescaling of the hidden units by `c_i = e^{τ α_i}` has velocity
`rescaleDirMlp k θ α` at `τ = 0`, computed entry by entry through `Params.linearEquivProd`. -/
private theorem hasDerivAt_rescaleMlp_brc (k : ℕ)
    (θ : Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    HasDerivAt (fun τ : ℝ => θ.rescaleMlp k (fun ℓ i => Real.exp (τ * α ℓ i)))
      (rescaleDirMlp k θ α) 0 := by
  have hprod : HasDerivAt
      (fun τ : ℝ => Params.linearEquivProd (θ.rescaleMlp k (fun ℓ i => Real.exp (τ * α ℓ i))))
      (Params.linearEquivProd (rescaleDirMlp k θ α)) 0 := by
    refine HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ ?_))
    · -- the embedding does not move
      exact hasDerivAt_const (0 : ℝ) θ.E
    · -- the read entries are `e^{τ α} c`
      exact hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun a => hasDerivAt_pi.2 fun i =>
        hasDerivAt_exp_mul_const_brc (α ℓ i) (θ.read ℓ a i)
    · -- the write entries are `(e^{τ α})^{-k} a`
      exact hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun i => hasDerivAt_pi.2 fun a =>
        hasDerivAt_exp_pow_inv_mul_const_brc k (α ℓ i) (θ.write ℓ i a)
    · -- the readout does not move
      exact hasDerivAt_const (0 : ℝ) θ.D
  -- back from the tuples of components to the parameters
  exact (LinearMap.toContinuousLinearMap
    (Params.linearEquivProd (A := Arch.mlp (T := T) (d := d) σ χ hid) (dIn := dIn)
      (dOut := dOut)).symm.toLinearMap).hasFDerivAt.comp_hasDerivAt 0 hprod

omit [Fintype T] [DecidableEq d] in
/-- Helper: the biases after the rescaling by `c_i = e^{τ α_i}` have velocity
`(0, α_i b_read^ℓ_i, 0, 0)` at `τ = 0`, computed through `Biases.linearEquivProd`. -/
private theorem hasDerivAt_biasesRescaleMlp_brc
    (b : Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    HasDerivAt (fun τ : ℝ => b.rescaleMlp (fun ℓ i => Real.exp (τ * α ℓ i)))
      ({ E := 0
         read := fun ℓ i => α ℓ i * b.read ℓ i
         write := fun _ => 0
         D := 0 } : Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut) 0 := by
  have hprod : HasDerivAt
      (fun τ : ℝ => Biases.linearEquivProd (b.rescaleMlp (fun ℓ i => Real.exp (τ * α ℓ i))))
      (Biases.linearEquivProd (A := Arch.mlp (T := T) (d := d) σ χ hid) (dOut := dOut)
        { E := 0
          read := fun ℓ i => α ℓ i * b.read ℓ i
          write := fun _ => 0
          D := 0 }) 0 := by
    refine HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ ?_))
    · exact hasDerivAt_const (0 : ℝ) b.E
    · -- the read biases are `e^{τ α} β`
      exact hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun i =>
        hasDerivAt_exp_mul_const_brc (α ℓ i) (b.read ℓ i)
    · exact hasDerivAt_const (0 : ℝ) b.write
    · exact hasDerivAt_const (0 : ℝ) b.D
  exact (LinearMap.toContinuousLinearMap
    (Biases.linearEquivProd (A := Arch.mlp (T := T) (d := d) σ χ hid)
      (dOut := dOut)).symm.toLinearMap).hasFDerivAt.comp_hasDerivAt 0 hprod

omit [Fintype T] [DecidableEq d] in
/-- Helper: the rescaling of the values by `c_i = e^{τ α_i}` has velocity `rescaleDir θ α` at
`τ = 0`. -/
private theorem hasDerivAt_rescale_brc
    (θ : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut) (α : ∀ ℓ, hid ℓ → ℝ) :
    HasDerivAt (fun τ : ℝ => θ.rescale (fun ℓ i => Real.exp (τ * α ℓ i))) (rescaleDir θ α) 0 := by
  have hprod : HasDerivAt
      (fun τ : ℝ => Params.linearEquivProd (θ.rescale (fun ℓ i => Real.exp (τ * α ℓ i))))
      (Params.linearEquivProd (rescaleDir θ α)) 0 := by
    refine HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ (HasDerivAt.prodMk ?_ ?_))
    · exact hasDerivAt_const (0 : ℝ) θ.E
    · -- the gate entries do not move; the value entries are `(e^{τ α})⁻¹ w`
      refine hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun a => hasDerivAt_pi.2 fun j => ?_
      cases j with
      | inl i => exact hasDerivAt_const (0 : ℝ) (θ.read ℓ a (Sum.inl i))
      | inr i => exact hasDerivAt_exp_inv_mul_const_brc (α ℓ i) (θ.read ℓ a (Sum.inr i))
    · -- the write entries are `e^{τ α} a`
      exact hasDerivAt_pi.2 fun ℓ => hasDerivAt_pi.2 fun i => hasDerivAt_pi.2 fun a =>
        hasDerivAt_exp_mul_const_brc (α ℓ i) (θ.write ℓ i a)
    · exact hasDerivAt_const (0 : ℝ) θ.D
  exact (LinearMap.toContinuousLinearMap
    (Params.linearEquivProd (A := Arch.gated (T := T) (d := d) σ χ hid) (dIn := dIn)
      (dOut := dOut)).symm.toLinearMap).hasFDerivAt.comp_hasDerivAt 0 hprod

