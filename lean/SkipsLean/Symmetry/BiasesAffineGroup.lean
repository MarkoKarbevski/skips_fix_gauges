import SkipsLean.Symmetry.CobGroup
import SkipsLean.Symmetry.BiasesSymmetries

/-!
# The group of the changes of basis and translations of a network with biases

Paper (skips paper), Lemma A.8 (Translations are not tied): "In a residual network with biases
and without normalization, adding a row `g` to the hidden states `h_ℓ, …, h_L` preserves the
function once the biases are adjusted, for every `ℓ = 0, …, L`. The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and
the skips remove `L d_model²` dimensions, as without biases." Its proof: "These `L + 1`
translations move the biases in independent directions, as many as in a skipless network, where
each hidden state has its own translation (Proposition A.1(ii)). A skip ties only the linear part
of `Aff(d_model)`, which gives the counts."

`Symmetry/BiasesSymmetryCount.lean` has the count with `s` as the dimension of the space of the
directions of the symmetries at one parameter. Here the group of the changes of basis and
translations as a set, as `Symmetry/CobGroup.lean` does for Theorem 3.3 (ii) without biases:

* the `L + 1` translations together: `Biases.translateAll` for a residual network (the hidden
  state `h_m` moves by `g_0 + … + g_m`) and `Biases.translateAllAt` for a skipless network (`h_m`
  moves by `g_m`); both preserve the function;
* `affPreservingSkipless`, `affPreservingResidual`: the pairs of a family `G_0, …, G_L` of
  invertible matrices and a family `g_0, …, g_L` of rows such that the translations by `g`
  followed by the changes of basis `G` preserve the function at all weights and biases;
* without normalization, for any blocks: in a skipless network every pair passes; in a residual
  network exactly the pairs with all `G_ℓ` equal ("A skip ties only the linear part of
  `Aff(d_model)`"): with biases this needs no hypothesis on the blocks (networks whose writes are
  zero and whose write biases are free decide it);
* the Hausdorff dimensions of the two sets, as sets of matrices and rows: `(L + 1)(d² + d)` and
  `d² + (L + 1) d`, and their difference `L d²`.

The symmetries inside the blocks (the `s` of the lemma) are not part of these sets; the count
with them is the statement on directions.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A : Arch T d L}

/-- **The biases after the translation of every hidden state `h_k` of a skipless network by the
row `g_k`.** -/
def Biases.translateAllAt (b : Biases A dOut) (θ : Params A dIn dOut)
    (g : Fin (L + 1) → d → ℝ) : Biases A dOut where
  E := b.E + g 0
  read ℓ := b.read ℓ - g ℓ.castSucc ᵥ* θ.read ℓ
  write ℓ := b.write ℓ + g ℓ.succ
  D := b.D - g (Fin.last L) ᵥ* θ.D

/-- **The biases after the `L + 1` translations of Lemma A.8 of a residual network:** the row
`g_k` is added to the hidden states `h_k, …, h_L`, so `h_m` moves by `g_0 + … + g_m`. -/
def Biases.translateAll (b : Biases A dOut) (θ : Params A dIn dOut)
    (g : Fin (L + 1) → d → ℝ) : Biases A dOut where
  E := b.E + g 0
  read ℓ := b.read ℓ - (∑ k ∈ Finset.Iic ℓ.castSucc, g k) ᵥ* θ.read ℓ
  write ℓ := b.write ℓ + g ℓ.succ
  D := b.D - (∑ k, g k) ᵥ* θ.D

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (copy of `Symmetry/BiasesSymmetries.lean`): a matrix whose rows are all `g`, times
`W`, has all rows `g ᵥ* W`. -/
private theorem of_mul_bag {m n : Type*} [Fintype m] (g : m → ℝ) (W : Matrix m n ℝ) :
    (Matrix.of fun (_ : T) => g) * W = Matrix.of fun _ => g ᵥ* W := by
  ext t j
  simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.vecMul, dotProduct]

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (copy of `Symmetry/BiasesSymmetries.lean`): the row `g` added to `H` and `g W`
subtracted from the bias give the same pre-activation `H W + b`. -/
private theorem shift_read_bag {m n : Type*} [Fintype m] (H : Matrix T m ℝ) (g : m → ℝ)
    (W : Matrix m n ℝ) (c : n → ℝ) :
    (H + Matrix.of fun _ => g) * W + (Matrix.of fun _ => c - g ᵥ* W)
      = H * W + Matrix.of fun _ => c := by
  rw [Matrix.add_mul, of_mul_bag]
  ext t j
  simp only [Matrix.add_apply, Matrix.of_apply, Pi.sub_apply]
  ring

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (copy of `Symmetry/BiasesSymmetries.lean`): the rows `c + g` at every token are the
sum of the rows `c` and `g`. -/
private theorem of_add_bag {n : Type*} (c g : n → ℝ) :
    (Matrix.of fun (_ : T) => c + g) = (Matrix.of fun _ => c) + Matrix.of fun _ => g := rfl

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (copy of `Symmetry/InsideBlocksBiases.lean`): `∑_{k ≤ 0} g_k = g_0`. -/
private theorem sum_Iic_zero_bag {W : Type*} [AddCommMonoid W] (g : Fin (L + 1) → W) :
    ∑ k ∈ Finset.Iic (0 : Fin (L + 1)), g k = g 0 := by
  have hs : Finset.Iic (0 : Fin (L + 1)) = {0} := by
    ext k
    simp only [Finset.mem_Iic, Finset.mem_singleton, Fin.le_iff_val_le_val, Fin.ext_iff,
      Fin.val_zero]
    omega
  rw [hs, Finset.sum_singleton]

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (copy of `Symmetry/InsideBlocksBiases.lean`):
`∑_{k ≤ ℓ+1} g_k = ∑_{k ≤ ℓ} g_k + g_{ℓ+1}`. -/
private theorem sum_Iic_succ_bag {W : Type*} [AddCommMonoid W] (g : Fin (L + 1) → W)
    (ℓ : Fin L) :
    ∑ k ∈ Finset.Iic ℓ.succ, g k = ∑ k ∈ Finset.Iic ℓ.castSucc, g k + g ℓ.succ := by
  have hs : Finset.Iic ℓ.succ = insert ℓ.succ (Finset.Iic ℓ.castSucc) := by
    ext k
    simp only [Finset.mem_Iic, Finset.mem_insert, Fin.le_iff_val_le_val, Fin.ext_iff,
      Fin.val_succ, Fin.val_castSucc]
    omega
  have hn : ℓ.succ ∉ Finset.Iic ℓ.castSucc := by
    simp only [Finset.mem_Iic, not_le]
    exact Fin.castSucc_lt_succ
  rw [hs, Finset.sum_insert hn, add_comm]

omit [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: `∑_{k ≤ L} g_k` is the sum over all `k`. -/
private theorem Iic_last_bag : Finset.Iic (Fin.last L) = Finset.univ := by
  ext k
  simp only [Finset.mem_Iic, Finset.mem_univ, Fin.le_last]

omit [Fintype T] [DecidableEq d] [Fintype dOut] in
/-- Helper: without normalization, after the translation of every hidden state `h_k` of a
skipless network by `g_k`, the hidden state `h_m` is shifted by `g_m`. -/
private theorem hiddenB_translateAllAt_bag (hA : A.χ = id) (θ : Params A dIn dOut)
    (b : Biases A dOut) (g : Fin (L + 1) → d → ℝ) (x : Matrix T dIn ℝ) (m : Fin (L + 1)) :
    hiddenB A 0 θ (b.translateAllAt θ g) x m
      = hiddenB A 0 θ b x m + Matrix.of (fun _ => g m) := by
  induction m using Fin.induction with
  | zero =>
    -- `h'_0 = x E + b_E + g_0`
    rw [hiddenB_zero, hiddenB_zero]
    simp only [Biases.translateAllAt, of_add_bag, add_assoc]
  | succ ℓ ih =>
    -- no skip: the read bias removes `g_ℓ W_read`, the write bias adds `g_{ℓ+1}`
    rw [hiddenB_succ, hiddenB_succ, ih, hA]
    simp only [id_eq, Pi.zero_apply, Matrix.mul_zero, zero_add, Biases.translateAllAt,
      shift_read_bag, of_add_bag, add_assoc]

/-- Without normalization, the translations of all hidden states of a skipless network preserve
the function. -/
theorem evalB_translateAllAt (hA : A.χ = id) (θ : Params A dIn dOut) (b : Biases A dOut)
    (g : Fin (L + 1) → d → ℝ) (x : Matrix T dIn ℝ) :
    evalB A 0 θ (b.translateAllAt θ g) x = evalB A 0 θ b x := by
  -- `(h_L + g_L) D + b_D − g_L D = h_L D + b_D`
  unfold evalB
  rw [hiddenB_translateAllAt_bag hA θ b g x (Fin.last L), hA]
  simp only [id_eq, Biases.translateAllAt, shift_read_bag]

omit [Fintype T] [Fintype dOut] in
/-- Helper: without normalization, after the `L + 1` translations of a residual network, the
hidden state `h_m` is shifted by `g_0 + … + g_m`. -/
private theorem hiddenB_translateAll_bag (hA : A.χ = id) (θ : Params A dIn dOut)
    (b : Biases A dOut) (g : Fin (L + 1) → d → ℝ) (x : Matrix T dIn ℝ) (m : Fin (L + 1)) :
    hiddenB A 1 θ (b.translateAll θ g) x m
      = hiddenB A 1 θ b x m + Matrix.of (fun _ => ∑ k ∈ Finset.Iic m, g k) := by
  induction m using Fin.induction with
  | zero =>
    -- `h'_0 = x E + b_E + g_0`
    rw [hiddenB_zero, hiddenB_zero, sum_Iic_zero_bag]
    simp only [Biases.translateAll, of_add_bag, add_assoc]
  | succ ℓ ih =>
    -- the skip carries the shift, the read removes it, the write bias adds `g_{ℓ+1}`
    rw [hiddenB_succ, hiddenB_succ, ih, hA, sum_Iic_succ_bag]
    simp only [Pi.one_apply, Matrix.mul_one, id_eq, Biases.translateAll, shift_read_bag,
      of_add_bag]
    abel

/-- **Lemma A.8, first sentence, the `L + 1` translations together:** without normalization they
preserve the function of a residual network. -/
theorem evalB_translateAll (hA : A.χ = id) (θ : Params A dIn dOut) (b : Biases A dOut)
    (g : Fin (L + 1) → d → ℝ) (x : Matrix T dIn ℝ) :
    evalB A 1 θ (b.translateAll θ g) x = evalB A 1 θ b x := by
  -- `(h_L + ∑ g) D + b_D − (∑ g) D = h_L D + b_D`
  unfold evalB
  rw [hiddenB_translateAll_bag hA θ b g x (Fin.last L), hA, Iic_last_bag]
  simp only [id_eq, Biases.translateAll, shift_read_bag]

/-- **The changes of basis and translations that preserve the function of a skipless network
with biases at all weights and biases.** -/
def affPreservingSkipless (A : Arch T d L) (dIn dOut : Type*) [Fintype dIn] [Fintype dOut] :
    Set ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :=
  {p | ∀ (θ : Params A dIn dOut) (b : Biases A dOut) (x : Matrix T dIn ℝ),
    evalB A 0 (θ.cob p.1 p.1) ((b.translateAllAt θ p.2).cob p.1) x = evalB A 0 θ b x}

/-- **The changes of basis and translations that preserve the function of a residual network
with biases at all weights and biases.** -/
def affPreservingResidual (A : Arch T d L) (dIn dOut : Type*) [Fintype dIn] [Fintype dOut] :
    Set ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :=
  {p | ∀ (θ : Params A dIn dOut) (b : Biases A dOut) (x : Matrix T dIn ℝ),
    evalB A 1 (θ.cob p.1 p.1) ((b.translateAll θ p.2).cob p.1) x = evalB A 1 θ b x}

/-- A set of pairs of invertible matrices and rows, as a set of pairs of matrices and rows. -/
def affMat (s : Set ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))) :
    Set ((Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ)) :=
  (fun p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ) =>
    ((fun ℓ => (p.1 ℓ : Matrix d d ℝ)), p.2)) '' s

/-- **Lemma A.8, without skips, "each hidden state has its own translation":** without
normalization every change of basis and translation of every hidden state preserves the function
of a skipless network with biases. -/
theorem affPreservingSkipless_eq_univ (A : Arch T d L) (hA : A.χ = id) :
    affPreservingSkipless A dIn dOut = Set.univ := by
  refine Set.eq_univ_of_forall fun p θ b x => ?_
  -- the change of basis (`evalB_cob`, stream `G⁻¹ 0 G = 0`), then the translations
  have hχ : ∀ ℓ (h : Matrix T d ℝ),
      A.χ (h * (p.1 ℓ : Matrix d d ℝ)) = A.χ h * (p.1 ℓ : Matrix d d ℝ) := by
    intro ℓ h
    simp only [hA, id_eq]
  have hskip : cobSkip (0 : Fin L → Matrix d d ℝ) p.1 = 0 := by
    funext ℓ
    simp only [cobSkip, Pi.zero_apply, Matrix.mul_zero, Matrix.zero_mul]
  have h := evalB_cob 0 θ (b.translateAllAt θ p.2) p.1 p.1 x hχ
  rw [hskip] at h
  rw [h, evalB_translateAllAt hA]

omit [Fintype T] [Fintype dOut] in
/-- Helper: in a residual network whose writes are all zero, the hidden state `h_m` is `x E`
plus `w_0 + … + w_m` at every token, where `w_0 = b_E` and `w_{ℓ+1} = b_write^ℓ` (whatever the
blocks: the block term is `f(…) 0 = 0`). -/
private theorem hiddenB_write_zero_bag (θ : Params A dIn dOut) (hw : ∀ ℓ, θ.write ℓ = 0)
    (b : Biases A dOut) (w : Fin (L + 1) → d → ℝ) (h0 : b.E = w 0)
    (hs : ∀ ℓ, b.write ℓ = w ℓ.succ) (x : Matrix T dIn ℝ) (m : Fin (L + 1)) :
    hiddenB A 1 θ b x m = x * θ.E + Matrix.of (fun _ => ∑ k ∈ Finset.Iic m, w k) := by
  induction m using Fin.induction with
  | zero => rw [hiddenB_zero, sum_Iic_zero_bag, h0]
  | succ ℓ ih =>
    rw [hiddenB_succ, ih, hw, hs, sum_Iic_succ_bag, of_add_bag]
    simp only [Pi.one_apply, Matrix.mul_one, Matrix.mul_zero, zero_add, add_assoc]

omit [Fintype T] in
/-- Helper: if the changes of basis `G` with the translations `g` preserve the function of every
residual network, then `v G_k G_L⁻¹ D = v D` for every row `v`, every `k` and every readout `D`
(the network with zero embedding, reads and writes, and the biases with `w_k + g_k = v` and
`w_j + g_j = 0` for `j ≠ k`, at the input `0`). -/
private theorem row_eq_of_mem_bag [Nonempty T] (hA : A.χ = id)
    {p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)}
    (hp : p ∈ affPreservingResidual A dIn dOut) (k : Fin (L + 1)) (v : d → ℝ)
    (D : Matrix d dOut ℝ) :
    (v ᵥ* (p.1 k : Matrix d d ℝ)) ᵥ* ((↑(p.1 (Fin.last L))⁻¹ : Matrix d d ℝ) * D)
      = v ᵥ* D := by
  classical
  have hp' : ∀ (θ : Params A dIn dOut) (b : Biases A dOut) (x : Matrix T dIn ℝ),
      evalB A 1 (θ.cob p.1 p.1) ((b.translateAll θ p.2).cob p.1) x = evalB A 1 θ b x := hp
  -- the rows `w` with `w + g = (v at k)`
  obtain ⟨w, hw⟩ : ∃ w : Fin (L + 1) → d → ℝ,
      w = fun j => (if j = k then v else 0) - p.2 j := ⟨_, rfl⟩
  let θ : Params A dIn dOut := ⟨0, fun _ => 0, fun _ => 0, D⟩
  let b : Biases A dOut := ⟨w 0, fun _ => 0, fun ℓ => w ℓ.succ, 0⟩
  have h := hp' θ b 0
  unfold evalB at h
  rw [hiddenB_write_zero_bag θ (fun _ => rfl) b w rfl (fun _ => rfl),
    hiddenB_write_zero_bag (θ.cob p.1 p.1) (fun _ => Matrix.zero_mul _) _
      (fun j => (w j + p.2 j) ᵥ* (p.1 j : Matrix d d ℝ)) rfl (fun _ => rfl), hA,
    Iic_last_bag] at h
  simp only [id_eq, Matrix.zero_mul, zero_add, of_mul_bag] at h
  rw [← of_add_bag, ← of_add_bag] at h
  have h2 := congrFun (Matrix.of.injective h) (Classical.arbitrary T)
  simp only [Params.cob, Biases.cob, Biases.translateAll, θ, b] at h2
  -- `∑_j (w_j + g_j) G_j = v G_k` and `∑_j w_j = v − ∑_j g_j`
  have hs1 : ∑ j, (w j + p.2 j) ᵥ* (p.1 j : Matrix d d ℝ) = v ᵥ* (p.1 k : Matrix d d ℝ) := by
    rw [Finset.sum_eq_single k]
    · rw [hw]
      simp only [sub_add_cancel, ↓reduceIte]
    · intro j _ hj
      rw [hw]
      simp only [sub_add_cancel, hj, ite_false, Matrix.zero_vecMul]
    · intro hk
      exact absurd (Finset.mem_univ k) hk
  have hs2 : ∑ j, w j = v - ∑ j, p.2 j := by
    rw [hw, Finset.sum_sub_distrib, Finset.sum_ite_eq', ite_eq_left (Finset.mem_univ k)]
  rw [hs1, hs2, zero_sub, add_zero, Matrix.sub_vecMul, sub_eq_add_neg] at h2
  exact add_right_cancel h2

omit [Fintype T] in
/-- Helper: if the changes of basis `G` with the translations `g` preserve the function of every
residual network, then `G_k = G_L` for every `k`. -/
private theorem gl_eq_last_bag [Nonempty T] [Nonempty dOut] (hA : A.χ = id)
    {p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)}
    (hp : p ∈ affPreservingResidual A dIn dOut) (k : Fin (L + 1)) :
    p.1 k = p.1 (Fin.last L) := by
  classical
  obtain ⟨c⟩ := (inferInstance : Nonempty dOut)
  -- `G_k G_L⁻¹ = 1`, column `j` from the readout whose rows are `δ_{r j}`, row `i` from `v = e_i`
  have hN : (p.1 k : Matrix d d ℝ) * (↑(p.1 (Fin.last L))⁻¹ : Matrix d d ℝ) = 1 := by
    ext i j
    have h := row_eq_of_mem_bag hA hp k (Pi.single i 1)
      (Matrix.of fun r (_ : dOut) => if r = j then (1 : ℝ) else 0)
    rw [Matrix.vecMul_vecMul, Matrix.single_one_vecMul, Matrix.single_one_vecMul,
      ← Matrix.mul_assoc] at h
    have h2 := congrFun h c
    simp only [Matrix.row, Matrix.mul_apply, Matrix.of_apply, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true] at h2
    rw [Matrix.one_apply]
    exact h2
  exact mul_inv_eq_one.mp (Units.ext (by rw [Units.val_mul, Units.val_one]; exact hN))

/-- **Lemma A.8, "A skip ties only the linear part of `Aff(d_model)`":** without normalization,
the changes of basis `G_0, …, G_L` with the translations `g_0, …, g_L` preserve the function of
every residual network with biases if and only if all `G_ℓ` are equal; the translations are
free. -/
theorem mem_affPreservingResidual_iff [Nonempty T] [Nonempty dOut] (A : Arch T d L)
    (hA : A.χ = id) (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :
    p ∈ affPreservingResidual A dIn dOut ↔ ∀ ℓ, p.1 ℓ = p.1 0 := by
  constructor
  · -- networks with zero writes give `G_ℓ = G_L` for every `ℓ`
    intro hp ℓ
    rw [gl_eq_last_bag hA hp ℓ, gl_eq_last_bag hA hp 0]
  · -- one change of basis: the stream `G⁻¹ 1 G = 1` (`evalB_cob`), then the translations
    intro hc θ b x
    have hχ : ∀ ℓ (h : Matrix T d ℝ),
        A.χ (h * (p.1 ℓ : Matrix d d ℝ)) = A.χ h * (p.1 ℓ : Matrix d d ℝ) := by
      intro ℓ h
      simp only [hA, id_eq]
    have hskip : cobSkip (1 : Fin L → Matrix d d ℝ) p.1 = 1 := by
      funext ℓ
      simp only [cobSkip, Pi.one_apply, Matrix.mul_one]
      rw [hc ℓ.castSucc, hc ℓ.succ, Units.inv_mul]
    have h := evalB_cob 1 θ (b.translateAll θ p.2) p.1 p.1 x hχ
    rw [hskip] at h
    rw [h, evalB_translateAll hA]

omit [Fintype T] in
/-- Helper (copy of `Symmetry/CobGroup.lean`): a matrix with invertible determinant is the value
of an element of `GL d ℝ`. -/
private theorem exists_gl_of_isUnit_det_bag {g : Matrix d d ℝ} (hg : IsUnit g.det) :
    ∃ G : GL d ℝ, (G : Matrix d d ℝ) = g :=
  ⟨((Matrix.isUnit_iff_isUnit_det _).mpr hg).unit, IsUnit.unit_spec _⟩

omit [Fintype T] in
/-- Helper (copy of `Symmetry/CobGroup.lean`): an element of `GL d ℝ` has an invertible
determinant. -/
private theorem isUnit_det_gl_bag (G : GL d ℝ) : IsUnit (G : Matrix d d ℝ).det :=
  (Matrix.isUnit_iff_isUnit_det _).mp G.isUnit

omit [Fintype T] in
/-- Helper: all pairs, as pairs of matrices and rows, are the pairs whose matrices are all
invertible. -/
private theorem affMat_univ_bag :
    affMat (Set.univ : Set ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)))
      = {q | ∀ ℓ, IsUnit (q.1 ℓ).det} := by
  ext q
  constructor
  · rintro ⟨p, -, rfl⟩ ℓ
    exact isUnit_det_gl_bag (p.1 ℓ)
  · intro hq
    choose G hG using fun ℓ => exists_gl_of_isUnit_det_bag (hq ℓ)
    exact ⟨(G, q.2), Set.mem_univ _, Prod.ext (funext hG) rfl⟩

/-- **Lemma A.8, the dimension without skips:** the changes of basis and translations of a
skipless network with biases form a set of dimension `(L + 1)(d² + d)`. -/
theorem dimH_affMat_affPreservingSkipless (A : Arch T d L) (hA : A.χ = id) :
    dimH (affMat (affPreservingSkipless A dIn dOut))
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) : ℕ) : ℝ≥0∞) := by
  -- every pair passes: the set is open (the determinant is continuous) and contains `(1, 0)`
  rw [affPreservingSkipless_eq_univ A hA, affMat_univ_bag]
  have hopen : IsOpen {q : (Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ) |
      ∀ ℓ, IsUnit (q.1 ℓ).det} := by
    simp only [isUnit_iff_ne_zero, Set.ofPred_forall]
    exact isOpen_iInter_of_finite fun ℓ =>
      isOpen_ne_fun ((continuous_apply ℓ).comp continuous_fst).matrix_det continuous_const
  have h1 : ((fun _ => 1, 0) : (Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ)) ∈
      {q : (Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ) |
        ∀ ℓ, IsUnit (q.1 ℓ).det} := fun ℓ => by simp
  have hfin : Module.finrank ℝ ((Fin (L + 1) → Matrix d d ℝ) × (Fin (L + 1) → d → ℝ))
      = (L + 1) * (Fintype.card d ^ 2 + Fintype.card d) := by
    rw [Module.finrank_prod, Module.finrank_pi_fintype, Module.finrank_pi_fintype]
    simp [Module.finrank_matrix, sq]
    ring
  rw [Real.dimH_of_mem_nhds (hopen.mem_nhds h1)]
  exact congrArg Nat.cast hfin

/-- **Lemma A.8, the dimension with identity skips:** the changes of basis and translations of
a residual network with biases form a set of dimension `d² + (L + 1) d`. -/
theorem dimH_affMat_affPreservingResidual [Nonempty T] [Nonempty dOut] (A : Arch T d L)
    (hA : A.χ = id) :
    dimH (affMat (affPreservingResidual A dIn dOut))
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d : ℕ) : ℝ≥0∞) := by
  -- the set is the image of the pairs `(G₀, g)` with `G₀` invertible under
  -- `(G₀, g) ↦ ((G₀, …, G₀), g)` (`mem_affPreservingResidual_iff`)
  set φ := fun q : Matrix d d ℝ × (Fin (L + 1) → d → ℝ) => ((fun _ : Fin (L + 1) => q.1), q.2)
    with hφ
  have hset : affMat (affPreservingResidual A dIn dOut) = φ '' {q | IsUnit q.1.det} := by
    ext q
    constructor
    · rintro ⟨p, hp, rfl⟩
      have hc := (mem_affPreservingResidual_iff A hA p).mp hp
      refine ⟨((p.1 0 : Matrix d d ℝ), p.2), isUnit_det_gl_bag (p.1 0), ?_⟩
      refine Prod.ext (funext fun ℓ => ?_) rfl
      show (p.1 0 : Matrix d d ℝ) = p.1 ℓ
      rw [hc ℓ]
    · rintro ⟨r, hr, rfl⟩
      obtain ⟨G₀, hG₀⟩ := exists_gl_of_isUnit_det_bag hr
      refine ⟨(fun _ => G₀, r.2), (mem_affPreservingResidual_iff A hA _).mpr fun ℓ => rfl, ?_⟩
      exact Prod.ext (funext fun _ => hG₀) rfl
  -- `φ` is an isometry (the sup distance of the constant family is the distance)
  have hiso : Isometry φ := by
    intro a b
    simp only [hφ, Prod.edist_eq]
    congr 1
    exact le_antisymm (edist_pi_le_iff.2 fun _ => le_rfl)
      (edist_le_pi_edist (fun _ : Fin (L + 1) => a.1) (fun _ => b.1) 0)
  -- the pairs with `G₀` invertible are open and contain `(1, 0)`
  have hopen : IsOpen {q : Matrix d d ℝ × (Fin (L + 1) → d → ℝ) | IsUnit q.1.det} := by
    simp only [isUnit_iff_ne_zero]
    exact isOpen_ne_fun continuous_fst.matrix_det continuous_const
  have h1 : ((1, 0) : Matrix d d ℝ × (Fin (L + 1) → d → ℝ)) ∈
      {q : Matrix d d ℝ × (Fin (L + 1) → d → ℝ) | IsUnit q.1.det} := by simp
  have hfin : Module.finrank ℝ (Matrix d d ℝ × (Fin (L + 1) → d → ℝ))
      = Fintype.card d ^ 2 + (L + 1) * Fintype.card d := by
    rw [Module.finrank_prod, Module.finrank_pi_fintype]
    simp [Module.finrank_matrix, sq]
  rw [hset, hiso.dimH_image, Real.dimH_of_mem_nhds (hopen.mem_nhds h1)]
  exact congrArg Nat.cast hfin

/-- **Lemma A.8, "the skips remove `L d_model²` dimensions, as without biases":** the set for
the skipless network has `L d²` more dimensions than the set for the residual network. -/
theorem dimH_affMat_affPreservingSkipless_eq_add [Nonempty T] [Nonempty dOut] (A : Arch T d L)
    (hA : A.χ = id) :
    dimH (affMat (affPreservingSkipless A dIn dOut))
      = dimH (affMat (affPreservingResidual A dIn dOut))
        + ((L * Fintype.card d ^ 2 : ℕ) : ℝ≥0∞) := by
  rw [dimH_affMat_affPreservingSkipless A hA, dimH_affMat_affPreservingResidual A hA,
    ← Nat.cast_add]
  congr 1
  ring

end Skips
