import SkipsLean.Symmetry.BiasesGeneratedGroupRescale
import SkipsLean.Symmetry.BiasesGeneratedGroupAttention
import SkipsLean.Generic.Params
import SkipsLean.Generic.Gated
import SkipsLean.Dimension.RescalingMlp
import SkipsLean.Dimension.RescalingGate
import SkipsLean.Dimension.UpperBoundAttention

/-!
# The generated group of Lemma A.8: the three statements together, at almost every weight

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips".

`Symmetry/BiasesGeneratedGroup.lean` has three statements for a family of symmetries inside the
blocks given as maps: the generated group is the set of the products; the products are
parametrized injectively at weights and biases where the family acts freely; the set of the
parameters has the dimension of the lemma. Here they are one statement, with "at weights where
the family acts freely" replaced by "at almost every weight, for every bias":

* `generatedGroup_residual`, `generatedGroup_skipless`: for a family that acts freely block by
  block at almost every weight (and `d_in ≥ d`; without skips also every write with at least `d`
  rows): the subgroup generated is the set of the products `affAct p ∘ act σ`; at almost every
  weight and every bias `(p, σ) ↦ affAct p (act σ (θ, b))` is injective on the pairs that preserve
  the function and `σ ∈ Sg`; and the set of these `(p, σ)` has Hausdorff dimension
  `d² + (L + 1) d + dim F` (without skips `(L + 1)(d² + d) + dim F`);
* the four kinds of family act freely block by block at almost every weight: the rescalings of
  MLP units, of gated values, of gated values and gates (`d ≥ 1`), and the symmetries inside
  attention heads with biases (`d_h ≤ d`).

With `insideBlocksAction_rescaleMlp`, `insideBlocksAction_rescale`, `insideBlocksAction_rescaleBoth`
and `insideBlocksAction_heads` these give the sentence of the lemma for networks of MLP blocks
with a positively homogeneous activation, of gated blocks, and of attention blocks with biases;
for tanh and GELU blocks `s = 0` (`Symmetry/BiasesAffineGroupLaw.lean`).
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]

section General

variable {A : Arch T d L}
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  {act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut} {Sg : Set F}

/-- Helper (the private `ae_rank_E` of `Generic/Params.lean`): at almost every weight `E` has
rank `d`, when `d_in ≥ d`. -/
private theorem ae_rank_E_bgn (μ : Measure (Params A dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn) : ∀ᵐ θ ∂μ, θ.E.rank = Fintype.card d := by
  obtain ⟨ρ⟩ := Function.Embedding.nonempty_of_card_le hdIn
  filter_upwards [ae_isUnit_det_submatrix μ] with θ hθ
  exact le_antisymm (Matrix.rank_le_card_width θ.E)
    ((Matrix.rank_of_isUnit _ ((Matrix.isUnit_iff_isUnit_det _).2 (hθ.2.2.1 ρ))).symm.le.trans
      (Matrix.rank_submatrix_le θ.E ρ id))

/-- **Lemma A.8, second sentence, with skips, for a family of symmetries inside the blocks that
acts freely at almost every weight:** without normalization and for `d_in ≥ d`, the group
generated by the changes of basis and translations that preserve the function and by the family
is the set of the products; at almost every weight and every bias the products are parametrized
injectively by the pairs `(p, σ)`; and the set of these pairs has dimension
`d² + (L + 1) d + dim F`. -/
theorem generatedGroup_residual [Nonempty T] [Nonempty dOut] (hA : A.χ = id)
    (hact : InsideBlocksAction act Sg) (hS : IsOpen Sg) (hne : Sg.Nonempty)
    (μ : Measure (Params A dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hfree : ∀ᵐ θ ∂μ, ∀ b : Biases A dOut, InsideBlocksFreeAt act Sg (θ, b)) :
    (∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
      φ ∈ Subgroup.closure
          ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
              ∃ p ∈ affPreservingResidual A dIn dOut, ⇑φ = affActResidual p}
            ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
        ↔ ∃ p ∈ affPreservingResidual A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActResidual p ∘ act σ) ∧
    (∀ᵐ θ ∂μ, ∀ b : Biases A dOut, Set.InjOn
      (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActResidual x.1 (act x.2 (θ, b)))
      (affPreservingResidual A dIn dOut ×ˢ Sg)) ∧
    dimH (affMat (affPreservingResidual A dIn dOut) ×ˢ Sg)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d + Module.finrank ℝ F : ℕ) : ℝ≥0∞) := by
  refine ⟨fun φ => mem_closure_affActResidual_union_iff hA hact φ, ?_,
    dimH_affMat_affPreservingResidual_prod A hA hS hne⟩
  filter_upwards [ae_rank_E_bgn μ hdIn, hfree] with θ hE hf b
  exact (injOn_affActResidual_act (q := (θ, b)) hE hact (hf b)).mono
    (Set.prod_mono (fun p hp => (mem_affPreservingResidual_iff A hA p).1 hp) subset_rfl)

/-- **The same without skips:** for `d_in ≥ d` and writes with at least `d` rows; dimension
`(L + 1)(d² + d) + dim F`. -/
theorem generatedGroup_skipless (hA : A.χ = id)
    (hact : InsideBlocksAction act Sg) (hS : IsOpen Sg) (hne : Sg.Nonempty)
    (μ : Measure (Params A dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hw : ∀ ℓ, Fintype.card d ≤ Fintype.card (A.w ℓ))
    (hfree : ∀ᵐ θ ∂μ, ∀ b : Biases A dOut, InsideBlocksFreeAt act Sg (θ, b)) :
    (∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
      φ ∈ Subgroup.closure
          ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
              ∃ p ∈ affPreservingSkipless A dIn dOut, ⇑φ = affActSkipless p}
            ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
        ↔ ∃ p ∈ affPreservingSkipless A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActSkipless p ∘ act σ) ∧
    (∀ᵐ θ ∂μ, ∀ b : Biases A dOut, Set.InjOn
      (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActSkipless x.1 (act x.2 (θ, b)))
      (affPreservingSkipless A dIn dOut ×ˢ Sg)) ∧
    dimH (affMat (affPreservingSkipless A dIn dOut) ×ˢ Sg)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + Module.finrank ℝ F : ℕ)
          : ℝ≥0∞) := by
  refine ⟨fun φ => mem_closure_affActSkipless_union_iff hact φ, ?_,
    dimH_affMat_affPreservingSkipless_prod A hA hS hne⟩
  filter_upwards [ae_rank_E_write μ hdIn hw, hfree] with θ h1 hf b
  exact (injOn_affActSkipless_act (q := (θ, b)) h1.1 h1.2 hact (hf b)).mono
    (Set.prod_mono (Set.subset_univ _) subset_rfl)

end General

section Kinds

variable {σ : ℝ → ℝ} {χ : Matrix T d ℝ → Matrix T d ℝ} {hid : Fin L → Type}
  [∀ ℓ, Fintype (hid ℓ)]

/-- **The rescalings of MLP units act freely block by block at almost every weight.** -/
theorem ae_insideBlocksFreeAt_rescaleMlp [Nonempty d] (k : ℕ)
    (μ : Measure (Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut)) [μ.IsAddHaarMeasure] :
    ∀ᵐ θ ∂μ, ∀ b : Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut,
      InsideBlocksFreeAt (rescaleMlpAct k) (posRescalings hid) (θ, b) := by
  filter_upwards [ae_read_col_ne_zero μ] with θ hcol b
  exact insideBlocksFreeAt_rescaleMlp k (θ, b) fun ℓ i => Function.ne_iff.1 (hcol ℓ i)

/-- **The rescalings of gated values act freely block by block at almost every weight.** -/
theorem ae_insideBlocksFreeAt_rescale [Nonempty d]
    (μ : Measure (Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut))
    [μ.IsAddHaarMeasure] :
    ∀ᵐ θ ∂μ, ∀ b : Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut,
      InsideBlocksFreeAt rescaleAct (posRescalings hid) (θ, b) := by
  filter_upwards [ae_value_ne_zero μ] with θ hcol b
  exact insideBlocksFreeAt_rescale (θ, b) fun ℓ i => Function.ne_iff.1 (hcol ℓ i)

/-- **The rescalings of gated values and gates act freely block by block at almost every
weight.** -/
theorem ae_insideBlocksFreeAt_rescaleBoth [Nonempty d] (k : ℕ)
    (μ : Measure (Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut))
    [μ.IsAddHaarMeasure] :
    ∀ᵐ θ ∂μ, ∀ b : Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut,
      InsideBlocksFreeAt (rescaleBothAct k) (posRescalings hid ×ˢ posRescalings hid) (θ, b) := by
  filter_upwards [ae_gate_ne_zero μ, ae_value_ne_zero μ] with θ hgate hval b
  exact insideBlocksFreeAt_rescaleBoth k (θ, b) (fun ℓ i => Function.ne_iff.1 (hgate ℓ i))
    fun ℓ i => Function.ne_iff.1 (hval ℓ i)

end Kinds

section Attention

variable {sees : T → T → Prop} [DecidableRel sees] {χ : Matrix T d ℝ → Matrix T d ℝ}
variable {H dh : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]
  [∀ ℓ, DecidableEq (dh ℓ)]

/-- **The symmetries inside attention heads with biases act freely block by block at almost every
weight,** for heads of width `d_h ≤ d`. -/
theorem ae_insideBlocksFreeAt_heads
    (μ : Measure (Params (Arch.attention (T := T) (d := d) sees χ H dh) dIn dOut))
    [μ.IsAddHaarMeasure] (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    ∀ᵐ θ ∂μ, ∀ b : Biases (Arch.attention (T := T) (d := d) sees χ H dh) dOut,
      InsideBlocksFreeAt headsAct (headsSet H dh) (θ, b) := by
  filter_upwards [ae_rank_QV_uba μ hdh] with θ h b
  exact insideBlocksFreeAt_heads (θ, b) h.1 h.2

end Attention

end Skips
