import SkipsLean.Symmetry.BiasesAffineGroup

/-!
# The changes of basis and translations of a network with biases form a group

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and
the skips remove `L d_model²` dimensions, as without biases." Its proof: "A skip ties only the
linear part of `Aff(d_model)`, which gives the counts."

`Symmetry/BiasesAffineGroup.lean` has the changes of basis and translations that preserve the
function as sets of pairs `(G, g)`, with their dimensions, and
`Symmetry/BiasesSymmetryCount.lean` the count with `s` on the directions of the symmetries at one
parameter. Here the two things that the word "group" and the sum "`+ s`" of the sentence add:

* the map of the weights and biases that a pair `(G, g)` gives (`affActSkipless`,
  `affActResidual`: the translations, then the changes of basis) is a bijection; the pair
  `(G, g)` followed by the pair `(G', g')` is the pair `(G G', g + g' G⁻¹)` (`affMul`; in a
  residual network when all `G_ℓ` are equal); so the maps of the pairs that preserve the function
  form a group of bijections of the weights and biases, a subgroup of the permutations of
  `Params × Biases`;
* this group meets the symmetries inside the blocks only in the identity. A symmetry inside the
  blocks keeps `E` and the embedding bias (it changes the reads, the writes and their biases).
  At weights whose `E` has rank `d` (and, without skips, whose writes have rank `d`): a pair
  whose map keeps `E` and the embedding bias, and keeps the write and the write bias of every
  block of which it keeps the read and the read bias, is the pair `(1, 0)`. The last condition is
  the one of the count on directions (`hrw` in `finrank_span_symmetryDirs_residual`: a direction
  inside the blocks whose read and read bias of a block are `0` has the write and the write bias
  of that block `0`), for maps. In particular the group acts freely at such weights.

With the dimensions of `Symmetry/BiasesAffineGroup.lean` this is the sentence for the group of the
changes of basis and translations; the `s` of the symmetries inside the blocks, which the paper
gives kind by kind (Section 4.1 and Appendix A.6), enters in Lean as a space of directions, and
the dimension with `s` is the statement of `Symmetry/BiasesSymmetryCount.lean`.
-/

namespace Skips

open Matrix

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A : Arch T d L}

/-- **The map of the weights and biases of a skipless network that the pair `(G, g)` gives:** the
translation of every hidden state `h_k` by the row `g_k`, then the changes of basis
`G_0, …, G_L`. -/
def affActSkipless (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (q : Params A dIn dOut × Biases A dOut) : Params A dIn dOut × Biases A dOut :=
  (q.1.cob p.1 p.1, (q.2.translateAllAt q.1 p.2).cob p.1)

/-- **The map of the weights and biases of a residual network that the pair `(G, g)` gives:** the
`L + 1` translations of Lemma A.8 (the row `g_k` added to `h_k, …, h_L`), then the changes of
basis `G_0, …, G_L`. -/
def affActResidual (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (q : Params A dIn dOut × Biases A dOut) : Params A dIn dOut × Biases A dOut :=
  (q.1.cob p.1 p.1, (q.2.translateAll q.1 p.2).cob p.1)

/-- **The product of two pairs,** index by index: `(G, g)(G', g') = (G G', g + g' G⁻¹)`. -/
def affMul (p p' : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :
    (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ) :=
  (fun ℓ => p.1 ℓ * p'.1 ℓ, fun ℓ => p.2 ℓ + p'.2 ℓ ᵥ* (↑(p.1 ℓ)⁻¹ : Matrix d d ℝ))

/-! ### Skipless networks -/

/-- The pair `(1, 0)` moves nothing. -/
theorem affActSkipless_one (q : Params A dIn dOut × Biases A dOut) :
    affActSkipless ((1 : Fin (L + 1) → GL d ℝ), (0 : Fin (L + 1) → d → ℝ)) q = q := by
  sorry

/-- **The composition, without skips:** the map of `(G, g)` followed by the map of `(G', g')` is
the map of `(G G', g + g' G⁻¹)`. -/
theorem affActSkipless_affActSkipless (p p' : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (q : Params A dIn dOut × Biases A dOut) :
    affActSkipless p' (affActSkipless p q) = affActSkipless (affMul p p') q := by
  sorry

/-- The map of a pair is a bijection of the weights and biases. -/
theorem affActSkipless_bijective (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :
    Function.Bijective (affActSkipless p :
      Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut) := by
  sorry

/-- **Lemma A.8, "The symmetry group generated by changes of basis, translations", without
skips:** for any network, the maps of the pairs `(G, g)` that preserve the function of a skipless
network at all weights and biases form a group of bijections of the weights and biases. -/
theorem exists_subgroup_affActSkipless (A : Arch T d L) :
    ∃ K : Subgroup (Equiv.Perm (Params A dIn dOut × Biases A dOut)),
      ∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
        φ ∈ K ↔ ∃ p ∈ affPreservingSkipless A dIn dOut, ⇑φ = affActSkipless p := by
  sorry

/-- **The group meets the symmetries inside the blocks only in the identity, without skips:** at
weights whose `E` and writes have rank `d`, a pair whose map keeps `E` and the embedding bias, and
keeps the write and the write bias of every block of which it keeps the read and the read bias,
is the pair `(1, 0)`. -/
theorem eq_one_of_affActSkipless_keeps (q : Params A dIn dOut × Biases A dOut)
    (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (hE : q.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (q.1.write ℓ).rank = Fintype.card d)
    (h1 : (affActSkipless p q).1.E = q.1.E) (h2 : (affActSkipless p q).2.E = q.2.E)
    (h3 : ∀ ℓ, (affActSkipless p q).1.read ℓ = q.1.read ℓ →
      (affActSkipless p q).2.read ℓ = q.2.read ℓ →
      (affActSkipless p q).1.write ℓ = q.1.write ℓ ∧
        (affActSkipless p q).2.write ℓ = q.2.write ℓ) :
    p = (1, 0) := by
  sorry

/-- **The group acts freely, without skips:** at weights whose `E` and writes have rank `d`, the
map of a pair fixes the weights and biases only if the pair is `(1, 0)`. -/
theorem affActSkipless_eq_self_iff (q : Params A dIn dOut × Biases A dOut)
    (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (hE : q.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (q.1.write ℓ).rank = Fintype.card d) :
    affActSkipless p q = q ↔ p = (1, 0) := by
  constructor
  · intro h
    exact eq_one_of_affActSkipless_keeps q p hE hw (by rw [h]) (by rw [h])
      (fun ℓ _ _ => ⟨by rw [h], by rw [h]⟩)
  · rintro rfl
    exact affActSkipless_one q

/-! ### Residual networks -/

/-- The pair `(1, 0)` moves nothing. -/
theorem affActResidual_one (q : Params A dIn dOut × Biases A dOut) :
    affActResidual ((1 : Fin (L + 1) → GL d ℝ), (0 : Fin (L + 1) → d → ℝ)) q = q := by
  sorry

/-- **The composition, with skips:** for a pair `(G, g)` with all `G_ℓ` equal, its map followed
by the map of `(G', g')` is the map of `(G G', g + g' G⁻¹)`. -/
theorem affActResidual_affActResidual (p p' : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ))
    (hp : ∀ ℓ, p.1 ℓ = p.1 0) (q : Params A dIn dOut × Biases A dOut) :
    affActResidual p' (affActResidual p q) = affActResidual (affMul p p') q := by
  sorry

/-- The map of a pair is a bijection of the weights and biases. -/
theorem affActResidual_bijective (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) :
    Function.Bijective (affActResidual p :
      Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut) := by
  sorry

/-- **Lemma A.8, "The symmetry group generated by changes of basis, translations", with skips:**
without normalization, for any blocks, the maps of the pairs `(G, g)` that preserve the function
of a residual network at all weights and biases (the pairs with all `G_ℓ` equal) form a group of
bijections of the weights and biases. -/
theorem exists_subgroup_affActResidual [Nonempty T] [Nonempty dOut] (A : Arch T d L)
    (hA : A.χ = id) :
    ∃ K : Subgroup (Equiv.Perm (Params A dIn dOut × Biases A dOut)),
      ∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
        φ ∈ K ↔ ∃ p ∈ affPreservingResidual A dIn dOut, ⇑φ = affActResidual p := by
  sorry

/-- **The group meets the symmetries inside the blocks only in the identity, with skips:** at
weights whose `E` has rank `d`, a pair with all `G_ℓ` equal whose map keeps `E` and the embedding
bias, and keeps the write and the write bias of every block of which it keeps the read and the
read bias, is the pair `(1, 0)`. -/
theorem eq_one_of_affActResidual_keeps (q : Params A dIn dOut × Biases A dOut)
    (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) (hp : ∀ ℓ, p.1 ℓ = p.1 0)
    (hE : q.1.E.rank = Fintype.card d)
    (h1 : (affActResidual p q).1.E = q.1.E) (h2 : (affActResidual p q).2.E = q.2.E)
    (h3 : ∀ ℓ, (affActResidual p q).1.read ℓ = q.1.read ℓ →
      (affActResidual p q).2.read ℓ = q.2.read ℓ →
      (affActResidual p q).1.write ℓ = q.1.write ℓ ∧
        (affActResidual p q).2.write ℓ = q.2.write ℓ) :
    p = (1, 0) := by
  sorry

/-- **The group acts freely, with skips:** at weights whose `E` has rank `d`, the map of a pair
with all `G_ℓ` equal fixes the weights and biases only if the pair is `(1, 0)`. -/
theorem affActResidual_eq_self_iff (q : Params A dIn dOut × Biases A dOut)
    (p : (Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) (hp : ∀ ℓ, p.1 ℓ = p.1 0)
    (hE : q.1.E.rank = Fintype.card d) :
    affActResidual p q = q ↔ p = (1, 0) := by
  constructor
  · intro h
    exact eq_one_of_affActResidual_keeps q p hp hE (by rw [h]) (by rw [h])
      (fun ℓ _ _ => ⟨by rw [h], by rw [h]⟩)
  · rintro rfl
    exact affActResidual_one q

end Skips
