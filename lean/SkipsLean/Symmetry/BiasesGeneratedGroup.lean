import SkipsLean.Symmetry.BiasesAffineGroupLaw

/-!
# The group generated by the changes of basis, the translations and the symmetries inside the blocks

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and
the skips remove `L d_model²` dimensions, as without biases."

`Symmetry/BiasesAffineGroupLaw.lean` has the group of the changes of basis and translations as a
group of maps of the weights and biases. Here the symmetries inside the blocks are a family of
maps `act σ` of the weights and biases, indexed by the points `σ` of a set `Sg` of a real vector
space `F` (the rescalings of the hidden units; the changes of basis inside the heads; each kind of
block has its own file), and the sentence of the lemma is three statements about such a family:

* `InsideBlocksAction act Sg`: the maps of the family contain the identity, are closed under
  composition and inverses, commute with the maps of the changes of basis and translations,
  preserve the function with and without skips, and keep the rank of every write;
* **the group generated:** the subgroup of the permutations of the weights and biases generated
  by the maps of the changes of basis and translations that preserve the function and by the maps
  of the family is the set of the products `affAct p ∘ act σ`; each of them preserves the
  function;
* `InsideBlocksFreeAt act Sg q`: at the weights and biases `q` the maps of the family keep `E` and
  the embedding bias, keep the write and the write bias of a block of which they keep the read and
  the read bias, and two different points of `Sg` move `q` to different weights and biases;
* **the generated group is the product:** at such `q` with `E` of rank `d` (without skips: and
  the writes of rank `d`), `(p, σ) ↦ affAct p (act σ q)` is injective, so different pairs `(p, σ)`
  give different maps;
* **its dimension:** for `Sg` open and not empty in `F`, the set of the pairs `(p, σ)` has
  Hausdorff dimension `d² + (L + 1) d + dim F` with skips and `(L + 1)(d² + d) + dim F` without;
  `dim F` is the `s` of the lemma.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A : Arch T d L}

/-- **A family of symmetries inside the blocks of a network with biases, as maps of the weights
and biases:** the maps `act σ`, `σ ∈ Sg`, contain the identity, are closed under composition and
inverses, commute with the map of every pair `(G, g)` of changes of basis and translations (with
and without skips), preserve the function for every stream, and keep the rank of every write. -/
structure InsideBlocksAction {F : Type*}
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (Sg : Set F) : Prop where
  one : ∃ σ ∈ Sg, act σ = id
  mul : ∀ σ ∈ Sg, ∀ σ' ∈ Sg, ∃ τ ∈ Sg, act σ ∘ act σ' = act τ
  inv : ∀ σ ∈ Sg, ∃ τ ∈ Sg, act σ ∘ act τ = id ∧ act τ ∘ act σ = id
  comm_skipless : ∀ p, ∀ σ ∈ Sg, affActSkipless p ∘ act σ = act σ ∘ affActSkipless p
  comm_residual : ∀ p, ∀ σ ∈ Sg, affActResidual p ∘ act σ = act σ ∘ affActResidual p
  evalB_eq : ∀ σ ∈ Sg, ∀ (S : Fin L → Matrix d d ℝ) (q : Params A dIn dOut × Biases A dOut)
    (x : Matrix T dIn ℝ), evalB A S (act σ q).1 (act σ q).2 x = evalB A S q.1 q.2 x
  rank_write : ∀ σ ∈ Sg, ∀ (q : Params A dIn dOut × Biases A dOut) ℓ,
    ((act σ q).1.write ℓ).rank = (q.1.write ℓ).rank

/-- **The family acts freely at the weights and biases `q`, block by block:** every map of the
family keeps `E` and the embedding bias of `q`; it keeps the write and the write bias of every
block of which it keeps the read and the read bias; and different points of `Sg` move `q` to
different weights and biases. -/
structure InsideBlocksFreeAt {F : Type*}
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (Sg : Set F) (q : Params A dIn dOut × Biases A dOut) : Prop where
  E_eq : ∀ σ ∈ Sg, (act σ q).1.E = q.1.E
  biasE_eq : ∀ σ ∈ Sg, (act σ q).2.E = q.2.E
  write_eq_of_read_eq : ∀ σ ∈ Sg, ∀ ℓ, (act σ q).1.read ℓ = q.1.read ℓ →
    (act σ q).2.read ℓ = q.2.read ℓ →
    (act σ q).1.write ℓ = q.1.write ℓ ∧ (act σ q).2.write ℓ = q.2.write ℓ
  injOn : Set.InjOn (fun σ => act σ q) Sg

section Generated

variable {F : Type*}
  {act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut} {Sg : Set F}

/-- **Lemma A.8, "The symmetry group generated by changes of basis, translations and the
symmetries inside blocks", without skips:** for any network, the subgroup of the permutations of
the weights and biases generated by the maps of the pairs that preserve the function of the
skipless network and by the maps of a family of symmetries inside the blocks is the set of the
products `affActSkipless p ∘ act σ`. -/
theorem mem_closure_affActSkipless_union_iff
    (hact : InsideBlocksAction act Sg)
    (φ : Equiv.Perm (Params A dIn dOut × Biases A dOut)) :
    φ ∈ Subgroup.closure
        ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
            ∃ p ∈ affPreservingSkipless A dIn dOut, ⇑φ = affActSkipless p}
          ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
      ↔ ∃ p ∈ affPreservingSkipless A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActSkipless p ∘ act σ := by
  sorry

/-- **The same with skips:** without normalization, for any blocks, the subgroup generated by the
maps of the pairs that preserve the function of the residual network (the pairs with all `G_ℓ`
equal) and by the maps of a family of symmetries inside the blocks is the set of the products
`affActResidual p ∘ act σ`. -/
theorem mem_closure_affActResidual_union_iff [Nonempty T] [Nonempty dOut]
    (hA : A.χ = id) (hact : InsideBlocksAction act Sg)
    (φ : Equiv.Perm (Params A dIn dOut × Biases A dOut)) :
    φ ∈ Subgroup.closure
        ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
            ∃ p ∈ affPreservingResidual A dIn dOut, ⇑φ = affActResidual p}
          ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
      ↔ ∃ p ∈ affPreservingResidual A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActResidual p ∘ act σ := by
  sorry

/-- **Every map of the generated group preserves the function, without skips.** -/
theorem evalB_eq_of_mem_closure_skipless
    (hact : InsideBlocksAction act Sg)
    {φ : Equiv.Perm (Params A dIn dOut × Biases A dOut)}
    (hφ : φ ∈ Subgroup.closure
        ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
            ∃ p ∈ affPreservingSkipless A dIn dOut, ⇑φ = affActSkipless p}
          ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ}))
    (q : Params A dIn dOut × Biases A dOut) (x : Matrix T dIn ℝ) :
    evalB A 0 (φ q).1 (φ q).2 x = evalB A 0 q.1 q.2 x := by
  sorry

/-- **Every map of the generated group preserves the function, with skips.** -/
theorem evalB_eq_of_mem_closure_residual
    (hact : InsideBlocksAction act Sg)
    {φ : Equiv.Perm (Params A dIn dOut × Biases A dOut)}
    (hφ : φ ∈ Subgroup.closure
        ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
            ∃ p ∈ affPreservingResidual A dIn dOut, ⇑φ = affActResidual p}
          ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ}))
    (q : Params A dIn dOut × Biases A dOut) (x : Matrix T dIn ℝ) :
    evalB A 1 (φ q).1 (φ q).2 x = evalB A 1 q.1 q.2 x := by
  sorry

/-- **The generated group is the product, without skips:** at weights and biases `q` whose `E`
and writes have rank `d`, at which the family acts freely block by block, the map
`(p, σ) ↦ affActSkipless p (act σ q)` is injective on the pairs with `σ ∈ Sg`. -/
theorem injOn_affActSkipless_act {q : Params A dIn dOut × Biases A dOut}
    (hE : q.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (q.1.write ℓ).rank = Fintype.card d)
    (hact : InsideBlocksAction act Sg) (hfree : InsideBlocksFreeAt act Sg q) :
    Set.InjOn (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActSkipless x.1 (act x.2 q)) (Set.univ ×ˢ Sg) := by
  sorry

/-- **The generated group is the product, with skips:** at weights and biases `q` whose `E` has
rank `d`, at which the family acts freely block by block, the map
`(p, σ) ↦ affActResidual p (act σ q)` is injective on the pairs with all `G_ℓ` equal and
`σ ∈ Sg`. -/
theorem injOn_affActResidual_act {q : Params A dIn dOut × Biases A dOut}
    (hE : q.1.E.rank = Fintype.card d)
    (hact : InsideBlocksAction act Sg) (hfree : InsideBlocksFreeAt act Sg q) :
    Set.InjOn (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActResidual x.1 (act x.2 q)) ({p | ∀ ℓ, p.1 ℓ = p.1 0} ×ˢ Sg) := by
  sorry

end Generated

/-- **Lemma A.8, "has dimension […] `(L + 1)(d_model² + d_model) + s` without skips":** without
normalization, the pairs `(G, g)` that preserve the function of a skipless network, together with
the points of a nonempty open set `Sg` of a real vector space `F` of finite dimension (the
symmetries inside the blocks), form a set of Hausdorff dimension `(L + 1)(d² + d) + dim F`. -/
theorem dimH_affMat_affPreservingSkipless_prod (A : Arch T d L) (hA : A.χ = id)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {Sg : Set F}
    (hS : IsOpen Sg) (hne : Sg.Nonempty) :
    dimH (affMat (affPreservingSkipless A dIn dOut) ×ˢ Sg)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + Module.finrank ℝ F : ℕ) : ℝ≥0∞) := by
  sorry

/-- **Lemma A.8, "has dimension `d_model² + (L + 1) d_model + s`", with skips:** without
normalization, the pairs `(G, g)` that preserve the function of a residual network, together with
the points of a nonempty open set `Sg` of a real vector space `F` of finite dimension, form a set
of Hausdorff dimension `d² + (L + 1) d + dim F`. -/
theorem dimH_affMat_affPreservingResidual_prod [Nonempty T] [Nonempty dOut] (A : Arch T d L)
    (hA : A.χ = id)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F] {Sg : Set F}
    (hS : IsOpen Sg) (hne : Sg.Nonempty) :
    dimH (affMat (affPreservingResidual A dIn dOut) ×ˢ Sg)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d + Module.finrank ℝ F : ℕ) : ℝ≥0∞) := by
  sorry

end Skips
