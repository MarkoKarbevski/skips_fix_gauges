    Prod.ext (headsVO_expGL_zero_ahb p.1 Γ) (biasesVO_expGL_zero_ahb p.2 Γ)
  -- with velocity `headDirVOB p Γ`
  have hd : HasDerivAt (fun τ : ℝ => ((p.1.headsVO fun ℓ i => expGL_ahb (Γ ℓ i) τ,
      biasesVO_ahb p.2 fun ℓ i => expGL_ahb (Γ ℓ i) τ) : ParamsB _ dIn dOut))
      (headDirVOB p Γ) 0 :=
    (hasDerivAt_headsVO_ahb p.1 Γ).prodMk (hasDerivAt_biasesVO_ahb p Γ)
  -- and it keeps the map of every block
  have hb : ∀ τ : ℝ, ∀ ℓ (n : Matrix T d ℝ),
      (Arch.attention sees χ H dh).f ℓ (n * (p.1.headsVO fun ℓ i => expGL_ahb (Γ ℓ i) τ).read ℓ
          + Matrix.of fun _ => (biasesVO_ahb p.2 fun ℓ i => expGL_ahb (Γ ℓ i) τ).read ℓ)
          * (p.1.headsVO fun ℓ i => expGL_ahb (Γ ℓ i) τ).write ℓ
        + Matrix.of (fun _ => (biasesVO_ahb p.2 fun ℓ i => expGL_ahb (Γ ℓ i) τ).write ℓ)
      = (Arch.attention sees χ H dh).f ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ)
          * p.1.write ℓ + Matrix.of fun _ => p.2.write ℓ :=
    fun τ ℓ n => block_headsVOB_ahb p.1 p.2 _ ℓ n
  exact ⟨_, h0, hd, Filter.Eventually.of_forall fun τ => ⟨rfl, rfl, rfl, rfl, hb τ⟩⟩

/-! ### Helpers: the shifts of the key biases and of the value biases -/

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: the attention weights do not change when a function `r t` of the row alone is added
to the scores: numerator and denominator of row `t` are multiplied by `e^{r t}`. -/
private theorem attnWeights_add_row_ahb (Z Z' : Matrix T T ℝ) (r : T → ℝ)
    (hZ : ∀ t s, Z' t s = Z t s + r t) :
    attnWeights sees Z' = attnWeights sees Z := by
  ext t s
  simp only [attnWeights, Matrix.of_apply, hZ, Real.exp_add]
  split_ifs with h
  · -- the denominator is multiplied by `e^{r t}` too
    have e : (∑ s', if sees t s' then Real.exp (Z t s') * Real.exp (r t) else 0)
        = (∑ s', if sees t s' then Real.exp (Z t s') else 0) * Real.exp (r t) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun s' _ => ?_
      split_ifs
      · rfl
      · rw [zero_mul]
    rw [e, mul_div_mul_right _ _ (Real.exp_pos _).ne']
  · rfl

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (the private `attnWeights_den_pos_ba` of `Absorb/BiasesAttention.lean`): the
denominator of row `t` of the weights is positive when token `t` sees some token. -/
private theorem attnWeights_den_pos_ahb (Z : Matrix T T ℝ) (t : T) (ht : ∃ s, sees t s) :
    0 < ∑ s', if sees t s' then Real.exp (Z t s') else 0 := by
  obtain ⟨s, hs⟩ := ht
  refine Finset.sum_pos' (fun s' _ => ?_) ⟨s, Finset.mem_univ _, ?_⟩
  · split_ifs
    · exact (Real.exp_pos _).le
    · exact le_rfl
  · simp only [hs, ite_true]
    exact Real.exp_pos _

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper (the private `attnWeights_sum_ba` of `Absorb/BiasesAttention.lean`): row `t` of the
weights sums to `1` when token `t` sees some token. -/
private theorem attnWeights_sum_ahb (Z : Matrix T T ℝ) (t : T) (ht : ∃ s, sees t s) :
    ∑ s, attnWeights sees Z t s = 1 := by
  have hS := attnWeights_den_pos_ahb Z t ht
  have h1 : ∀ s, attnWeights sees Z t s = (if sees t s then Real.exp (Z t s) else 0)
      / ∑ s', if sees t s' then Real.exp (Z t s') else 0 := by
    intro s
    simp only [attnWeights, Matrix.of_apply]
    split_ifs
    · rfl
    · rw [zero_div]
  simp only [h1, ← Finset.sum_div]
  exact div_self hS.ne'

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: the map `f ℓ` is the same on `M'` and `M` if the keys of head `i` of `M'` are those
of `M` shifted by `κ_i` and the queries and values are those of `M`: the score of `(t, s)` moves
by `q_t · κ_i / √d_h`, the same for every `s`. -/
private theorem f_keyShift_ahb (ℓ : Fin L) (M M' : Matrix T (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ)
    (κ : H ℓ → dh ℓ → ℝ)
    (hq : ∀ t i k, M' t (i, Sum.inl k) = M t (i, Sum.inl k))
    (hk : ∀ t i k, M' t (i, Sum.inr (Sum.inl k)) = M t (i, Sum.inr (Sum.inl k)) + κ i k)
    (hv : ∀ t i k, M' t (i, Sum.inr (Sum.inr k)) = M t (i, Sum.inr (Sum.inr k))) :
    (Arch.attention sees χ H dh).f ℓ M' = (Arch.attention sees χ H dh).f ℓ M := by
  -- the weights of every head are kept
  have hsc : ∀ i : H ℓ, attnWeights sees (Matrix.of fun t' s' =>
        (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (i, Sum.inl k) * M' s' (i, Sum.inr (Sum.inl k)) : Matrix T T ℝ)
      = attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (i, Sum.inl k) * M s' (i, Sum.inr (Sum.inl k))) := by
    intro i
    refine attnWeights_add_row_ahb _ _
      (fun t' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹ * ∑ k, M t' (i, Sum.inl k) * κ i k)
      fun t' s' => ?_
    simp only [Matrix.of_apply, hq, hk, mul_add, Finset.sum_add_distrib]
  ext t p
  show ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (p.1, Sum.inl k) * M' s' (p.1, Sum.inr (Sum.inl k))) t s
      * M' s (p.1, Sum.inr (Sum.inr p.2))
    = ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (p.1, Sum.inl k) * M s' (p.1, Sum.inr (Sum.inl k))) t s
      * M s (p.1, Sum.inr (Sum.inr p.2))
  rw [hsc p.1]
  simp only [hv]

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: if every token sees some token, `f ℓ M' = f ℓ M + 1 ν` when the values of head `i`
of `M'` are those of `M` shifted by `ν_i` and the queries and keys are those of `M`: the weights
are kept, and they sum to `1` on every row. -/
private theorem f_valueShift_ahb (hsee : ∀ t, ∃ s, sees t s) (ℓ : Fin L)
    (M M' : Matrix T (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ) (ν : H ℓ → dh ℓ → ℝ)
    (hq : ∀ t i k, M' t (i, Sum.inl k) = M t (i, Sum.inl k))
    (hk : ∀ t i k, M' t (i, Sum.inr (Sum.inl k)) = M t (i, Sum.inr (Sum.inl k)))
    (hv : ∀ t i k, M' t (i, Sum.inr (Sum.inr k)) = M t (i, Sum.inr (Sum.inr k)) + ν i k) :
    (Arch.attention sees χ H dh).f ℓ M'
      = (Arch.attention sees χ H dh).f ℓ M + Matrix.of fun _ (q : H ℓ × dh ℓ) => ν q.1 q.2 := by
  -- the scores of every head are kept
  have hsc : ∀ i : H ℓ, (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (i, Sum.inl k) * M' s' (i, Sum.inr (Sum.inl k)) : Matrix T T ℝ)
      = Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (i, Sum.inl k) * M s' (i, Sum.inr (Sum.inl k)) := by
    intro i
    ext t' s'
    simp only [Matrix.of_apply, hq, hk]
  ext t p
  show ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M' t' (p.1, Sum.inl k) * M' s' (p.1, Sum.inr (Sum.inl k))) t s
      * M' s (p.1, Sum.inr (Sum.inr p.2))
    = ∑ s, attnWeights sees (Matrix.of fun t' s' => (Real.sqrt (Fintype.card (dh ℓ)))⁻¹
        * ∑ k, M t' (p.1, Sum.inl k) * M s' (p.1, Sum.inr (Sum.inl k))) t s
      * M s (p.1, Sum.inr (Sum.inr p.2)) + ν p.1 p.2
  rw [hsc p.1]
  -- the weights of row `t` sum to `1`
  simp only [hv, mul_add, Finset.sum_add_distrib, ← Finset.sum_mul,
    attnWeights_sum_ahb _ t (hsee t), one_mul]

omit [DecidableEq d] in
/-- Helper: the line `τ ↦ p + τ v` has velocity `v` at `τ = 0`. -/
private theorem hasDerivAt_line_ahb (p v : ParamsB (Arch.attention sees χ H dh) dIn dOut) :
    HasDerivAt (fun τ : ℝ => p + τ • v) v 0 := by
  have h := ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add p
  rw [one_smul] at h
  exact h

omit [Fintype d] [DecidableEq d] [Fintype dIn] [Fintype dOut] in
/-- Helper: along the line `τ ↦ p + τ v`, a direction `v` with the components `E`, `D`, `b_E`
and `b_D` equal to `0` keeps these components. -/
private theorem line_comps_ahb (p v : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (hE : v.1.E = 0) (hD : v.1.D = 0) (hbE : v.2.E = 0) (hbD : v.2.D = 0) (τ : ℝ) :
    (p + τ • v).1.E = p.1.E ∧ (p + τ • v).1.D = p.1.D ∧ (p + τ • v).2.E = p.2.E ∧
      (p + τ • v).2.D = p.2.D := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · show p.1.E + τ • v.1.E = p.1.E
    rw [hE, smul_zero, add_zero]
  · show p.1.D + τ • v.1.D = p.1.D
    rw [hD, smul_zero, add_zero]
  · show p.2.E + τ • v.2.E = p.2.E
    rw [hbE, smul_zero, add_zero]
  · show p.2.D + τ • v.2.D = p.2.D
    rw [hbD, smul_zero, add_zero]

/-- **The shifts of the key biases are symmetries inside the blocks,** for every mask and every
`χ`: "The key biases drop out, since they shift all scores of a token equally". -/
theorem insideBlocksB_keyShiftDir (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (keyShiftDir κ) := by
  -- the line `τ ↦ p + τ • keyShiftDir κ`: it keeps every block
  have hb : ∀ τ : ℝ, ∀ ℓ (n : Matrix T d ℝ),
      (Arch.attention sees χ H dh).f ℓ (n * (p + τ • keyShiftDir κ).1.read ℓ
          + Matrix.of fun _ => (p + τ • keyShiftDir κ).2.read ℓ)
          * (p + τ • keyShiftDir κ).1.write ℓ
        + Matrix.of (fun _ => (p + τ • keyShiftDir κ).2.write ℓ)
      = (Arch.attention sees χ H dh).f ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ)
          * p.1.write ℓ + Matrix.of fun _ => p.2.write ℓ := by
    intro τ ℓ n
    -- the weights and the write bias do not move
    have hR : (p + τ • keyShiftDir κ).1.read ℓ = p.1.read ℓ := by
      show p.1.read ℓ + τ • (0 : Matrix d (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ) = p.1.read ℓ
      rw [smul_zero, add_zero]
    have hW : (p + τ • keyShiftDir κ).1.write ℓ = p.1.write ℓ := by
      show p.1.write ℓ + τ • (0 : Matrix (H ℓ × dh ℓ) d ℝ) = p.1.write ℓ
      rw [smul_zero, add_zero]
    have hbW : (p + τ • keyShiftDir κ).2.write ℓ = p.2.write ℓ := by
      show p.2.write ℓ + τ • (0 : d → ℝ) = p.2.write ℓ
      rw [smul_zero, add_zero]
    -- the keys of head `i` move by `τ κ_i`, the queries and values do not move
    rw [hR, hW, hbW, f_keyShift_ahb ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ) _
      (fun i k => τ * κ ℓ i k) ?_ ?_ ?_]
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inl k) + (p.2.read ℓ (i, Sum.inl k) + τ * 0)
        = (n * p.1.read ℓ) t (i, Sum.inl k) + p.2.read ℓ (i, Sum.inl k)
      rw [mul_zero, add_zero]
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inr (Sum.inl k))
          + (p.2.read ℓ (i, Sum.inr (Sum.inl k)) + τ * κ ℓ i k)
        = (n * p.1.read ℓ) t (i, Sum.inr (Sum.inl k)) + p.2.read ℓ (i, Sum.inr (Sum.inl k))
          + τ * κ ℓ i k
      rw [add_assoc]
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inr (Sum.inr k))
          + (p.2.read ℓ (i, Sum.inr (Sum.inr k)) + τ * 0)
        = (n * p.1.read ℓ) t (i, Sum.inr (Sum.inr k)) + p.2.read ℓ (i, Sum.inr (Sum.inr k))
      rw [mul_zero, add_zero]
  exact ⟨_, by rw [zero_smul, add_zero], hasDerivAt_line_ahb p _,
    Filter.Eventually.of_forall fun τ =>
      ⟨(line_comps_ahb p _ rfl rfl rfl rfl τ).1, (line_comps_ahb p _ rfl rfl rfl rfl τ).2.1,
        (line_comps_ahb p _ rfl rfl rfl rfl τ).2.2.1, (line_comps_ahb p _ rfl rfl rfl rfl τ).2.2.2,
        hb τ⟩⟩

/-- **The value biases moved into the output bias are symmetries inside the blocks,** for every
`χ` and every mask in which every token sees at least one token: "the weights of a token sum to
one", so adding `τ ν_i` to the values of head `i` adds `τ ν_i W_{O,i}` to the output of the block
at every token. -/
theorem insideBlocksB_valueShiftDir (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention sees χ H dh) dIn dOut) (ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (valueShiftDir p ν) := by
  -- the line `τ ↦ p + τ • valueShiftDir p ν`: it keeps every block
  have hb : ∀ τ : ℝ, ∀ ℓ (n : Matrix T d ℝ),
      (Arch.attention sees χ H dh).f ℓ (n * (p + τ • valueShiftDir p ν).1.read ℓ
          + Matrix.of fun _ => (p + τ • valueShiftDir p ν).2.read ℓ)
          * (p + τ • valueShiftDir p ν).1.write ℓ
        + Matrix.of (fun _ => (p + τ • valueShiftDir p ν).2.write ℓ)
      = (Arch.attention sees χ H dh).f ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ)
          * p.1.write ℓ + Matrix.of fun _ => p.2.write ℓ := by
    intro τ ℓ n
    -- the weights do not move
    have hR : (p + τ • valueShiftDir p ν).1.read ℓ = p.1.read ℓ := by
      show p.1.read ℓ + τ • (0 : Matrix d (H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) ℝ) = p.1.read ℓ
      rw [smul_zero, add_zero]
    have hW : (p + τ • valueShiftDir p ν).1.write ℓ = p.1.write ℓ := by
      show p.1.write ℓ + τ • (0 : Matrix (H ℓ × dh ℓ) d ℝ) = p.1.write ℓ
      rw [smul_zero, add_zero]
    -- the values of head `i` move by `τ ν_i`, the queries and keys do not move
    rw [hR, hW, f_valueShift_ahb hsee ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ) _
      (fun i k => τ * ν ℓ i k) ?_ ?_ ?_]
    · -- the output moves by `τ ∑_i ν_i W_{O,i}`, the write bias by the opposite
      rw [Matrix.add_mul, add_assoc]
      congr 1
      ext t c
      show (∑ q : H ℓ × dh ℓ, τ * ν ℓ q.1 q.2 * p.1.write ℓ q c)
          + (p.2.write ℓ c + τ * -∑ i, ∑ k, ν ℓ i k * p.1.write ℓ (i, k) c)
        = p.2.write ℓ c
      rw [Fintype.sum_prod_type, mul_neg, Finset.mul_sum]
      simp only [Finset.mul_sum, mul_assoc]
      ring
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inl k) + (p.2.read ℓ (i, Sum.inl k) + τ * 0)
        = (n * p.1.read ℓ) t (i, Sum.inl k) + p.2.read ℓ (i, Sum.inl k)
      rw [mul_zero, add_zero]
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inr (Sum.inl k))
          + (p.2.read ℓ (i, Sum.inr (Sum.inl k)) + τ * 0)
        = (n * p.1.read ℓ) t (i, Sum.inr (Sum.inl k)) + p.2.read ℓ (i, Sum.inr (Sum.inl k))
      rw [mul_zero, add_zero]
    · intro t i k
      show (n * p.1.read ℓ) t (i, Sum.inr (Sum.inr k))
          + (p.2.read ℓ (i, Sum.inr (Sum.inr k)) + τ * ν ℓ i k)
        = (n * p.1.read ℓ) t (i, Sum.inr (Sum.inr k)) + p.2.read ℓ (i, Sum.inr (Sum.inr k))
          + τ * ν ℓ i k
      rw [add_assoc]
  exact ⟨_, by rw [zero_smul, add_zero], hasDerivAt_line_ahb p _,
    Filter.Eventually.of_forall fun τ =>
      ⟨(line_comps_ahb p _ rfl rfl rfl rfl τ).1, (line_comps_ahb p _ rfl rfl rfl rfl τ).2.1,
        (line_comps_ahb p _ rfl rfl rfl rfl τ).2.2.1, (line_comps_ahb p _ rfl rfl rfl rfl τ).2.2.2,
        hb τ⟩⟩

/-- The direction `headDirB p (Γ, Γ', κ, ν)` is linear in `(Γ, Γ', κ, ν)`. -/
theorem isLinearMap_headDirB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut) :
    IsLinearMap ℝ (headDirB p) := by
  -- component by component, entry by entry
  constructor
  · rintro ⟨Γ, Γ', κ, ν⟩ ⟨Δ, Δ', κ', ν'⟩
    refine Prod.ext (Params.ext' ?_ (fun ℓ => ?_) (fun ℓ => ?_) ?_)
      (Biases.ext' ?_ (fun ℓ => ?_) (fun ℓ => ?_) ?_)
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK, headDirVO]
    · ext a ⟨i, k | k | k⟩ <;>
        simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK,
          headDirVO, add_mul, mul_add, Finset.sum_add_distrib]
      ring
    · ext ⟨i, k⟩ c
      simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK,
          headDirVO, add_mul, mul_add, Finset.sum_add_distrib]
      ring
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK, headDirVO]
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir]
    · funext q
      obtain ⟨i, k | k | k⟩ := q <;>
        simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, add_mul, mul_add,
          Finset.sum_add_distrib] <;> ring
    · funext c
      simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, add_mul, mul_add,
          Finset.sum_add_distrib]
      ring
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir]
  · rintro r ⟨Γ, Γ', κ, ν⟩
    refine Prod.ext (Params.ext' ?_ (fun ℓ => ?_) (fun ℓ => ?_) ?_)
      (Biases.ext' ?_ (fun ℓ => ?_) (fun ℓ => ?_) ?_)
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK, headDirVO]
    · ext a ⟨i, k | k | k⟩ <;>
        simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK,
          headDirVO, Finset.mul_sum] <;>
        exact Finset.sum_congr rfl fun _ _ => by ring
    · ext ⟨i, k⟩ c
      simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK,
          headDirVO, Finset.mul_sum]
      ring_nf
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, headDirQK, headDirVO]
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir]
    · funext q
      obtain ⟨i, k | k | k⟩ := q <;>
        simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, Finset.mul_sum] <;>
        exact Finset.sum_congr rfl fun _ _ => by ring
    · funext c
      simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir, Finset.mul_sum]
      ring_nf
    · simp [headDirB, headDirQKB, headDirVOB, keyShiftDir, valueShiftDir]

/-- Helper (the private `cancel_left_of_rank_ath` of `Symmetry/AttentionHeads.lean`): a matrix
`M` of rank equal to its number of columns cancels on the left, `M X = M Y → X = Y`. -/
private theorem cancel_left_of_rank_ahb {m n k : Type*} [Fintype n] (M : Matrix m n ℝ)
    (hM : M.rank = Fintype.card n) {X Y : Matrix n k ℝ} (h : M * X = M * Y) : X = Y := by
  -- `v ↦ M v` is injective: `rank M + dim ker M = card n`
  have hinj : Function.Injective M.mulVecLin := by
    rw [← LinearMap.ker_eq_bot, ← Submodule.finrank_eq_zero]
    have := LinearMap.finrank_range_add_finrank_ker M.mulVecLin
    rw [Module.finrank_fintype_fun_eq_card] at this
    rw [Matrix.rank] at hM
    omega
  -- compare `X` and `Y` column by column
  ext i j
  have hcol : M.mulVecLin (fun l => X l j) = M.mulVecLin (fun l => Y l j) := by
    funext q
    have := congrFun (congrFun h q) j
    simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct] using this
  exact congrFun (hinj hcol) i

/-- **The symmetries inside the attention blocks with biases act freely, in infinitesimal form:**
if the query matrix and the value matrix of every head have rank `d_h`, the direction
`headDirB p (Γ, Γ', κ, ν)` determines `Γ`, `Γ'`, `κ` and `ν`. -/
theorem headDirB_injective (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    Function.Injective (headDirB p) := by
  rintro ⟨Γ, Γ', κ, ν⟩ ⟨Δ, Δ', κ', ν'⟩ h
  have hr : ∀ ℓ a q, (headDirB p (Γ, Γ', κ, ν)).1.read ℓ a q
      = (headDirB p (Δ, Δ', κ', ν')).1.read ℓ a q := fun ℓ a q =>
    congrFun (congrFun (congrArg (fun x : ParamsB _ dIn dOut => x.1.read ℓ) h) a) q
  have hb : ∀ ℓ q, (headDirB p (Γ, Γ', κ, ν)).2.read ℓ q
      = (headDirB p (Δ, Δ', κ', ν')).2.read ℓ q := fun ℓ q =>
    congrFun (congrArg (fun x : ParamsB _ dIn dOut => x.2.read ℓ) h) q
  -- the query columns: `W_{Q,i} Γ_i = W_{Q,i} Δ_i`, and `W_{Q,i}` has rank `d_h`
  have hΓ : Γ = Δ := by
    funext ℓ i
    refine cancel_left_of_rank_ahb _ (hQ ℓ i) ?_
    ext a k
    have hk := hr ℓ a (i, Sum.inl k)
    change (∑ k', p.1.read ℓ a (i, Sum.inl k') * Γ ℓ i k' k) + 0 + 0 + 0
      = (∑ k', p.1.read ℓ a (i, Sum.inl k') * Δ ℓ i k' k) + 0 + 0 + 0 at hk
    simp only [add_zero] at hk
    exact hk
  -- the value columns: `W_{V,i} Γ'_i = W_{V,i} Δ'_i`, and `W_{V,i}` has rank `d_h`
  have hΓ' : Γ' = Δ' := by
    funext ℓ i
    refine cancel_left_of_rank_ahb _ (hV ℓ i) ?_
    ext a k
    have hk := hr ℓ a (i, Sum.inr (Sum.inr k))
    change 0 + (∑ k', p.1.read ℓ a (i, Sum.inr (Sum.inr k')) * Γ' ℓ i k' k) + 0 + 0
      = 0 + (∑ k', p.1.read ℓ a (i, Sum.inr (Sum.inr k')) * Δ' ℓ i k' k) + 0 + 0 at hk
    simp only [add_zero, zero_add] at hk
    exact hk
  -- the key biases: `−b_{K,i} Γ_i^⊤ + κ_i = −b_{K,i} Δ_i^⊤ + κ'_i`
  have hκ : κ = κ' := by
    funext ℓ i k
    have hk := hb ℓ (i, Sum.inr (Sum.inl k))
    change -(∑ k', p.2.read ℓ (i, Sum.inr (Sum.inl k')) * Γ ℓ i k k') + 0 + κ ℓ i k + 0
      = -(∑ k', p.2.read ℓ (i, Sum.inr (Sum.inl k')) * Δ ℓ i k k') + 0 + κ' ℓ i k + 0 at hk
    rw [hΓ] at hk
    simpa only [add_zero, add_right_inj] using hk
  -- the value biases: `b_{V,i} Γ'_i + ν_i = b_{V,i} Δ'_i + ν'_i`
  have hν : ν = ν' := by
    funext ℓ i k
    have hk := hb ℓ (i, Sum.inr (Sum.inr k))
    change 0 + (∑ k', p.2.read ℓ (i, Sum.inr (Sum.inr k')) * Γ' ℓ i k' k) + 0 + ν ℓ i k
      = 0 + (∑ k', p.2.read ℓ (i, Sum.inr (Sum.inr k')) * Δ' ℓ i k' k) + 0 + ν' ℓ i k at hk
    rw [hΓ'] at hk
    simpa only [add_zero, zero_add, add_right_inj] using hk
  exact Prod.ext hΓ (Prod.ext hΓ' (Prod.ext hκ hν))

/-! ### Helpers: the space of the directions `headDirB p (Γ, Γ', κ, ν)` -/

/-- Helper: the directions `headDirB p (Γ, Γ', κ, ν)` are spanned by directions of symmetries
inside the blocks, if every token sees some token: each is a sum of four such directions. -/
private theorem range_le_span_ahb (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention sees χ H dh) dIn dOut) :
    LinearMap.range (IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p))
      ≤ Submodule.span ℝ {η | InsideBlocksB (Arch.attention sees χ H dh) p η} := by
  rintro _ ⟨⟨Γ, Γ', κ, ν⟩, rfl⟩
  show headDirB p (Γ, Γ', κ, ν) ∈ _
  exact add_mem (add_mem (add_mem (Submodule.subset_span (insideBlocksB_headDirQKB p Γ))
    (Submodule.subset_span (insideBlocksB_headDirVOB p Γ')))
    (Submodule.subset_span (insideBlocksB_keyShiftDir p κ)))
    (Submodule.subset_span (insideBlocksB_valueShiftDir hsee p ν))

/-- Helper: if the read and the read bias of block `ℓ` of `headDirB p (Γ, Γ', κ, ν)` are `0`
and the value matrices have rank `d_h`, then `Γ'_ℓ = 0` (value columns) and `ν_ℓ = 0` (value
biases), so the write `−Γ' W_O` and the write bias `−∑_i ν_i W_{O,i}` of block `ℓ` are `0`. -/
private theorem hrw_ahb (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    ∀ η ∈ LinearMap.range (IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p)), ∀ ℓ,
      η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0 := by
  rintro _ ⟨⟨Γ, Γ', κ, ν⟩, rfl⟩ ℓ hr hb
  -- the value columns: `W_{V,i} Γ'_i = 0`, and `W_{V,i}` has rank `d_h`
  have hΓ' : ∀ i, Γ' ℓ i = 0 := by
    intro i
    refine cancel_left_of_rank_ahb _ (hV ℓ i) ?_
    ext a k
    have hk := congrFun (congrFun hr a) (i, Sum.inr (Sum.inr k))
    change 0 + (∑ k', p.1.read ℓ a (i, Sum.inr (Sum.inr k')) * Γ' ℓ i k' k) + 0 + 0 = 0 at hk
    rw [Matrix.mul_zero]
    simp only [add_zero, zero_add] at hk
    exact hk
  -- the value biases: `b_{V,i} Γ'_i + ν_i = 0`, so `ν_i = 0`
  have hν : ∀ i k, ν ℓ i k = 0 := by
    intro i k
    have hk := congrFun hb (i, Sum.inr (Sum.inr k))
    change 0 + (∑ k', p.2.read ℓ (i, Sum.inr (Sum.inr k')) * Γ' ℓ i k' k) + 0 + ν ℓ i k = 0
      at hk
    simpa only [hΓ', Matrix.zero_apply, mul_zero, Finset.sum_const_zero, zero_add,
      add_zero] using hk
  refine ⟨?_, ?_⟩
  · ext ⟨i, k⟩ c
    show 0 + (-∑ k', Γ' ℓ i k k' * p.1.write ℓ (i, k') c) + 0 + 0 = 0
    simp only [hΓ', Matrix.zero_apply, zero_mul, Finset.sum_const_zero, neg_zero, add_zero]
  · funext c
    show 0 + 0 + 0 + -∑ i, ∑ k, ν ℓ i k * p.1.write ℓ (i, k) c = 0
    simp only [hν, zero_mul, Finset.sum_const_zero, neg_zero, add_zero]

/-- Helper: the domain `(Γ, Γ', κ, ν)` has dimension `2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`. -/
private theorem finrank_headDom_ahb :
    Module.finrank ℝ ((∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) × (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
      × (∀ ℓ, H ℓ → dh ℓ → ℝ) × (∀ ℓ, H ℓ → dh ℓ → ℝ))
      = 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
        + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
  have h1 : Module.finrank ℝ (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2 := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_matrix, Module.finrank_self, mul_one,
      Finset.sum_const, Finset.card_univ, smul_eq_mul, sq]
  have h2 : Module.finrank ℝ (∀ ℓ, H ℓ → dh ℓ → ℝ)
      = ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) := by
    rw [Module.finrank_pi_fintype]
    simp only [Module.finrank_pi_fintype, Module.finrank_self, mul_one, Finset.sum_const,
      Finset.card_univ, smul_eq_mul]
  rw [Module.finrank_prod, Module.finrank_prod, Module.finrank_prod, h1, h2]
  ring

/-- **Lemma A.8 of the skips paper, the count with identity skips, as a bound, for attention
blocks with biases:** without normalization, for a mask in which every token sees at least one
token, if `E` has rank `d` and the query and value matrices of every head have rank `d_h`,
`fd ≤ P − d² − (L + 1) d − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`, with `P` counting the
biases. -/
theorem funDimB_add_le_residual_attention (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    funDimB (Arch.attention sees id H dh) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  -- `V`: the directions `headDirB p (Γ, Γ', κ, ν)`, of dimension `2 ∑ H d_h² + 2 ∑ H d_h`
  have h := funDimB_add_le_residual_of_insideBlocksB p rfl
    (LinearMap.range (IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p)))
    (range_le_span_ahb hsee p) (hrw_ahb p hV) hE
  rwa [LinearMap.finrank_range_of_inj
    (f := IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p)) (headDirB_injective p hQ hV),
    finrank_headDom_ahb] at h

/-- **Lemma A.8 of the skips paper, the count without skips, as a bound, for attention blocks
with biases:** without normalization, for a mask in which every token sees at least one token,
if `E` and the writes have rank `d` and the query and value matrices of every head have rank
`d_h`, `fd ≤ P − (L + 1)(d² + d) − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`, with `P` counting
the biases. -/
theorem funDimB_add_le_skipless_attention (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    funDimB (Arch.attention sees id H dh) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  -- `V`: the directions `headDirB p (Γ, Γ', κ, ν)`, of dimension `2 ∑ H d_h² + 2 ∑ H d_h`
  have h := funDimB_add_le_skipless_of_insideBlocksB p rfl
    (LinearMap.range (IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p)))
    (range_le_span_ahb hsee p) (hrw_ahb p hV) hE hw
  rwa [LinearMap.finrank_range_of_inj
    (f := IsLinearMap.mk' (headDirB p) (isLinearMap_headDirB p)) (headDirB_injective p hQ hV),
    finrank_headDom_ahb] at h

end Skips
