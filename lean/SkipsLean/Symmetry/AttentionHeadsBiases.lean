import SkipsLean.Symmetry.AttentionHeads
import SkipsLean.Symmetry.InsideBlocksBiases

/-!
# The symmetries inside an attention block with biases, and the count of Lemma A.8

Paper (skips paper), Theorem B.1 (i): "with biases on the embedding, the block and the readout,
counted in `P`, both values are `2 d_model` lower, and `2 d_model + 2 H d_h` lower for
attention." Appendix B, "Part (i) for attention blocks", Reduction: "With biases `b_E` on the
embedding, `b_{Q,i}`, `b_{K,i}`, `b_{V,i}` on the queries, keys and values, `b_O` on the output
projection and `b_D` on the readout, […] The key biases drop out, since they shift all scores of
a token equally, and the value biases enter only through `γ`, since the weights of a token sum
to one." Step 1: "This leaves `g`, `η_{b_O}` and the entries of `η` at the key and value biases
free, `2 d_model + 2 H d_h` dimensions, which the translations at `h_0` and `h_1`, the shifts of
the key biases and the value biases moved into the output bias span." Lemma A.8: "The symmetry
group generated by changes of basis, translations and the symmetries inside blocks therefore has
dimension `d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without
skips".

In the frame of `Network/Biases.lean`, an attention block of `Arch.attention` with biases has the
read bias `[b_Q | b_K | b_V]` of all heads (added to the queries, keys and values of every token)
and the write bias `b_O`. Here, for networks of attention blocks with biases, at any depth:

* `headDirQKB p Γ`, `headDirVOB p Γ'`: the directions of the changes of basis inside the heads
  (`Symmetry/AttentionHeads.lean`), which with biases also move the biases of the queries, keys
  and values: `b_{Q,i} Γ_i`, `−b_{K,i} Γ_i^⊤`, `b_{V,i} Γ'_i`.
* `keyShiftDir κ`: "the shifts of the key biases", `b_{K,i} ↦ b_{K,i} + τ κ_i`.
* `valueShiftDir p ν`: "the value biases moved into the output bias",
  `b_{V,i} ↦ b_{V,i} + τ ν_i`, `b_O ↦ b_O − τ ∑_i ν_i W_{O,i}`.
* The four are directions of symmetries inside the blocks (`InsideBlocksB`), for every mask and
  every `χ`; the last one if every token sees at least one token (then "the weights of a token
  sum to one"; a token that sees no token has all weights `0` in `attnWeights`).
* `headDirB p (Γ, Γ', κ, ν)`: their sum; it is linear in `(Γ, Γ', κ, ν)`, and injective if the
  query and value matrices of every head have rank `d_h`.
* The count of Lemma A.8 as two bounds, with `2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}` for the
  symmetries inside the blocks: with identity skips
  `fd ≤ P − d² − (L + 1) d − 2 ∑ H d_h² − 2 ∑ H d_h`, without skips
  `fd ≤ P − (L + 1)(d² + d) − 2 ∑ H d_h² − 2 ∑ H d_h`, with `P` counting the biases.

In Lemma A.8 the number `s` of an attention block with biases is thus `2 H d_h² + 2 H d_h`; the
`s = 2 H d_h²` of Theorem B.1 counts the changes of basis inside the heads only, and the theorem
names the `2 H d_h` apart. Numeric check (64 networks of one and two blocks, with and without
skips, causal mask and no mask; and a mask with a token that sees no token, where the last
direction is not flat): `attention_biases_check_2026-11-25.py`. The values at generic
parameters for one block: `OneBlock/AttentionBiasesDim.lean`.
-/

namespace Skips

open Matrix MeasureTheory Filter Topology
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {sees : T → T → Prop} [DecidableRel sees] {χ : Matrix T d ℝ → Matrix T d ℝ}
variable {H dh : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]

/-- **The direction of the changes of basis between queries and keys, with biases:**
`headDirQK θ Γ` on the weights, and `η_{b_Q,i} = b_{Q,i} Γ_i`, `η_{b_K,i} = −b_{K,i} Γ_i^⊤` on
the biases of the queries and keys of head `i`; `0` at all other biases. -/
def headDirQKB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (Γ : ∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) : ParamsB (Arch.attention sees χ H dh) dIn dOut :=
  (headDirQK p.1 Γ,
    { E := 0
      read := fun ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) =>
        match q.2 with
        | Sum.inl k => ∑ k', p.2.read ℓ (q.1, Sum.inl k') * Γ ℓ q.1 k' k
        | Sum.inr (Sum.inl k) => -∑ k', p.2.read ℓ (q.1, Sum.inr (Sum.inl k')) * Γ ℓ q.1 k k'
        | Sum.inr (Sum.inr _) => 0
      write := fun _ => 0
      D := 0 })

/-- **The direction of the changes of basis between values and outputs, with biases:**
`headDirVO θ Γ'` on the weights, and `η_{b_V,i} = b_{V,i} Γ'_i` on the biases of the values of
head `i`; `0` at all other biases. -/
def headDirVOB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (Γ : ∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) : ParamsB (Arch.attention sees χ H dh) dIn dOut :=
  (headDirVO p.1 Γ,
    { E := 0
      read := fun ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) =>
        match q.2 with
        | Sum.inl _ => 0
        | Sum.inr (Sum.inl _) => 0
        | Sum.inr (Sum.inr k) => ∑ k', p.2.read ℓ (q.1, Sum.inr (Sum.inr k')) * Γ ℓ q.1 k' k
      write := fun _ => 0
      D := 0 })

/-- **The direction of the shifts of the key biases:** `η_{b_K,i} = κ_i` for head `i` of block
`ℓ`, and `0` at all weights and all other biases. -/
noncomputable def keyShiftDir (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    ParamsB (Arch.attention sees χ H dh) dIn dOut :=
  (0,
    { E := 0
      read := fun ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) =>
        match q.2 with
        | Sum.inl _ => 0
        | Sum.inr (Sum.inl k) => κ ℓ q.1 k
        | Sum.inr (Sum.inr _) => 0
      write := fun _ => 0
      D := 0 })

/-- **The direction of the value biases moved into the output bias:** `η_{b_V,i} = ν_i` for head
`i` of block `ℓ` and `η_{b_O} = −∑_i ν_i W_{O,i}` for the write bias of block `ℓ`; `0` at all
weights and all other biases. -/
noncomputable def valueShiftDir (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) : ParamsB (Arch.attention sees χ H dh) dIn dOut :=
  (0,
    { E := 0
      read := fun ℓ (q : H ℓ × (dh ℓ ⊕ (dh ℓ ⊕ dh ℓ))) =>
        match q.2 with
        | Sum.inl _ => 0
        | Sum.inr (Sum.inl _) => 0
        | Sum.inr (Sum.inr k) => ν ℓ q.1 k
      write := fun ℓ a => -∑ i, ∑ k, ν ℓ i k * p.1.write ℓ (i, k) a
      D := 0 })

/-- **The direction of the symmetries inside the attention blocks with biases:** the sum of the
directions of the two changes of basis inside the heads, of the shifts of the key biases and of
the value biases moved into the output bias, for `q = (Γ, Γ', κ, ν)`. -/
noncomputable def headDirB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (q : (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) × (∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ)
      × (∀ ℓ, H ℓ → dh ℓ → ℝ) × (∀ ℓ, H ℓ → dh ℓ → ℝ)) :
    ParamsB (Arch.attention sees χ H dh) dIn dOut :=
  headDirQKB p q.1 + headDirVOB p q.2.1 + keyShiftDir q.2.2.1 + valueShiftDir p q.2.2.2

/-- **The changes of basis between the queries and the keys of every head are symmetries inside
the blocks of a network with biases,** for every mask and every `χ`: along
`W_{Q,i} e^{τΓ_i}`, `W_{K,i} e^{−τΓ_i^⊤}`, `b_{Q,i} e^{τΓ_i}`, `b_{K,i} e^{−τΓ_i^⊤}` the queries
`q_t = h_t W_{Q,i} + b_{Q,i}` and the keys `k_s = h_s W_{K,i} + b_{K,i}` keep the scores
`q_t k_s^⊤`. -/
theorem insideBlocksB_headDirQKB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (Γ : ∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (headDirQKB p Γ) := by
  sorry

/-- **The changes of basis between the values and the outputs of every head are symmetries
inside the blocks of a network with biases,** for every mask and every `χ`: along
`W_{V,i} e^{τΓ'_i}`, `b_{V,i} e^{τΓ'_i}`, `e^{−τΓ'_i} W_{O,i}` the output
`∑_s a_ts (h_s W_{V,i} + b_{V,i}) W_{O,i}` of every head is kept. -/
theorem insideBlocksB_headDirVOB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (Γ : ∀ ℓ, H ℓ → Matrix (dh ℓ) (dh ℓ) ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (headDirVOB p Γ) := by
  sorry

/-- **The shifts of the key biases are symmetries inside the blocks,** for every mask and every
`χ`: "The key biases drop out, since they shift all scores of a token equally". -/
theorem insideBlocksB_keyShiftDir (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (κ : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (keyShiftDir κ) := by
  sorry

/-- **The value biases moved into the output bias are symmetries inside the blocks,** for every
`χ` and every mask in which every token sees at least one token: "the weights of a token sum to
one", so adding `τ ν_i` to the values of head `i` adds `τ ν_i W_{O,i}` to the output of the block
at every token. -/
theorem insideBlocksB_valueShiftDir (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention sees χ H dh) dIn dOut) (ν : ∀ ℓ, H ℓ → dh ℓ → ℝ) :
    InsideBlocksB (Arch.attention sees χ H dh) p (valueShiftDir p ν) := by
  sorry

/-- The direction `headDirB p (Γ, Γ', κ, ν)` is linear in `(Γ, Γ', κ, ν)`. -/
theorem isLinearMap_headDirB (p : ParamsB (Arch.attention sees χ H dh) dIn dOut) :
    IsLinearMap ℝ (headDirB p) := by
  sorry

/-- **The symmetries inside the attention blocks with biases act freely, in infinitesimal form:**
if the query matrix and the value matrix of every head have rank `d_h`, the direction
`headDirB p (Γ, Γ', κ, ν)` determines `Γ`, `Γ'`, `κ` and `ν`. -/
theorem headDirB_injective (p : ParamsB (Arch.attention sees χ H dh) dIn dOut)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    Function.Injective (headDirB p) := by
  sorry

/-- **Lemma A.8 of the skips paper, the count with identity skips, as a bound, for attention
blocks with biases:** without normalization, for a mask in which every token sees at least one
token, if `E` has rank `d` and the query and value matrices of every head have rank `d_h`,
`fd ≤ P − d² − (L + 1) d − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`, with `P` counting the
biases. -/
theorem funDimB_add_le_residual_attention (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    funDimB (Arch.attention sees id H dh) 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  sorry

/-- **Lemma A.8 of the skips paper, the count without skips, as a bound, for attention blocks
with biases:** without normalization, for a mask in which every token sees at least one token,
if `E` and the writes have rank `d` and the query and value matrices of every head have rank
`d_h`, `fd ≤ P − (L + 1)(d² + d) − 2 ∑_ℓ H_ℓ d_{h,ℓ}² − 2 ∑_ℓ H_ℓ d_{h,ℓ}`, with `P` counting
the biases. -/
theorem funDimB_add_le_skipless_attention (hsee : ∀ t, ∃ s, sees t s)
    (p : ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d)
    (hQ : ∀ ℓ (i : H ℓ), ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inl k)).rank
      = Fintype.card (dh ℓ))
    (hV : ∀ ℓ (i : H ℓ),
      ((p.1.read ℓ).submatrix id fun k : dh ℓ => (i, Sum.inr (Sum.inr k))).rank
        = Fintype.card (dh ℓ)) :
    funDimB (Arch.attention sees id H dh) 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
            + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)))
      ≤ Module.finrank ℝ
          (ParamsB (Arch.attention (T := T) (d := d) sees id H dh) dIn dOut) := by
  sorry

end Skips
