import SkipsLean.Symmetry.BiasesGeneratedGroup
import SkipsLean.Symmetry.InsideBlocksSum

/-!
# The generated group of Lemma A.8 for networks with two kinds of block

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips". Section 2: "A transformer layer has two blocks,
its attention and MLP sub-layers".

A network with two kinds of block is the sum `A.sum B` of two architectures (`Network/Sum.lean`):
block `ℓ` has the read columns and the write rows of block `ℓ` of `A` and of `B`, and one write
bias. `Symmetry/BiasesGeneratedGroup.lean` has the sentence of the lemma for any family of
symmetries inside the blocks given as maps (`InsideBlocksAction`, `InsideBlocksFreeAt`). Here two
such families, one of `A` and one of `B`, give one of `A.sum B`, indexed by the pairs:

* `Biases.sumFst`, `Biases.sumSnd`: the biases of the two parts (the embedding bias, the write
  biases and the readout bias are those of the sum; the read biases are those of the part);
* `sumReplaceFst a q`, `sumReplaceSnd a q`: the weights and biases `q` of the sum with those of a
  part replaced by `a`;
* `sumLiftFst act σ`, `sumLiftSnd act σ`: a map of a family of a part, as a map of the weights and
  biases of the sum; `sumAct actA actB (σ₁, σ₂)` is the first after the second;
* `InsideBlocksLocal act Sg`: the maps of the family keep `E`, `D`, the embedding bias and the
  readout bias, keep the map `n ↦ f_ℓ(n W_read^ℓ + b_read^ℓ) W_write^ℓ + b_write^ℓ` of every
  block, keep the span of the rows of every write, and move the reads, the writes and the read
  biases through these alone, the write biases by a row that depends on these alone. The four
  kinds of family of the library have this property
  (`Symmetry/BiasesGeneratedGroupLocalRescale.lean`,
  `Symmetry/BiasesGeneratedGroupLocalAttention.lean`);
* `sumAct_parts`: what `sumAct actA actB σ` does to each part;
* `insideBlocksAction_sumAct`: the pairs form a family of symmetries inside the blocks of the
  sum; that it acts freely block by block where the two families do is in
  `Symmetry/BiasesGeneratedGroupSumFree.lean`;
* the family with one map, the identity, indexed by the space `Fin 0 → ℝ` of dimension `0`, for
  the blocks without a symmetry inside (tanh, GELU).
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A B : Arch T d L}

/-- **The biases of the first part of a network of `A.sum B`:** the read biases of the columns of
`A`; the embedding bias, the write biases and the readout bias of the sum. -/
def Biases.sumFst (b : Biases (A.sum B) dOut) : Biases A dOut where
  E := b.E
  read ℓ j := b.read ℓ (Sum.inl j)
  write := b.write
  D := b.D

/-- **The biases of the second part of a network of `A.sum B`:** the read biases of the columns
of `B`; the embedding bias, the write biases and the readout bias of the sum. -/
def Biases.sumSnd (b : Biases (A.sum B) dOut) : Biases B dOut where
  E := b.E
  read ℓ j := b.read ℓ (Sum.inr j)
  write := b.write
  D := b.D

/-- **The weights and biases `q` of `A.sum B` with those of the first part replaced by `a`:**
`E`, `D`, the embedding bias, the write biases and the readout bias of `a`; the read columns, the
write rows and the read biases of `a` at the places of `A`, and of `q` at the places of `B`. -/
def sumReplaceFst (a : Params A dIn dOut × Biases A dOut)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    Params (A.sum B) dIn dOut × Biases (A.sum B) dOut :=
  ({ E := a.1.E
     read := fun ℓ => Matrix.of fun c p =>
       Sum.elim (fun j => a.1.read ℓ c j) (fun j => q.1.read ℓ c (Sum.inr j)) p
     write := fun ℓ => Matrix.of fun p c =>
       Sum.elim (fun i => a.1.write ℓ i c) (fun i => q.1.write ℓ (Sum.inr i) c) p
     D := a.1.D },
   { E := a.2.E
     read := fun ℓ p => Sum.elim (fun j => a.2.read ℓ j) (fun j => q.2.read ℓ (Sum.inr j)) p
     write := a.2.write
     D := a.2.D })

/-- **The weights and biases `q` of `A.sum B` with those of the second part replaced by `a`.** -/
def sumReplaceSnd (a : Params B dIn dOut × Biases B dOut)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    Params (A.sum B) dIn dOut × Biases (A.sum B) dOut :=
  ({ E := a.1.E
     read := fun ℓ => Matrix.of fun c p =>
       Sum.elim (fun j => q.1.read ℓ c (Sum.inl j)) (fun j => a.1.read ℓ c j) p
     write := fun ℓ => Matrix.of fun p c =>
       Sum.elim (fun i => q.1.write ℓ (Sum.inl i) c) (fun i => a.1.write ℓ i c) p
     D := a.1.D },
   { E := a.2.E
     read := fun ℓ p => Sum.elim (fun j => q.2.read ℓ (Sum.inl j)) (fun j => a.2.read ℓ j) p
     write := a.2.write
     D := a.2.D })

/-- **A map of a family of the first part, as a map of the weights and biases of the sum:** the
first part of `q` is replaced by its image. -/
def sumLiftFst {F : Type*}
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut) (σ : F)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    Params (A.sum B) dIn dOut × Biases (A.sum B) dOut :=
  sumReplaceFst (act σ (q.1.sumFst, q.2.sumFst)) q

/-- **A map of a family of the second part, as a map of the weights and biases of the sum.** -/
def sumLiftSnd {F : Type*}
    (act : F → Params B dIn dOut × Biases B dOut → Params B dIn dOut × Biases B dOut) (σ : F)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    Params (A.sum B) dIn dOut × Biases (A.sum B) dOut :=
  sumReplaceSnd (act σ (q.1.sumSnd, q.2.sumSnd)) q

/-- **The family of the pairs:** the map of `σ₂` on the second part, then the map of `σ₁` on the
first. -/
def sumAct {F₁ F₂ : Type*}
    (actA : F₁ → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (actB : F₂ → Params B dIn dOut × Biases B dOut → Params B dIn dOut × Biases B dOut)
    (σ : F₁ × F₂) (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    Params (A.sum B) dIn dOut × Biases (A.sum B) dOut :=
  sumLiftFst actA σ.1 (sumLiftSnd actB σ.2 q)

/-- **A family of maps of the weights and biases that acts block by block:** every map `act σ`,
`σ ∈ Sg`, keeps `E`, `D`, the embedding bias and the readout bias; keeps the map
`n ↦ f_ℓ(n W_read^ℓ + b_read^ℓ) W_write^ℓ + b_write^ℓ` of every block; moves the reads, the
writes and the read biases through the reads, the writes and the read biases alone, and the write
biases by a row that depends on these alone; and keeps the span of the rows of every write. -/
structure InsideBlocksLocal {F : Type*}
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (Sg : Set F) : Prop where
  E_eq : ∀ σ ∈ Sg, ∀ q, (act σ q).1.E = q.1.E
  D_eq : ∀ σ ∈ Sg, ∀ q, (act σ q).1.D = q.1.D
  biasE_eq : ∀ σ ∈ Sg, ∀ q, (act σ q).2.E = q.2.E
  biasD_eq : ∀ σ ∈ Sg, ∀ q, (act σ q).2.D = q.2.D
  block_eq : ∀ σ ∈ Sg, ∀ (q : Params A dIn dOut × Biases A dOut) (ℓ : Fin L)
    (n : Matrix T d ℝ),
    A.f ℓ (n * (act σ q).1.read ℓ + Matrix.of fun _ => (act σ q).2.read ℓ)
          * (act σ q).1.write ℓ + Matrix.of (fun _ => (act σ q).2.write ℓ)
      = A.f ℓ (n * q.1.read ℓ + Matrix.of fun _ => q.2.read ℓ) * q.1.write ℓ
          + Matrix.of fun _ => q.2.write ℓ
  local_eq : ∀ σ ∈ Sg, ∀ q q' : Params A dIn dOut × Biases A dOut,
    q.1.read = q'.1.read → q.1.write = q'.1.write → q.2.read = q'.2.read →
      (act σ q).1.read = (act σ q').1.read ∧ (act σ q).1.write = (act σ q').1.write ∧
      (act σ q).2.read = (act σ q').2.read ∧
      (act σ q).2.write - q.2.write = (act σ q').2.write - q'.2.write
  span_write : ∀ σ ∈ Sg, ∀ (q : Params A dIn dOut × Biases A dOut) (ℓ : Fin L),
    Submodule.span ℝ (Set.range ((act σ q).1.write ℓ).row)
      = Submodule.span ℝ (Set.range (q.1.write ℓ).row)

section Sum

variable {F₁ F₂ : Type*}
  {actA : F₁ → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut}
  {actB : F₂ → Params B dIn dOut × Biases B dOut → Params B dIn dOut × Biases B dOut}
  {SgA : Set F₁} {SgB : Set F₂}

/-- **What the map of a pair does to each part:** the reads, the writes and the read biases of
the first part are moved by `actA σ₁` and those of the second by `actB σ₂`; the write biases are
moved by both rows; `E`, `D`, the embedding bias and the readout bias are kept. -/
theorem sumAct_parts (lA : InsideBlocksLocal actA SgA) (lB : InsideBlocksLocal actB SgB)
    {σ : F₁ × F₂} (hσ : σ ∈ SgA ×ˢ SgB)
    (q : Params (A.sum B) dIn dOut × Biases (A.sum B) dOut) :
    (sumAct actA actB σ q).1.sumFst.read = (actA σ.1 (q.1.sumFst, q.2.sumFst)).1.read ∧
    (sumAct actA actB σ q).1.sumFst.write = (actA σ.1 (q.1.sumFst, q.2.sumFst)).1.write ∧
    (sumAct actA actB σ q).2.sumFst.read = (actA σ.1 (q.1.sumFst, q.2.sumFst)).2.read ∧
    (sumAct actA actB σ q).1.sumSnd.read = (actB σ.2 (q.1.sumSnd, q.2.sumSnd)).1.read ∧
    (sumAct actA actB σ q).1.sumSnd.write = (actB σ.2 (q.1.sumSnd, q.2.sumSnd)).1.write ∧
    (sumAct actA actB σ q).2.sumSnd.read = (actB σ.2 (q.1.sumSnd, q.2.sumSnd)).2.read ∧
    (sumAct actA actB σ q).2.write
      = (actA σ.1 (q.1.sumFst, q.2.sumFst)).2.write
        + (actB σ.2 (q.1.sumSnd, q.2.sumSnd)).2.write - q.2.write ∧
    (sumAct actA actB σ q).1.E = q.1.E ∧ (sumAct actA actB σ q).1.D = q.1.D ∧
    (sumAct actA actB σ q).2.E = q.2.E ∧ (sumAct actA actB σ q).2.D = q.2.D := by
  obtain ⟨h1, h2⟩ := hσ
  -- after the map of `σ₂`, the first part has the reads, the writes and the read biases of the
  -- first part of `q`, so the map of `σ₁` moves them as it moves those of `q`
  obtain ⟨hr, hw, hb, hwb⟩ := lA.local_eq σ.1 h1
    ((sumLiftSnd actB σ.2 q).1.sumFst, (sumLiftSnd actB σ.2 q).2.sumFst)
    (q.1.sumFst, q.2.sumFst) rfl rfl rfl
  -- its write biases are those of `actB σ₂`, moved by the row of `actA σ₁`
  have hwb' : (sumAct actA actB σ q).2.write
      = (actA σ.1 (q.1.sumFst, q.2.sumFst)).2.write - q.2.write
        + (actB σ.2 (q.1.sumSnd, q.2.sumSnd)).2.write := eq_add_of_sub_eq hwb
  refine ⟨hr, hw, hb, rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hwb', sub_add_eq_add_sub]
  -- `E`, `D` and their biases: kept by `actB σ₂`, then by `actA σ₁`
  · exact (lA.E_eq σ.1 h1 _).trans (lB.E_eq σ.2 h2 _)
  · exact (lA.D_eq σ.1 h1 _).trans (lB.D_eq σ.2 h2 _)
  · exact (lA.biasE_eq σ.1 h1 _).trans (lB.biasE_eq σ.2 h2 _)
  · exact (lA.biasD_eq σ.1 h1 _).trans (lB.biasD_eq σ.2 h2 _)

/-- **Two families of symmetries inside the blocks, of `A` and of `B`, that act block by block
give the family of the pairs, a family of symmetries inside the blocks of `A.sum B`.** -/
theorem insideBlocksAction_sumAct (hA : InsideBlocksAction actA SgA)
    (lA : InsideBlocksLocal actA SgA) (hB : InsideBlocksAction actB SgB)
    (lB : InsideBlocksLocal actB SgB) :
    InsideBlocksAction (sumAct actA actB) (SgA ×ˢ SgB) := by
  sorry

end Sum

/-! ### Blocks without a symmetry inside: the family of the identity -/

/-- **The identity alone is a family of symmetries inside the blocks,** indexed by the space
`Fin 0 → ℝ` of dimension `0`. -/
theorem insideBlocksAction_id :
    InsideBlocksAction (A := A) (dIn := dIn) (dOut := dOut)
      (fun (_ : Fin 0 → ℝ) q => q) Set.univ := by
  -- every map of the family is the identity
  refine ⟨⟨0, Set.mem_univ _, rfl⟩, fun σ _ _ _ => ⟨σ, Set.mem_univ _, rfl⟩,
    fun σ _ => ⟨σ, Set.mem_univ _, rfl, rfl⟩, fun _ _ _ => rfl, fun _ _ _ => rfl,
    fun _ _ _ _ _ => rfl, fun _ _ _ _ => rfl⟩

/-- **It acts block by block.** -/
theorem insideBlocksLocal_id :
    InsideBlocksLocal (A := A) (dIn := dIn) (dOut := dOut)
      (fun (_ : Fin 0 → ℝ) q => q) Set.univ := by
  -- every map of the family is the identity, so it moves the write biases by `0`
  refine ⟨fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl,
    fun _ _ _ _ _ => rfl, fun _ _ q q' hr hw hb => ⟨hr, hw, hb, ?_⟩, fun _ _ _ _ => rfl⟩
  rw [sub_self, sub_self]

/-- **It acts freely block by block at every `q`.** -/
theorem insideBlocksFreeAt_id (q : Params A dIn dOut × Biases A dOut) :
    InsideBlocksFreeAt (fun (_ : Fin 0 → ℝ) q => q) Set.univ q := by
  -- the identity keeps everything, and `Fin 0 → ℝ` has one point
  exact ⟨fun _ _ => rfl, fun _ _ => rfl, fun _ _ _ _ _ => ⟨rfl, rfl⟩,
    fun σ _ τ _ _ => Subsingleton.elim σ τ⟩

end Skips
