import SkipsLean.Symmetry.InsideBlocksBiases

/-!
# Lemma A.8: the dimension of the symmetries with biases

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and
the skips remove `L d_model²` dimensions, as without biases." Its proof: "These `L + 1`
translations move the biases in independent directions, as many as in a skipless network, where
each hidden state has its own translation (Proposition A.1 (ii)). A skip ties only the linear
part of `Aff(d_model)`, which gives the counts."

`Symmetry/InsideBlocksBiases.lean` has the count as two bounds on the functional dimension. Here
the count itself, in infinitesimal form: the directions of these symmetries at a point `(θ, b)`,
which are flat (`Symmetry/BiasesFlatKinks.lean`, `InsideBlocksB.mem_flatB`), span a space of the
dimension that the lemma states, for a space `V` of directions of symmetries inside the blocks
of dimension `s` in which a direction whose read and read bias of a block are `0` has the write
and the write bias of that block `0` (the rescalings of `Symmetry/BiasesRescaleCount.lean` and
the symmetries inside attention blocks of `Symmetry/AttentionHeadsBiases.lean` under the rank
conditions stated there):

* `finrank_span_symmetryDirs_residual`: with identity skips, one change of basis `X` for all
  hidden states, the `L + 1` translations of the lemma and `V`: `d² + (L + 1) d + dim V`, if `E`
  has rank `d`;
* `finrank_span_symmetryDirs_skipless`: without skips, one change of basis and one translation
  per hidden state and `V`: `(L + 1)(d² + d) + dim V`, if `E` and the writes have rank `d`;
* `finrank_span_symmetryDirs_skipless_eq_add`: "the skips remove `L d_model²` dimensions".

The dimension of a group as a manifold is the dimension of the space of its directions at the
identity; the group itself is not stated as an object (for the changes of basis alone, without
biases, `Symmetry/CobGroup.lean` has the Hausdorff dimension of the set of matrices).
-/

namespace Skips

open Matrix
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {A : Arch T d L}

/-- **Lemma A.8, the count with identity skips:** at `p = (θ, b)` with `E` of rank `d`, the
directions of one change of basis of all hidden states, of the `L + 1` translations and of a
space `V` of directions of symmetries inside the blocks span a space of dimension
`d² + (L + 1) d + dim V`. -/
theorem finrank_span_symmetryDirs_residual (p : ParamsB A dIn dOut)
    (V : Submodule ℝ (ParamsB A dIn dOut))
    (hV : V ≤ Submodule.span ℝ {η | InsideBlocksB A p η})
    (hrw : ∀ η ∈ V, ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0)
    (hE : p.1.E.rank = Fintype.card d) :
    Module.finrank ℝ (Submodule.span ℝ {η : ParamsB A dIn dOut |
        ∃ (X : Matrix d d ℝ) (g : Fin (L + 1) → d → ℝ) (v : ParamsB A dIn dOut), v ∈ V ∧
          η = cobDirB p (fun _ => X) + (0, translateDir p.1 g) + v})
      = Fintype.card d ^ 2 + (L + 1) * Fintype.card d + Module.finrank ℝ V := by
  sorry

/-- **Lemma A.8, the count without skips:** at `p = (θ, b)` with `E` and the writes of rank `d`,
the directions of a change of basis and a translation of every hidden state and of a space `V`
of directions of symmetries inside the blocks span a space of dimension
`(L + 1)(d² + d) + dim V`. -/
theorem finrank_span_symmetryDirs_skipless (p : ParamsB A dIn dOut)
    (V : Submodule ℝ (ParamsB A dIn dOut))
    (hV : V ≤ Submodule.span ℝ {η | InsideBlocksB A p η})
    (hrw : ∀ η ∈ V, ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d) :
    Module.finrank ℝ (Submodule.span ℝ {η : ParamsB A dIn dOut |
        ∃ (X : Fin (L + 1) → Matrix d d ℝ) (g : Fin (L + 1) → d → ℝ) (v : ParamsB A dIn dOut),
          v ∈ V ∧ η = cobDirB p X + (0, translateAtDir p.1 g) + v})
      = (L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + Module.finrank ℝ V := by
  sorry

/-- **Lemma A.8, "the skips remove `L d_model²` dimensions, as without biases":** under the
hypotheses of both counts, the space of the directions of the symmetries of the skipless network
has `L d²` more dimensions than that of the residual network. -/
theorem finrank_span_symmetryDirs_skipless_eq_add (p : ParamsB A dIn dOut)
    (V : Submodule ℝ (ParamsB A dIn dOut))
    (hV : V ≤ Submodule.span ℝ {η | InsideBlocksB A p η})
    (hrw : ∀ η ∈ V, ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d) :
    Module.finrank ℝ (Submodule.span ℝ {η : ParamsB A dIn dOut |
        ∃ (X : Fin (L + 1) → Matrix d d ℝ) (g : Fin (L + 1) → d → ℝ) (v : ParamsB A dIn dOut),
          v ∈ V ∧ η = cobDirB p X + (0, translateAtDir p.1 g) + v})
      = Module.finrank ℝ (Submodule.span ℝ {η : ParamsB A dIn dOut |
          ∃ (X : Matrix d d ℝ) (g : Fin (L + 1) → d → ℝ) (v : ParamsB A dIn dOut), v ∈ V ∧
            η = cobDirB p (fun _ => X) + (0, translateDir p.1 g) + v})
        + L * Fintype.card d ^ 2 := by
  rw [finrank_span_symmetryDirs_skipless p V hV hrw hE hw,
    finrank_span_symmetryDirs_residual p V hV hrw hE]
  ring

end Skips
