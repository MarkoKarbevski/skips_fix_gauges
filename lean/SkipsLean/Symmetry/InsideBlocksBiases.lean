import SkipsLean.Symmetry.BiasesFlatKinks

/-!
# Symmetries inside the blocks of a network with biases, and the count of Lemma A.8 with `s`

Paper (skips paper), Lemma A.8 (Translations are not tied): "The symmetry group generated by
changes of basis, translations and the symmetries inside blocks therefore has dimension
`d_model² + (L + 1) d_model + s`, against `(L + 1)(d_model² + d_model) + s` without skips, and the
skips remove `L d_model²` dimensions, as without biases." Appendix B, Step 3, on the rescalings
with biases: "it scales column `i` of `W_read` and entry `i` of `b_read` by `λ_i` and row `i` of
`W_write` by `−λ_i` for ReLU, by `−2 λ_i` for ReLU², and similarly for ReGLU and for the values of
SwiGLU and GeGLU".

`Symmetry/InsideBlocks.lean` states the symmetries inside the blocks once, for any architecture,
for networks without biases. Here the same for the networks with biases of `Network/Biases.lean`:

* `InsideBlocksB A p η`: `η` is the velocity at `p = (θ, b)` of a curve of weights and biases
  that keeps `E`, `D`, the embedding bias, the readout bias and, for every block, the map
  `n ↦ f_ℓ(n W_read^ℓ + b_read^ℓ) W_write^ℓ + b_write^ℓ` of the block with its biases.
* `InsideBlocksB.mem_flatB`: such a direction is flat, for every stream (with or without skips)
  and every `χ`; its components at `E`, `D`, the embedding bias and the readout bias are `0`.
* The count of Lemma A.8 as bounds on the functional dimension, for a space `V` of directions
  spanned by such directions in which a direction whose read and read bias of a block are `0`
  has the write and the write bias of that block `0`: with identity skips
  `fd ≤ P − d² − (L + 1) d − dim V` if `E` has rank `d`; without skips
  `fd ≤ P − (L + 1)(d² + d) − dim V` if `E` and the writes have rank `d`. No normalization; any
  blocks (no differentiability is asked). The directions of the changes of basis, of the
  translations and of `V` are independent under these conditions: the embedding and its bias give
  the first matrix and the first row; if they are known up to block `ℓ`, the read and the read
  bias of block `ℓ` give those of the direction of `V`, whose write and write bias in block `ℓ`
  are then known, and the write and the write bias of block `ℓ` give the next matrix and row.

The kinds of block (`s` the number of rescalings) are in `Symmetry/BiasesRescaleCount.lean`.
-/

namespace Skips

open Matrix MeasureTheory Filter Topology
open scoped Matrix.Norms.Elementwise

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]

/-- **A direction of a symmetry inside the blocks of a network with biases:** `η` is the velocity
at `τ = 0` of a curve `γ` of weights and biases through `p = (θ, b)` along which, near `τ = 0`,
the embedding, the readout, the embedding bias and the readout bias stay those of `p`, and every
block keeps its map `n ↦ f_ℓ(n W_read^ℓ + b_read^ℓ) W_write^ℓ + b_write^ℓ`. -/
def InsideBlocksB (A : Arch T d L) (p η : ParamsB A dIn dOut) : Prop :=
  ∃ γ : ℝ → ParamsB A dIn dOut, γ 0 = p ∧ HasDerivAt γ η 0 ∧
    ∀ᶠ τ in 𝓝 (0 : ℝ), (γ τ).1.E = p.1.E ∧ (γ τ).1.D = p.1.D ∧ (γ τ).2.E = p.2.E ∧
      (γ τ).2.D = p.2.D ∧
      ∀ ℓ (n : Matrix T d ℝ),
        A.f ℓ (n * (γ τ).1.read ℓ + Matrix.of fun _ => (γ τ).2.read ℓ) * (γ τ).1.write ℓ
            + Matrix.of (fun _ => (γ τ).2.write ℓ)
          = A.f ℓ (n * p.1.read ℓ + Matrix.of fun _ => p.2.read ℓ) * p.1.write ℓ
            + Matrix.of fun _ => p.2.write ℓ

variable {A : Arch T d L} {p η : ParamsB A dIn dOut}

/-- **A symmetry inside the blocks of a network with biases preserves the function with skips
and without them:** its direction is flat for every stream and every `χ`. -/
theorem InsideBlocksB.mem_flatB (h : InsideBlocksB A p η) (S : Fin L → Matrix d d ℝ) :
    η ∈ flatB A S p := by
  sorry

/-- A direction of a symmetry inside the blocks does not move the embedding. -/
theorem InsideBlocksB.E_eq_zero (h : InsideBlocksB A p η) : η.1.E = 0 := by
  sorry

/-- A direction of a symmetry inside the blocks does not move the readout. -/
theorem InsideBlocksB.D_eq_zero (h : InsideBlocksB A p η) : η.1.D = 0 := by
  sorry

/-- A direction of a symmetry inside the blocks does not move the embedding bias. -/
theorem InsideBlocksB.biasE_eq_zero (h : InsideBlocksB A p η) : η.2.E = 0 := by
  sorry

/-- A direction of a symmetry inside the blocks does not move the readout bias. -/
theorem InsideBlocksB.biasD_eq_zero (h : InsideBlocksB A p η) : η.2.D = 0 := by
  sorry

variable (p)

/-- **Lemma A.8 of the skips paper, the count with identity skips, as a bound, for any symmetries
inside the blocks:** let `V` be a space of directions spanned by directions of symmetries inside
the blocks, in which a direction whose read and read bias of block `ℓ` are `0` has the write and
the write bias of block `ℓ` `0`. Without normalization, if `E` has rank `d`,
`fd ≤ P − d² − (L + 1) d − dim V`, with `P` counting the biases. -/
theorem funDimB_add_le_residual_of_insideBlocksB (hA : A.χ = id)
    (V : Submodule ℝ (ParamsB A dIn dOut))
    (hV : V ≤ Submodule.span ℝ {η | InsideBlocksB A p η})
    (hrw : ∀ η ∈ V, ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0)
    (hE : p.1.E.rank = Fintype.card d) :
    funDimB A 1 p
        + (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + Module.finrank ℝ V)
      ≤ Module.finrank ℝ (ParamsB A dIn dOut) := by
  sorry

/-- **Lemma A.8 of the skips paper, the count without skips, as a bound, for any symmetries
inside the blocks:** with `V` as above, without normalization, if `E` and the writes have rank
`d`, `fd ≤ P − (L + 1)(d² + d) − dim V`, with `P` counting the biases. -/
theorem funDimB_add_le_skipless_of_insideBlocksB (hA : A.χ = id)
    (V : Submodule ℝ (ParamsB A dIn dOut))
    (hV : V ≤ Submodule.span ℝ {η | InsideBlocksB A p η})
    (hrw : ∀ η ∈ V, ∀ ℓ, η.1.read ℓ = 0 → η.2.read ℓ = 0 → η.1.write ℓ = 0 ∧ η.2.write ℓ = 0)
    (hE : p.1.E.rank = Fintype.card d) (hw : ∀ ℓ, (p.1.write ℓ).rank = Fintype.card d) :
    funDimB A 0 p
        + ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + Module.finrank ℝ V)
      ≤ Module.finrank ℝ (ParamsB A dIn dOut) := by
  sorry

end Skips
