import SkipsLean.Symmetry.BiasesGeneratedGroupSumFree
import SkipsLean.Symmetry.BiasesGeneratedGroupLocalRescale
import SkipsLean.Symmetry.BiasesGeneratedGroupLocalAttention
import SkipsLean.Symmetry.BiasesGeneratedGroupGeneric
import SkipsLean.Generic.Sum
import SkipsLean.Network.Transformer

/-!
# The generated group of Lemma A.8 for transformers

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips". Section 2: "A transformer layer has two blocks,
its attention and MLP sub-layers".

`Symmetry/BiasesGeneratedGroupGeneric.lean` has the sentence as one statement at almost every
weight for a family of symmetries inside the blocks; `Symmetry/BiasesGeneratedGroupSum.lean` and
`Symmetry/BiasesGeneratedGroupSumFree.lean` have the family of the pairs for a network with two
kinds of block. Here:

* `GeneratedGroupResidual A act Sg μ n`, `GeneratedGroupSkipless A act Sg μ n`: the sentence for
  the architecture `A`, the family `act σ`, `σ ∈ Sg`, and the number `n`, as three statements:
  the subgroup generated by the maps of the pairs `(G, g)` that preserve the function and by the
  family is the set of the products; at `μ`-almost every weight and every bias the products are
  parametrized injectively by the pairs `(p, σ)`; the set of these pairs has Hausdorff dimension
  `n`;
* `generatedGroupResidual_of_free`, `generatedGroupSkipless_of_free`: the two theorems of
  `Symmetry/BiasesGeneratedGroupGeneric.lean` in this form;
* `ae_insideBlocksFreeAt_sumAct`, `generatedGroupResidual_sum`, `generatedGroupSkipless_sum`: for
  `A.sum B` and two families that act block by block, and freely at almost every weight of `A`
  and of `B`: `n = d² + (L + 1) d + dim F₁ + dim F₂`, without skips
  `(L + 1)(d² + d) + dim F₁ + dim F₂`;
* networks of attention blocks with biases and MLP blocks, in any order, without normalization
  (`Arch.attentionMlp`): with an activation that is positively homogeneous (ReLU, ReLU²),
  `s = 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ} + ∑_ℓ d_hidden^ℓ`; with the symmetries inside the
  attention blocks alone (tanh, GELU), `s = 2 ∑_ℓ H_ℓ d_{h,ℓ}² + 2 ∑_ℓ H_ℓ d_{h,ℓ}`;
* networks of attention blocks with biases and gated blocks (`Arch.attentionGated`): with the
  rescalings of the values (SwiGLU, GeGLU), the same `s` as for ReLU; with those of the values
  and the gates (ReGLU), `2 ∑_ℓ d_hidden^ℓ` in place of `∑_ℓ d_hidden^ℓ`.

Hypotheses of the transformer statements: every token sees a token; `d_in ≥ d ≥ 1`; `d_h ≤ d`;
with skips `T` and `d_out` not empty; without skips every block has `H d_h + d_hidden ≥ d`.
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]

/-- **The second sentence of Lemma A.8 for a residual network of the architecture `A`, a family
`act σ`, `σ ∈ Sg`, of symmetries inside the blocks, and the number `n`:** the subgroup of the
permutations of the weights and biases generated by the maps of the pairs `(G, g)` that preserve
the function and by the family is the set of the products `affActResidual p ∘ act σ`; at
`μ`-almost every weight and every bias `(p, σ) ↦ affActResidual p (act σ (θ, b))` is injective on
the pairs that preserve the function and `σ ∈ Sg`; and the set of these `(p, σ)` has Hausdorff
dimension `n`. -/
def GeneratedGroupResidual (A : Arch T d L) {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (Sg : Set F) (μ : Measure (Params A dIn dOut)) (n : ℕ) : Prop :=
  (∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
      φ ∈ Subgroup.closure
          ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
              ∃ p ∈ affPreservingResidual A dIn dOut, ⇑φ = affActResidual p}
            ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
        ↔ ∃ p ∈ affPreservingResidual A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActResidual p ∘ act σ) ∧
    (∀ᵐ θ ∂μ, ∀ b : Biases A dOut, Set.InjOn
      (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActResidual x.1 (act x.2 (θ, b)))
      (affPreservingResidual A dIn dOut ×ˢ Sg)) ∧
    dimH (affMat (affPreservingResidual A dIn dOut) ×ˢ Sg) = ((n : ℕ) : ℝ≥0∞)

/-- **The same sentence for the network without skips.** -/
def GeneratedGroupSkipless (A : Arch T d L) {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut)
    (Sg : Set F) (μ : Measure (Params A dIn dOut)) (n : ℕ) : Prop :=
  (∀ φ : Equiv.Perm (Params A dIn dOut × Biases A dOut),
      φ ∈ Subgroup.closure
          ({φ : Equiv.Perm (Params A dIn dOut × Biases A dOut) |
              ∃ p ∈ affPreservingSkipless A dIn dOut, ⇑φ = affActSkipless p}
            ∪ {φ | ∃ σ ∈ Sg, ⇑φ = act σ})
        ↔ ∃ p ∈ affPreservingSkipless A dIn dOut, ∃ σ ∈ Sg, ⇑φ = affActSkipless p ∘ act σ) ∧
    (∀ᵐ θ ∂μ, ∀ b : Biases A dOut, Set.InjOn
      (fun x : ((Fin (L + 1) → GL d ℝ) × (Fin (L + 1) → d → ℝ)) × F =>
        affActSkipless x.1 (act x.2 (θ, b)))
      (affPreservingSkipless A dIn dOut ×ˢ Sg)) ∧
    dimH (affMat (affPreservingSkipless A dIn dOut) ×ˢ Sg) = ((n : ℕ) : ℝ≥0∞)

section General

variable {A B : Arch T d L}
  {F F₁ F₂ : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
  [NormedAddCommGroup F₁] [NormedSpace ℝ F₁] [FiniteDimensional ℝ F₁]
  [NormedAddCommGroup F₂] [NormedSpace ℝ F₂] [FiniteDimensional ℝ F₂]
  {act : F → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut} {Sg : Set F}
  {actA : F₁ → Params A dIn dOut × Biases A dOut → Params A dIn dOut × Biases A dOut}
  {actB : F₂ → Params B dIn dOut × Biases B dOut → Params B dIn dOut × Biases B dOut}
  {SgA : Set F₁} {SgB : Set F₂}

/-- **`generatedGroup_residual` in this form:** for a family that acts freely block by block at
almost every weight, `n = d² + (L + 1) d + dim F`. -/
theorem generatedGroupResidual_of_free [Nonempty T] [Nonempty dOut] (hA : A.χ = id)
    (hact : InsideBlocksAction act Sg) (hS : IsOpen Sg) (hne : Sg.Nonempty)
    (μ : Measure (Params A dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hfree : ∀ᵐ θ ∂μ, ∀ b : Biases A dOut, InsideBlocksFreeAt act Sg (θ, b)) :
    GeneratedGroupResidual A act Sg μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d + Module.finrank ℝ F) :=
  generatedGroup_residual hA hact hS hne μ hdIn hfree

/-- **`generatedGroup_skipless` in this form:** `n = (L + 1)(d² + d) + dim F`. -/
theorem generatedGroupSkipless_of_free (hA : A.χ = id)
    (hact : InsideBlocksAction act Sg) (hS : IsOpen Sg) (hne : Sg.Nonempty)
    (μ : Measure (Params A dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hw : ∀ ℓ, Fintype.card d ≤ Fintype.card (A.w ℓ))
    (hfree : ∀ᵐ θ ∂μ, ∀ b : Biases A dOut, InsideBlocksFreeAt act Sg (θ, b)) :
    GeneratedGroupSkipless A act Sg μ
      ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + Module.finrank ℝ F) :=
  generatedGroup_skipless hA hact hS hne μ hdIn hw hfree

omit [NormedAddCommGroup F₁] [NormedSpace ℝ F₁] [FiniteDimensional ℝ F₁] [NormedAddCommGroup F₂]
  [NormedSpace ℝ F₂] [FiniteDimensional ℝ F₂] in
/-- **The family of the pairs acts freely block by block at almost every weight of `A.sum B`,**
if the two families do at almost every weight of `A` and of `B`. -/
theorem ae_insideBlocksFreeAt_sumAct (hA : InsideBlocksAction actA SgA)
    (lA : InsideBlocksLocal actA SgA) (hB : InsideBlocksAction actB SgB)
    (lB : InsideBlocksLocal actB SgB)
    (μ : Measure (Params (A.sum B) dIn dOut)) [μ.IsAddHaarMeasure]
    (fA : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params A dIn dOut)), ∀ b : Biases A dOut,
      InsideBlocksFreeAt actA SgA (θ, b))
    (fB : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params B dIn dOut)), ∀ b : Biases B dOut,
      InsideBlocksFreeAt actB SgB (θ, b)) :
    ∀ᵐ θ ∂μ, ∀ b : Biases (A.sum B) dOut,
      InsideBlocksFreeAt (sumAct actA actB) (SgA ×ˢ SgB) (θ, b) := by
  filter_upwards [ae_sumFst μ fA, ae_sumSnd μ fB] with θ h1 h2 b
  exact insideBlocksFreeAt_sumAct hA lA hB lB (θ, b) (h1 b.sumFst) (h2 b.sumSnd)

/-- **Lemma A.8, second sentence, with skips, for a network with two kinds of block:** for two
families of symmetries inside the blocks that act block by block, and freely at almost every
weight, `n = d² + (L + 1) d + dim F₁ + dim F₂`. -/
theorem generatedGroupResidual_sum [Nonempty T] [Nonempty dOut] (hχ : A.χ = id)
    (hA : InsideBlocksAction actA SgA) (lA : InsideBlocksLocal actA SgA)
    (hB : InsideBlocksAction actB SgB) (lB : InsideBlocksLocal actB SgB)
    (hSA : IsOpen SgA) (hneA : SgA.Nonempty) (hSB : IsOpen SgB) (hneB : SgB.Nonempty)
    (μ : Measure (Params (A.sum B) dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (fA : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params A dIn dOut)), ∀ b : Biases A dOut,
      InsideBlocksFreeAt actA SgA (θ, b))
    (fB : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params B dIn dOut)), ∀ b : Biases B dOut,
      InsideBlocksFreeAt actB SgB (θ, b)) :
    GeneratedGroupResidual (A.sum B) (sumAct actA actB) (SgA ×ˢ SgB) μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
        + (Module.finrank ℝ F₁ + Module.finrank ℝ F₂)) := by
  have h := generatedGroup_residual (A := A.sum B) hχ (insideBlocksAction_sumAct hA lA hB lB)
    (hSA.prod hSB) (hneA.prod hneB) μ hdIn (ae_insideBlocksFreeAt_sumAct hA lA hB lB μ fA fB)
  rw [Module.finrank_prod] at h
  exact h

/-- **The same without skips,** for blocks with at least `d` write rows in all:
`n = (L + 1)(d² + d) + dim F₁ + dim F₂`. -/
theorem generatedGroupSkipless_sum (hχ : A.χ = id)
    (hA : InsideBlocksAction actA SgA) (lA : InsideBlocksLocal actA SgA)
    (hB : InsideBlocksAction actB SgB) (lB : InsideBlocksLocal actB SgB)
    (hSA : IsOpen SgA) (hneA : SgA.Nonempty) (hSB : IsOpen SgB) (hneB : SgB.Nonempty)
    (μ : Measure (Params (A.sum B) dIn dOut)) [μ.IsAddHaarMeasure]
    (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hw : ∀ ℓ, Fintype.card d ≤ Fintype.card (A.w ℓ) + Fintype.card (B.w ℓ))
    (fA : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params A dIn dOut)), ∀ b : Biases A dOut,
      InsideBlocksFreeAt actA SgA (θ, b))
    (fB : ∀ᵐ θ ∂(Measure.addHaar : Measure (Params B dIn dOut)), ∀ b : Biases B dOut,
      InsideBlocksFreeAt actB SgB (θ, b)) :
    GeneratedGroupSkipless (A.sum B) (sumAct actA actB) (SgA ×ˢ SgB) μ
      ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
        + (Module.finrank ℝ F₁ + Module.finrank ℝ F₂)) := by
  have hw' : ∀ ℓ, Fintype.card d ≤ Fintype.card ((A.sum B).w ℓ) := fun ℓ => by
    show Fintype.card d ≤ Fintype.card (A.w ℓ ⊕ B.w ℓ)
    rw [Fintype.card_sum]
    exact hw ℓ
  have h := generatedGroup_skipless (A := A.sum B) hχ (insideBlocksAction_sumAct hA lA hB lB)
    (hSA.prod hSB) (hneA.prod hneB) μ hdIn hw'
    (ae_insideBlocksFreeAt_sumAct hA lA hB lB μ fA fB)
  rw [Module.finrank_prod] at h
  exact h

end General

section Transformer

variable {sees : T → T → Prop} [DecidableRel sees]
variable {H dh hid : Fin L → Type} [∀ ℓ, Fintype (H ℓ)] [∀ ℓ, Fintype (dh ℓ)]
  [∀ ℓ, DecidableEq (dh ℓ)] [∀ ℓ, Fintype (hid ℓ)] {σ : ℝ → ℝ}

/-- **Lemma A.8, second sentence, with skips, for networks of attention blocks with biases and MLP
blocks with a positively homogeneous activation (ReLU, ReLU²):** `n = d² + (L + 1) d + s`. -/
theorem generatedGroupResidual_attentionMlp [Nonempty T] [Nonempty dOut] [Nonempty d] {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    GeneratedGroupResidual (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct (rescaleMlpAct k)) (headsSet H dh ×ˢ posRescalings hid) μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) + ∑ ℓ, Fintype.card (hid ℓ))) := by
  have h := generatedGroupResidual_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.mlp σ id hid) (actB := (rescaleMlpAct k)) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    (insideBlocksAction_rescaleMlp hσ) (insideBlocksLocal_rescaleMlp hσ)
    isOpen_headsSet headsSet_nonempty isOpen_posRescalings posRescalings_nonempty μ hdIn
    (ae_insideBlocksFreeAt_heads _ hdh) (ae_insideBlocksFreeAt_rescaleMlp k _)
  rw [finrank_headsSpace, finrank_rescalings] at h
  exact h

/-- **Lemma A.8, second sentence, without skips, for networks of attention blocks with biases and
MLP blocks with a positively homogeneous activation (ReLU, ReLU²):** `n = (L + 1)(d² + d) + s`,
when every block has `H d_h + d_hidden ≥ d`. -/
theorem generatedGroupSkipless_attentionMlp [Nonempty d] {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d)
    (hw : ∀ ℓ,
      Fintype.card d ≤ Fintype.card (H ℓ) * Fintype.card (dh ℓ) + Fintype.card (hid ℓ)) :
    GeneratedGroupSkipless (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct (rescaleMlpAct k)) (headsSet H dh ×ˢ posRescalings hid) μ
      ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) + ∑ ℓ, Fintype.card (hid ℓ))) := by
  have h := generatedGroupSkipless_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.mlp σ id hid) (actB := (rescaleMlpAct k)) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    (insideBlocksAction_rescaleMlp hσ) (insideBlocksLocal_rescaleMlp hσ)
    isOpen_headsSet headsSet_nonempty isOpen_posRescalings posRescalings_nonempty μ hdIn
    (fun ℓ => by
      show Fintype.card d ≤ Fintype.card (H ℓ × dh ℓ) + Fintype.card (hid ℓ)
      rw [Fintype.card_prod]
      exact hw ℓ)
    (ae_insideBlocksFreeAt_heads _ hdh) (ae_insideBlocksFreeAt_rescaleMlp k _)
  rw [finrank_headsSpace, finrank_rescalings] at h
  exact h

/-- **Lemma A.8, second sentence, with skips, for networks of attention blocks with biases and MLP
blocks with any activation, with the symmetries inside the attention blocks alone (tanh, GELU):**
`n = d² + (L + 1) d + s`. -/
theorem generatedGroupResidual_attentionMlp_id [Nonempty T] [Nonempty dOut]
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    GeneratedGroupResidual (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct (fun (_ : Fin 0 → ℝ) q => q)) (headsSet H dh ×ˢ Set.univ) μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ))) := by
  have h := generatedGroupResidual_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.mlp σ id hid) (actB := (fun (_ : Fin 0 → ℝ) q => q)) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    insideBlocksAction_id insideBlocksLocal_id
    isOpen_headsSet headsSet_nonempty isOpen_univ Set.univ_nonempty μ hdIn
    (ae_insideBlocksFreeAt_heads _ hdh)
    (Filter.Eventually.of_forall fun θ b => insideBlocksFreeAt_id (θ, b))
  rw [finrank_headsSpace, Module.finrank_fin_fun, add_zero] at h
  exact h

/-- **Lemma A.8, second sentence, without skips, for networks of attention blocks with biases and
MLP blocks with any activation, with the symmetries inside the attention blocks alone (tanh,
GELU):** `n = (L + 1)(d² + d) + s`, when every block has `H d_h + d_hidden ≥ d`. -/
theorem generatedGroupSkipless_attentionMlp_id
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d)
    (hw : ∀ ℓ,
      Fintype.card d ≤ Fintype.card (H ℓ) * Fintype.card (dh ℓ) + Fintype.card (hid ℓ)) :
    GeneratedGroupSkipless (Arch.attentionMlp (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct (fun (_ : Fin 0 → ℝ) q => q)) (headsSet H dh ×ˢ Set.univ) μ
      ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ))) := by
  have h := generatedGroupSkipless_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.mlp σ id hid) (actB := (fun (_ : Fin 0 → ℝ) q => q)) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    insideBlocksAction_id insideBlocksLocal_id
    isOpen_headsSet headsSet_nonempty isOpen_univ Set.univ_nonempty μ hdIn
    (fun ℓ => by
      show Fintype.card d ≤ Fintype.card (H ℓ × dh ℓ) + Fintype.card (hid ℓ)
      rw [Fintype.card_prod]
      exact hw ℓ)
    (ae_insideBlocksFreeAt_heads _ hdh)
    (Filter.Eventually.of_forall fun θ b => insideBlocksFreeAt_id (θ, b))
  rw [finrank_headsSpace, Module.finrank_fin_fun, add_zero] at h
  exact h

/-- **Lemma A.8, second sentence, with skips, for networks of attention blocks with biases and
gated blocks with any gate, with the rescalings of the values (SwiGLU, GeGLU):** `n = d² + (L + 1)
d + s`. -/
theorem generatedGroupResidual_attentionGated [Nonempty T] [Nonempty dOut] [Nonempty d]
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    GeneratedGroupResidual (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct rescaleAct) (headsSet H dh ×ˢ posRescalings hid) μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) + ∑ ℓ, Fintype.card (hid ℓ))) := by
  have h := generatedGroupResidual_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.gated σ id hid) (actB := rescaleAct) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    insideBlocksAction_rescale insideBlocksLocal_rescale
    isOpen_headsSet headsSet_nonempty isOpen_posRescalings posRescalings_nonempty μ hdIn
    (ae_insideBlocksFreeAt_heads _ hdh) (ae_insideBlocksFreeAt_rescale _)
  rw [finrank_headsSpace, finrank_rescalings] at h
  exact h

/-- **Lemma A.8, second sentence, without skips, for networks of attention blocks with biases and
gated blocks with any gate, with the rescalings of the values (SwiGLU, GeGLU):** `n = (L + 1)(d² +
d) + s`, when every block has `H d_h + d_hidden ≥ d`. -/
theorem generatedGroupSkipless_attentionGated [Nonempty d]
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d)
    (hw : ∀ ℓ,
      Fintype.card d ≤ Fintype.card (H ℓ) * Fintype.card (dh ℓ) + Fintype.card (hid ℓ)) :
    GeneratedGroupSkipless (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct rescaleAct) (headsSet H dh ×ˢ posRescalings hid) μ
      ((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) + ∑ ℓ, Fintype.card (hid ℓ))) := by
  have h := generatedGroupSkipless_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.gated σ id hid) (actB := rescaleAct) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    insideBlocksAction_rescale insideBlocksLocal_rescale
    isOpen_headsSet headsSet_nonempty isOpen_posRescalings posRescalings_nonempty μ hdIn
    (fun ℓ => by
      show Fintype.card d ≤ Fintype.card (H ℓ × dh ℓ) + Fintype.card (hid ℓ)
      rw [Fintype.card_prod]
      exact hw ℓ)
    (ae_insideBlocksFreeAt_heads _ hdh) (ae_insideBlocksFreeAt_rescale _)
  rw [finrank_headsSpace, finrank_rescalings] at h
  exact h

/-- **Lemma A.8, second sentence, with skips, for networks of attention blocks with biases and
gated blocks with a positively homogeneous gate, with the rescalings of the values and of the
gates (ReGLU):** `n = d² + (L + 1) d + s`. -/
theorem generatedGroupResidual_attentionGated_both [Nonempty T] [Nonempty dOut] [Nonempty d] {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z)
    (hsee : ∀ t, ∃ s, sees t s)
    (μ : Measure (Params (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid) dIn dOut))
    [μ.IsAddHaarMeasure] (hdIn : Fintype.card d ≤ Fintype.card dIn)
    (hdh : ∀ ℓ, Fintype.card (dh ℓ) ≤ Fintype.card d) :
    GeneratedGroupResidual (Arch.attentionGated (T := T) (d := d) sees σ id H dh hid)
      (sumAct headsAct (rescaleBothAct k))
      (headsSet H dh ×ˢ (posRescalings hid ×ˢ posRescalings hid)) μ
      (Fintype.card d ^ 2 + (L + 1) * Fintype.card d
        + (2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ) ^ 2
          + 2 * ∑ ℓ, Fintype.card (H ℓ) * Fintype.card (dh ℓ)
          + 2 * ∑ ℓ, Fintype.card (hid ℓ))) := by
  have h := generatedGroupResidual_sum (A := Arch.attention (T := T) (d := d) sees id H dh)
    (B := Arch.gated σ id hid) (actB := (rescaleBothAct k)) rfl
    (insideBlocksAction_heads hsee) (insideBlocksLocal_heads hsee)
    (insideBlocksAction_rescaleBoth hσ) (insideBlocksLocal_rescaleBoth hσ)
    isOpen_headsSet headsSet_nonempty (isOpen_posRescalings.prod isOpen_posRescalings)
    (posRescalings_nonempty.prod posRescalings_nonempty) μ hdIn
    (ae_insideBlocksFreeAt_heads _ hdh) (ae_insideBlocksFreeAt_rescaleBoth k _)
  rw [finrank_headsSpace, Module.finrank_prod, finrank_rescalings, ← two_mul] at h
  exact h

/-- **Lemma A.8, second sentence, without skips, for networks of attention blocks with biases and
