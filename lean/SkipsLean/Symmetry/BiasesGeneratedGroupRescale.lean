import SkipsLean.Symmetry.BiasesGeneratedGroup
import SkipsLean.Symmetry.BiasesRescale

/-!
# The generated group of Lemma A.8 for blocks whose symmetries are rescalings

Paper (skips paper), Lemma A.8: "The symmetry group generated by changes of basis, translations
and the symmetries inside blocks therefore has dimension `d_model² + (L + 1) d_model + s`, against
`(L + 1)(d_model² + d_model) + s` without skips". The symmetries inside the blocks (Section 4.1):
"the rescaling of a hidden unit of a ReLU or ReLU² block, the rescaling of the value of a hidden
unit of a gated block", and for ReGLU also of its gate (Appendix A.6).

`Symmetry/BiasesGeneratedGroup.lean` has the lemma's sentence for any family of symmetries inside
the blocks given as maps (`InsideBlocksAction`, `InsideBlocksFreeAt`). Here the three families of
rescalings, with biases, are such families, indexed by the positive rescalings (an open set of a
vector space of dimension `s`):

* MLP blocks with an activation that is positively homogeneous of degree `k` (ReLU, ReLU²): the
  read column and the read bias of a unit times `c`, its write row times `c^{-k}`;
  `s = ∑_ℓ d_hidden^ℓ`;
* gated blocks with any gate (SwiGLU, GeGLU): the value column and the value bias of a unit times
  `c⁻¹`, its write row times `c`; `s = ∑_ℓ d_hidden^ℓ`;
* gated blocks with a positively homogeneous gate (ReGLU): the values and the gates;
  `s = 2 ∑_ℓ d_hidden^ℓ`.

Each acts freely block by block at weights with no zero read column (for gated blocks: no zero
value column; for ReGLU: no zero gate or value column). The dimensions of the generated groups
follow. For tanh and GELU blocks `s = 0` and the generated group is the group of the changes of
basis and translations (`Symmetry/BiasesAffineGroupLaw.lean`).
-/

namespace Skips

open Matrix MeasureTheory
open scoped Matrix.Norms.Elementwise ENNReal

variable {T d dIn dOut : Type*} {L : ℕ} [Fintype T] [Fintype d] [DecidableEq d] [Fintype dIn]
  [Fintype dOut]
variable {σ : ℝ → ℝ} {χ : Matrix T d ℝ → Matrix T d ℝ} {hid : Fin L → Type}
  [∀ ℓ, Fintype (hid ℓ)]

/-- **The positive rescalings:** one positive number per hidden unit. -/
def posRescalings (hid : Fin L → Type) : Set (∀ ℓ, hid ℓ → ℝ) := {c | ∀ ℓ i, 0 < c ℓ i}

/-- The positive rescalings are an open set. -/
theorem isOpen_posRescalings : IsOpen (posRescalings hid) := by
  sorry

/-- The positive rescalings are not empty. -/
theorem posRescalings_nonempty : (posRescalings hid).Nonempty := by
  sorry

/-- The space of the rescalings has dimension `∑_ℓ d_hidden^ℓ`. -/
theorem finrank_rescalings :
    Module.finrank ℝ (∀ ℓ, hid ℓ → ℝ) = ∑ ℓ, Fintype.card (hid ℓ) := by
  sorry

/-! ### MLP blocks with a positively homogeneous activation -/

/-- **The map of the rescaling `c` of the hidden units of MLP blocks, with biases.** -/
noncomputable def rescaleMlpAct (k : ℕ) (c : ∀ ℓ, hid ℓ → ℝ)
    (q : Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut) :
    Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut :=
  (q.1.rescaleMlp k c, q.2.rescaleMlp c)

/-- **The rescalings of the hidden units are a family of symmetries inside the blocks,** for an
activation that is positively homogeneous of degree `k`. -/
theorem insideBlocksAction_rescaleMlp {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z) :
    InsideBlocksAction (A := Arch.mlp (T := T) (d := d) σ χ hid) (dIn := dIn) (dOut := dOut)
      (rescaleMlpAct k) (posRescalings hid) := by
  sorry

/-- **They act freely block by block at weights with no zero read column.** -/
theorem insideBlocksFreeAt_rescaleMlp (k : ℕ)
    (q : Params (Arch.mlp (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.mlp (T := T) (d := d) σ χ hid) dOut)
    (hcol : ∀ ℓ i, ∃ a, q.1.read ℓ a i ≠ 0) :
    InsideBlocksFreeAt (rescaleMlpAct k) (posRescalings hid) q := by
  sorry

/-- **Lemma A.8 for MLP blocks with rescalings, with skips:** the pairs `(G, g)` that preserve
the function and the positive rescalings form a set of dimension
`d² + (L + 1) d + ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_residual_mlp [Nonempty T] [Nonempty dOut] :
    dimH (affMat (affPreservingResidual (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ posRescalings hid)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ) : ℕ)
          : ℝ≥0∞) := by
  sorry

/-- **The same without skips:** dimension `(L + 1)(d² + d) + ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_skipless_mlp :
    dimH (affMat (affPreservingSkipless (Arch.mlp (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ posRescalings hid)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ) : ℕ)
          : ℝ≥0∞) := by
  sorry

/-! ### Gated blocks: the values -/

/-- **The map of the rescaling `c` of the values of gated units, with biases.** -/
noncomputable def rescaleAct (c : ∀ ℓ, hid ℓ → ℝ)
    (q : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut) :
    Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut :=
  (q.1.rescale c, q.2.rescale c)

/-- **The rescalings of the values are a family of symmetries inside the blocks,** for any
gate. -/
theorem insideBlocksAction_rescale :
    InsideBlocksAction (A := Arch.gated (T := T) (d := d) σ χ hid) (dIn := dIn) (dOut := dOut)
      rescaleAct (posRescalings hid) := by
  sorry

/-- **They act freely block by block at weights with no zero value column.** -/
theorem insideBlocksFreeAt_rescale
    (q : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut)
    (hcol : ∀ ℓ i, ∃ a, q.1.read ℓ a (Sum.inr i) ≠ 0) :
    InsideBlocksFreeAt rescaleAct (posRescalings hid) q := by
  sorry

/-- **Lemma A.8 for gated blocks, with skips:** dimension `d² + (L + 1) d + ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_residual_gated [Nonempty T] [Nonempty dOut] :
    dimH (affMat (affPreservingResidual (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ posRescalings hid)
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d + ∑ ℓ, Fintype.card (hid ℓ) : ℕ)
          : ℝ≥0∞) := by
  sorry

/-- **The same without skips:** dimension `(L + 1)(d² + d) + ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_skipless_gated :
    dimH (affMat (affPreservingSkipless (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ posRescalings hid)
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d) + ∑ ℓ, Fintype.card (hid ℓ) : ℕ)
          : ℝ≥0∞) := by
  sorry

/-! ### Gated blocks with a positively homogeneous gate (ReGLU): the values and the gates -/

/-- **The map of the rescaling `c.1` of the values and `c.2` of the gates of gated units, with
biases.** -/
noncomputable def rescaleBothAct (k : ℕ) (c : (∀ ℓ, hid ℓ → ℝ) × (∀ ℓ, hid ℓ → ℝ))
    (q : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut) :
    Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut :=
  ((q.1.rescale c.1).rescaleGate k c.2, (q.2.rescale c.1).rescaleGate c.2)

/-- **The rescalings of the values and of the gates are a family of symmetries inside the
blocks,** for a gate that is positively homogeneous of degree `k`. -/
theorem insideBlocksAction_rescaleBoth {k : ℕ}
    (hσ : ∀ lam z : ℝ, 0 < lam → σ (lam * z) = lam ^ k * σ z) :
    InsideBlocksAction (A := Arch.gated (T := T) (d := d) σ χ hid) (dIn := dIn) (dOut := dOut)
      (rescaleBothAct k) (posRescalings hid ×ˢ posRescalings hid) := by
  sorry

/-- **They act freely block by block at weights with no zero gate column and no zero value
column.** -/
theorem insideBlocksFreeAt_rescaleBoth (k : ℕ)
    (q : Params (Arch.gated (T := T) (d := d) σ χ hid) dIn dOut
      × Biases (Arch.gated (T := T) (d := d) σ χ hid) dOut)
    (hgate : ∀ ℓ i, ∃ a, q.1.read ℓ a (Sum.inl i) ≠ 0)
    (hval : ∀ ℓ i, ∃ a, q.1.read ℓ a (Sum.inr i) ≠ 0) :
    InsideBlocksFreeAt (rescaleBothAct k) (posRescalings hid ×ˢ posRescalings hid) q := by
  sorry

/-- **Lemma A.8 for ReGLU blocks, with skips:** dimension
`d² + (L + 1) d + 2 ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_residual_gated_both [Nonempty T] [Nonempty dOut] :
    dimH (affMat (affPreservingResidual (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ (posRescalings hid ×ˢ posRescalings hid))
      = ((Fintype.card d ^ 2 + (L + 1) * Fintype.card d + 2 * ∑ ℓ, Fintype.card (hid ℓ) : ℕ)
          : ℝ≥0∞) := by
  sorry

/-- **The same without skips:** dimension `(L + 1)(d² + d) + 2 ∑_ℓ d_hidden^ℓ`. -/
theorem dimH_generated_skipless_gated_both :
    dimH (affMat (affPreservingSkipless (Arch.gated (T := T) (d := d) σ id hid) dIn dOut)
        ×ˢ (posRescalings hid ×ˢ posRescalings hid))
      = (((L + 1) * (Fintype.card d ^ 2 + Fintype.card d)
          + 2 * ∑ ℓ, Fintype.card (hid ℓ) : ℕ) : ℝ≥0∞) := by
  sorry

end Skips
