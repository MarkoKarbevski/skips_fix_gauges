#!/bin/bash
# Git pre-commit hook for this clone: block a commit that stages a paper whose main text uses a term
# or symbol before defining it. It runs only on commits made in this clone, never on Overleaf commits.
# Install with: cp "paper docs/tools/pre-commit" .git/hooks/pre-commit
root=$(git rev-parse --show-toplevel)
# Check only commits authored in this clone: never a merge, rebase or cherry-pick that brings in
# commits made elsewhere (for example from Overleaf).
gd=$(git rev-parse --git-dir)
for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  [ -e "$gd/$f" ] && exit 0
done
cd "$root/paper docs" || exit 0
fail=0
for k in A B C D; do
  case $k in
    A) f=new_paper_absorb_skip/new_paper_absorb_skip.tex ;;
    B) f=new_paper_skips_unlock_d2_params/new_paper_skips_unlock_d2_params.tex ;;
    C) f=new_paper_skips_at_least/new_paper_skips_at_least.tex ;;
    D) f=new_paper_skips_exactly/new_paper_skips_exactly.tex ;;
  esac
  if git diff --cached --name-only | grep -qF "paper docs/$f"; then
    if ! res=$(python3 tools/check_flow.py "$f" tools/glossary_$k.py tools/flow_allow_$k.txt); then
      echo "$res" | grep -v '^  unit'
      echo "Commit blocked: paper $k uses a term or symbol before defining it."
      echo "Fix the text, or accept a term well known to the readers in tools/flow_allow_$k.txt, with a reason."
      fail=1
    fi
  fi
done
exit $fail
